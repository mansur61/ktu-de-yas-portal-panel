@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inherits LayoutComponentBase

<a class="dy-skip" href="#main-content">İçeriğe geç</a>
    <div class="page dy-shell">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="dy-top-label">DE-YAS · Baraj ve sensör yönetimi</span>
            <AuthorizeView><Authorized Context="session">
                <span class="ms-3">@session.User.Identity?.Name</span>
                <form method="post" action="/session/logout" class="d-inline ms-3"><AntiforgeryToken /><button class="btn btn-sm btn-outline-secondary" type="submit">Çıkış</button></form>
            </Authorized></AuthorizeView>
        </div>

        <article class="content px-4" id="main-content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Beklenmedik bir hata oluştu.
    <a href="." class="reload">Yenile</a>
    <span class="dismiss">🗙</span>
</div>
