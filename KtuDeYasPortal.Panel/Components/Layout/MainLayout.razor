@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inherits LayoutComponentBase
@inject NavigationManager Navigation

<a class="dy-skip" href="#main-content">İçeriğe geç</a>

@if (IsOpMap)
{
    @* ── Operasyon Haritası: tam ekran, sidebar/topbar yok ── *@
    <div class="opmap-shell @(_drawerOpen ? "drawer-open" : "")">

        @* Floating menü butonu *@
        <button class="opmap-menu-btn" @onclick="ToggleDrawer" aria-label="Menü">
            <span class="bi @(_drawerOpen ? "bi-x-lg" : "bi-list")"></span>
        </button>

        @* Overlay — drawer açıkken tıklayınca kapat *@
        @if (_drawerOpen) {
            <div class="opmap-overlay" @onclick="CloseDrawer"></div>
        }

        @* Slide-in drawer menüsü *@
        <nav class="opmap-drawer" aria-label="Gezinme menüsü">
            <NavMenu />
        </nav>

        @* İçerik — harita doğrudan burada *@
        <main id="main-content" class="opmap-content">
            @Body
        </main>
    </div>
}
else
{
    @* ── Normal sayfa düzeni ── *@
    <div class="page dy-shell @(IsTwin ? "dt-shell" : "") @(_menuOpen ? "dt-menu-open" : "")">
        <div class="sidebar">
            <NavMenu />
        </div>
        <main>
            <div class="top-row px-4">
                @if (IsTwin) { <button class="dt-menu-button" @onclick="() => _menuOpen = !_menuOpen" aria-expanded="@(_menuOpen)">☰ Menü</button> }
                <span class="dy-top-label">DE-YAS · Baraj ve sensör yönetimi</span>
                <span class="ms-auto small">Yönetim Paneli</span>
            </div>
            <article class="content px-4" id="main-content">
                @Body
            </article>
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    Beklenmedik bir hata oluştu.
    <a href="." class="reload">Yenile</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _menuOpen;
    private bool _drawerOpen;

    private bool IsTwin   => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/') is "digital-twin";
    private bool IsOpMap  => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/') is "";

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void CloseDrawer()  => _drawerOpen = false;
}
