@implements IDisposable
@inject AlertState AlertState
<a class="dy-brand" href="/"><span class="dy-brand-symbol" aria-hidden="true">≋</span><span><strong>DE-YAS</strong><small>YÖNETİM PANELİ</small></span></a>
<button class="dy-mobile-toggle" @onclick="() => _expanded = !_expanded" aria-expanded="@_expanded" aria-label="Gezinme menüsünü aç veya kapat">Menü</button>
<nav class="dy-nav @(_expanded ? "" : "collapsed")" aria-label="Ana gezinme">
    <div class="dy-nav-label">BAŞLANGIÇ</div>
    <NavLink href="" Match="NavLinkMatch.All"><span class="bi bi-house" aria-hidden="true"></span>Genel bakış</NavLink>
    <div class="dy-nav-label">BARAJ VE SENSÖR YÖNETİMİ</div>
    <NavLink href="structures"><span class="bi bi-building" aria-hidden="true"></span>Barajlar ve saha kurulumu</NavLink>
    <NavLink href="sensor-assignment"><span class="bi bi-diagram-3" aria-hidden="true"></span>Sensör envanteri</NavLink>
    <NavLink href="sensor-setup"><span class="bi bi-check2-circle" aria-hidden="true"></span>Bağlantı ve kurulum kontrolü</NavLink>
    <div class="dy-nav-label">İZLEME</div>
    <NavLink href="sensor-dashboard"><span class="bi bi-activity" aria-hidden="true"></span>Ölçümler ve grafikler</NavLink>
    <NavLink href="media-dashboard"><span class="bi bi-camera-video" aria-hidden="true"></span>Kameralar ve kayıtlar</NavLink>
    <NavLink href="field-alerts"><span class="bi bi-bell" aria-hidden="true"></span>Sahadan gelen alarmlar @if (AlertState.FieldAlertCount > 0) { <span class="badge bg-warning text-dark">@AlertState.FieldAlertCount</span> }</NavLink>
    <NavLink href="stakeholder-alerts"><span class="bi bi-chat-square-text" aria-hidden="true"></span>İletilen incelemeler</NavLink>
    <div class="dy-nav-label">AYARLAR</div>
    <NavLink href="settings"><span class="bi bi-gear" aria-hidden="true"></span>Genel Ayarlar</NavLink>
</nav>
@code {
    private bool _expanded = true;
    protected override void OnInitialized() => AlertState.OnFieldAlertReceived += HandleAlert;
    private void HandleAlert(FieldAlert alert) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => AlertState.OnFieldAlertReceived -= HandleAlert;
}
