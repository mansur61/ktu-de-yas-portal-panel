@page "/digital-twin"
@page "/digital-twin/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using DeYas.Contracts.Authorization
@using System.Globalization
@using System.Text.RegularExpressions
@inject StructureUseCases StructuresUC
@inject PanelAccess Access
@inject PanelApiClients Clients
@inject SensorDataState RealtimeState
@inject IOptions<GrafanaOptions> GrafanaOpts
@inject NavigationManager Navigation
@implements IDisposable

@using KtuDeYasPortal.Panel.Components.Shared

<PageTitle>Dijital ikiz · DE-YAS</PageTitle>
<div class="twin-site-picker"><label for="twin-site">İzlenen yapı</label><select id="twin-site" value="@Id" @onchange="ChangeSite">@foreach(var site in _sites){<option value="@site.Id">@site.Name</option>}</select></div>
@if (_loading) { <p role="status">Baraj ve ölçümler yükleniyor…</p> }
else if (_structure is null) { <div class="dy-empty"><h1>Baraj açılamadı</h1><p>@_error</p><a href="structures">Tüm barajlar</a></div> }
else {
<section class="twin-page monitor-page">
    <header class="monitor-heading"><div><a href="structures">← Tüm barajlar</a><h1>@_structure.Name <span>DİJİTAL İKİZ</span></h1><p>@_structure.Province · @_structure.District</p></div><div class="monitor-health"><i class="bi bi-broadcast"></i><strong>@FreshCount / @_sensors.Count</strong><span>Son 2 dakikada veri alınan / toplam sensör</span></div></header>
    @if (_dataError is not null) { <div class="alert alert-warning" role="status">@_dataError</div> }
    <div class="monitor-workbench">
        <section class="model-section">
            <div class="model-view-switch"><button class="@(!_show3D?"selected":"")" @onclick="()=>_show3D=false">Panel yerleşimi · @_sensors.Count(HasPosition) nokta</button><button class="@(_show3D?"selected":"")" @onclick="()=>_show3D=true">3D model</button></div>
            @if(_show3D){ <DamModel3D Sensors="_sensors" SelectedId="_selected?.Id" OnSelect="SelectSensor" /> <p class="monitor-note">Kayıtlı X/Y yüzdeleri şematik modelin ön yüzeyine uygulanır.</p> }
            else {
                <div class="registered-plan"><img src="@PlanImageUrl" alt="@($"{_structure.Name} panelde kayıtlı sensör yerleşimi")" />
                @foreach(var sensor in _sensors.Where(HasPosition)){<button class="registered-pin @(sensor.Id==_selected?.Id?"selected":"") @(IsFresh(sensor)?"fresh":"")" style="@FormattableString.Invariant($"left:{sensor.ImagePositionX}%;top:{sensor.ImagePositionY}%")" title="@sensor.Name" aria-label="@($"{sensor.Name} sensörünü seç")" @onclick="()=>SelectSensor(sensor)"><i class="bi @(IsCamera(sensor)?"bi-camera-video-fill":"bi-broadcast-pin")"></i></button>}
                </div>
            }
            <div class="sensor-filters"><input aria-label="Model sensörlerinde ara" placeholder="Sensör adı veya cihaz ara…" @bind="ModelSearch" @bind:event="oninput" /><select aria-label="Model sensör türü" @bind="ModelType"><option value="">Tüm türler</option>@foreach(var type in SensorTypes){<option value="@type">@type</option>}</select></div>
            <div class="model-sensor-strip">@foreach(var s in ModelSensors.Skip(ModelPage*10).Take(10)){ <button @key="s.Id" class="@(s.Id==_selected?.Id?"selected":"")" @onclick="()=>SelectSensor(s)"><i class="bi @(IsCamera(s)?"bi-camera-video":"bi-broadcast-pin")"></i> @s.Name</button> }</div>
            <div class="sensor-pagination"><span>@ModelSensors.Count() sensör · @(ModelPage+1) / @ModelPageCount sayfa</span><button disabled="@(ModelPage==0)" @onclick="()=>_modelPage=ModelPage-1">Önceki</button><button disabled="@(ModelPage+1>=ModelPageCount)" @onclick="()=>_modelPage=ModelPage+1">Sonraki</button></div>
            @if(!ModelSensors.Any() && _sensors.Count>0){<p class="monitor-note">Filtreye uygun sensör bulunamadı.</p>}
            @if (_sensors.Count==0) { <p class="monitor-note">Bu baraja bağlı aktif sensör kaydı yok.</p> }
        </section>
        <section class="live-section"><header><div><span class="monitor-kicker">TELEMETRİ</span><h2>Canlı sensör akışı</h2></div><span class="refresh-label">10 sn güncelleme</span></header>
            @if (!CanRead) { <p>Ölçümleri görüntüleme yetkisi gerekiyor.</p> }
            else {
            <div class="sensor-filters telemetry-filters"><input aria-label="Telemetri sensörü ara" placeholder="Sensör adı veya cihaz ara…" @bind="_telemetrySearch" @bind:event="oninput" /><select aria-label="Telemetri sensör türü" @bind="_telemetryType"><option value="">Tüm türler</option>@foreach(var type in SensorTypes.Where(t=>t!="Camera")){<option value="@type">@type</option>}</select><select aria-label="Telemetri akış durumu" @bind="_telemetryStatus"><option value="">Tüm durumlar</option><option value="live">Akış alınıyor</option><option value="waiting">Veri bekleniyor</option></select></div>
            <p class="monitor-note">@TelemetrySensors.Count() / @_sensors.Count(s=>!IsCamera(s)) sensör gösteriliyor</p>
            <div class="telemetry-grid">
            @foreach(var sensor in TelemetrySensors) {
                var streams=Streams(sensor).ToList();
                var waveform=Waveform(sensor);
                <article class="telemetry-card @(sensor.Id==_selected?.Id?"selected":"")"><button class="telemetry-title" @onclick="()=>SelectSensor(sensor)"><span>@sensor.Name</span><small class="@(IsFresh(sensor)?"fresh":"waiting")">@(IsFresh(sensor)?"Akış alınıyor":"Veri bekleniyor")</small></button>
                @if(streams.Count==0){ <div class="no-reading">— <small>Henüz ölçüm alınmadı</small></div> }
                @if(waveform.Count>1){<div class="waveform-reading"><span>Canlı örnek dalgası</span><strong>@(WaveformRate(sensor)?.ToString("G4") ?? "—") <small>Hz</small></strong></div><svg class="stream-chart waveform-chart" viewBox="0 0 280 70" preserveAspectRatio="none" role="img" aria-label="@($"{sensor.Name} gerçek örnek dalga formu")"><path d="M0 20H280 M0 45H280 M0 69H280" class="chart-grid"/><polyline points="@WaveformPoints(waveform)" /></svg>}
                @foreach(var stream in streams){ var last=stream.Value.Last();
                    <div class="metric-reading"><span>@MetricLabel(stream.Key.Metric)</span><strong>@last.Value.ToString("G5") <small>@MetricUnit(stream.Key.Metric, sensor.Unit)</small></strong></div>
                    @if(stream.Value.Count>1){ <svg class="stream-chart" viewBox="0 0 280 70" preserveAspectRatio="none" role="img" aria-label="@($"{sensor.Name} {stream.Key.Metric} ölçüm geçmişi")"><path d="M0 20H280 M0 45H280 M0 69H280" class="chart-grid"/><polyline points="@Points(stream.Value)" /></svg> }
                    else { <p class="monitor-note">Grafik için yeni ölçümler bekleniyor.</p> }
                    <div class="metric-stats"><span>Min @stream.Value.Min(p=>p.Value).ToString("G4")</span><span>Ort @stream.Value.Average(p=>p.Value).ToString("G4")</span><span>Maks @stream.Value.Max(p=>p.Value).ToString("G4")</span></div>
                    <time class="reading-timestamp">@last.Time.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</time>
                }</article>
            }
            </div>
            @if(!TelemetrySensors.Any()) { <p class="monitor-note">Filtreye uygun ölçüm sensörü bulunmuyor.</p> }
            }
        </section>
    </div>
    <section class="monitor-summary"><article><span>Bağlı sensör</span><strong>@_sensors.Count</strong><small>@_sensors.Count(IsCamera) kamera</small></article><article><span>Güncel ölçüm</span><strong>@FreshCount</strong><small>Son 2 dakika</small></article><article><span>Veri bekleyen ölçüm sensörü</span><strong>@_sensors.Count(s=>!IsCamera(s) && !IsFresh(s))</strong><small>Veri yok veya son ölçüm eski</small></article><article><span>İncelenen sensör</span><strong class="selected-name">@(_selected?.Name??"—")</strong><small>@(_selected is null?"":$"Kayıt: {_selected.CreatedAt.ToLocalTime():dd.MM.yyyy}")</small></article></section>
    @if(CanRead && _sensors.Any(s=>!IsCamera(s))){
    <section class="monitor-grafana">
        <article><header><span class="monitor-kicker">BARAJ GENELİ</span><h2>Tüm sensörlerin akışı</h2><div class="grafana-filters"><select aria-label="Tüm sensörler grafik metriği" @bind="AllActiveMetric">@foreach(var metric in AllMetrics){<option value="@metric">@metric</option>}</select><select aria-label="Tüm sensörler zaman aralığı" @bind="_allRange"><option value="15m">Son 15 dakika</option><option value="1h">Son 1 saat</option><option value="6h">Son 6 saat</option><option value="24h">Son 24 saat</option></select></div><small>Tüm cihazlar · cihaz başına ayrı renkli seri</small></header>@if(AllMetrics.Any()){<iframe title="Baraj sensörleri ölçüm grafiği" src="@AllGrafanaUrl" loading="lazy"></iframe>}else{<p class="monitor-note">Metrik tanımı veya ölçüm bekleniyor.</p>}</article>
        <article><header><span class="monitor-kicker">SENSÖR AYRINTISI</span><h2>@(_selected?.Name??"Sensör seçin")</h2><div class="grafana-filters"><select aria-label="Seçili sensör grafik metriği" @bind="ActiveMetric">@foreach(var metric in SelectedMetrics){<option value="@metric">@metric</option>}</select><select aria-label="Seçili sensör zaman aralığı" @bind="_selectedRange"><option value="15m">Son 15 dakika</option><option value="1h">Son 1 saat</option><option value="6h">Son 6 saat</option><option value="24h">Son 24 saat</option></select></div><small>Yalnızca seçili cihaz</small></header>@if(_selected is not null && !IsCamera(_selected)&&SelectedMetrics.Any()){<iframe title="Seçili sensör ölçüm grafiği" src="@SelectedGrafanaUrl" loading="lazy"></iframe>}</article>
    </section> }
</section>
}

@code {
    [Parameter] public Guid Id {get;set;}
    private Structure? _structure;
    private List<Sensor> _sensors=[];
    private Sensor? _selected;
    private bool _loading=true;
    private bool _show3D;
    private string PlanImageUrl => !string.IsNullOrWhiteSpace(_structure?.ImageUrl) ? _structure.ImageUrl : "/images/structures/" + (_structure?.StructureType.ToString().ToLowerInvariant() switch { "dam"=>"dam.svg", "bridge"=>"bridge.jpg", "tunnel"=>"tunnel.svg", "building"=>"building.svg", _=>"other.svg" });
    private string? _error, _dataError;
    private string _metric="";
    private string _allMetric="", _allRange="15m", _selectedRange="15m";
    private string _modelSearch="", _modelType="", _telemetrySearch="", _telemetryType="", _telemetryStatus="";
    private int _modelPage;
    private string ModelSearch {get=>_modelSearch;set{_modelSearch=value;_modelPage=0;}}
    private string ModelType {get=>_modelType;set{_modelType=value;_modelPage=0;}}
    private IEnumerable<string> SensorTypes=>_sensors.Select(s=>s.SensorType.ToString()).Distinct().Order();
    private static bool Matches(Sensor sensor,string search,string type)=>(string.IsNullOrWhiteSpace(search)||(sensor.Name+" "+sensor.DeviceId).Contains(search.Trim(),StringComparison.CurrentCultureIgnoreCase))&&(type.Length==0||sensor.SensorType.ToString()==type);
    private IEnumerable<Sensor> ModelSensors=>_sensors.Where(s=>Matches(s,_modelSearch,_modelType)).OrderBy(s=>s.Name).ThenBy(s=>s.Id);
    private int ModelPageCount=>Math.Max(1,(ModelSensors.Count()+9)/10);
    private int ModelPage=>Math.Clamp(_modelPage,0,ModelPageCount-1);
    private IEnumerable<Sensor> TelemetrySensors=>_sensors.Where(s=>!IsCamera(s)&&Matches(s,_telemetrySearch,_telemetryType)&&(_telemetryStatus==""||(_telemetryStatus=="live"?IsFresh(s):!IsFresh(s)))).OrderBy(s=>s.Name).ThenBy(s=>s.Id);
    private CancellationTokenSource? _loadCts;
    private readonly Dictionary<(Guid SensorId,string Metric),List<Reading>> _series=[];
    private readonly Dictionary<Guid,(List<double> Values,double? SamplingRate)> _waveforms=[];
    private record Reading(DateTime Time,double Value);
    private bool CanRead=>_canRead;
    private bool _canRead, _canMedia;
    private List<Structure> _sites=[];
    private void ChangeSite(ChangeEventArgs e){if(Guid.TryParse(e.Value?.ToString(),out var id))Navigation.NavigateTo($"/digital-twin/{id}");}
    private int FreshCount=>_sensors.Count(s=>!IsCamera(s)&&IsFresh(s));
    private static bool IsCamera(Sensor s)=>s.SensorType.ToString()=="Camera";
    private static bool HasPosition(Sensor s)=>s.ImagePositionX is >=0 and <=100 && s.ImagePositionY is >=0 and <=100;
    private void ApplyInventory(Structure structure,IReadOnlyList<Sensor> sensors){
        _structure=structure;
        _sensors=sensors.Where(s=>structure.Sensors.Any(p=>p.SensorId==s.Id)).ToList();
        foreach(var sensor in _sensors){var placement=structure.Sensors.FirstOrDefault(p=>p.SensorId==sensor.Id);if(placement is not null){sensor.ImagePositionX=placement.ImagePositionX;sensor.ImagePositionY=placement.ImagePositionY;}}
        _selected=_sensors.FirstOrDefault(s=>s.Id==_selected?.Id)??_sensors.FirstOrDefault(s=>!IsCamera(s));
    }
    private IEnumerable<KeyValuePair<(Guid SensorId,string Metric),List<Reading>>> Streams(Sensor s)=>_series.Where(x=>x.Key.SensorId==s.Id&&x.Value.Count>0);
    private IReadOnlyList<double> Waveform(Sensor sensor)=>_waveforms.TryGetValue(sensor.Id,out var waveform)?waveform.Values:[];
    private double? WaveformRate(Sensor sensor)=>_waveforms.TryGetValue(sensor.Id,out var waveform)?waveform.SamplingRate:null;
    private bool IsFresh(Sensor s)=>Streams(s).Any(x=>x.Value.Last().Time.ToUniversalTime()>=DateTime.UtcNow.AddMinutes(-2));
    private static string CanonicalMetric(string metric)=>metric switch { "samplingRate"=>"sampling_rate", "sampleCount"=>"sample_count", _=>metric };
    private IEnumerable<string> MetricsFor(Sensor sensor)=>Streams(sensor).Select(x=>CanonicalMetric(x.Key.Metric)).Concat(sensor.Metrics.Split(',',StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries).Select(CanonicalMetric)).Append(IsWaveformSensor(sensor)?"samples":string.Empty).Where(x=>x.Length>0).Distinct().Order();
    private static bool IsWaveformSensor(Sensor sensor)=>sensor.SensorType.ToString() is "Accelerometer" or "Vibration";
    private static string MetricLabel(string metric)=>metric switch { "ric_ok"=>"Okuma durumu", "sampling_rate"=>"Örnekleme hızı", "sample_count"=>"Paket örnek sayısı", _=>metric };
    private static string MetricUnit(string metric,string fallback)=>metric=="sampling_rate"?"Hz":metric=="sample_count"?"örnek":metric=="ric_ok"?"1=başarılı":fallback;
    private IEnumerable<string> SelectedMetrics=>_selected is null?[]:MetricsFor(_selected);
    private IEnumerable<string> AllMetrics=>_sensors.Where(s=>!IsCamera(s)).SelectMany(MetricsFor).Distinct().Order();
    private string ActiveMetric {get=>SelectedMetrics.Contains(_metric)?_metric:SelectedMetrics.FirstOrDefault()??"";set=>_metric=value;}
    private string AllActiveMetric {get=>AllMetrics.Contains(_allMetric)?_allMetric:AllMetrics.FirstOrDefault()??"";set=>_allMetric=value;}
    private static string DeviceFilter(IEnumerable<Sensor> sensors)=>"^("+string.Join("|",sensors.Select(s=>Regex.Escape(s.DeviceId)))+")$";
    private string AllGrafanaUrl=>GrafanaOpts.Value.BuildPanelUrl(AllActiveMetric=="samples"?84:10,AllActiveMetric,DeviceFilter(_sensors.Where(s=>!IsCamera(s))),Id.ToString(),_allRange);
    private string SelectedGrafanaUrl=>GrafanaOpts.Value.BuildPanelUrl(ActiveMetric=="samples"?84:10,ActiveMetric,_selected is null?null:DeviceFilter([_selected]),Id.ToString(),_selectedRange);

    protected override void OnInitialized(){RealtimeState.OnSensorDataReceived+=OnSensor;}
    protected override async Task OnParametersSetAsync()=>await LoadAsync();
    private async Task LoadAsync(){
        _loadCts?.Cancel();_loadCts?.Dispose();_loadCts=new();var ct=_loadCts.Token;
        _loading=true;_error=null;_dataError=null;_structure=null;_selected=null;_sensors=[];_series.Clear();_waveforms.Clear();
        try {
            var scope=await Access.GetAsync(BarajPermissions.Dashboard,PortalMenuPermissions.DigitalTwin,ct);
            _sites=(await StructuresUC.GetAllAsync(ct)).Where(s=>scope.IsAdmin||scope.StructureIds.Contains(s.Id)).ToList();
            if(Id==Guid.Empty)Id=_sites.FirstOrDefault()?.Id??Guid.Empty;
            if(!_sites.Any(s=>s.Id==Id)){_error="Bu yapıya erişim yetkisi yok veya yapı bulunamadı.";return;}
            _canRead=true;
            var media=await Access.GetAsync(BarajPermissions.Media,PortalMenuPermissions.Media,ct);
            _canMedia=media.IsAdmin||media.StructureIds.Contains(Id);
            var structure=await StructuresUC.GetByIdAsync(Id);ct.ThrowIfCancellationRequested();
            if(structure is null){_error="Baraj bulunamadı.";return;}
            var sensors=await StructuresUC.GetAllSensorsAsync(ct);ct.ThrowIfCancellationRequested();
            ApplyInventory(structure,sensors);
            _selected=_sensors.FirstOrDefault(s=>!IsCamera(s));_metric="";_allMetric="";_modelPage=0;
            _loading=false;await InvokeAsync(StateHasChanged);
            if(CanRead){await RefreshAsync(true,ct);if(!ct.IsCancellationRequested)_=PollAsync(ct);}
        }catch(OperationCanceledException){}catch{_error="Baraj verileri alınamadı.";}finally{if(!ct.IsCancellationRequested)_loading=false;}
    }
    private async Task RefreshAsync(bool history,CancellationToken ct){
        var sensors=_sensors.Where(s=>!IsCamera(s)).ToArray();var failed=0;
        await Parallel.ForEachAsync(sensors,new ParallelOptions{MaxDegreeOfParallelism=4,CancellationToken=ct},async(sensor,token)=>{
            try {
                var rows=history?await ReadHistory(sensor,token):[];
                var latest=await ReadLatest(sensor,token);token.ThrowIfCancellationRequested();
                await InvokeAsync(()=>{if(token.IsCancellationRequested)return;foreach(var row in rows)Add(sensor,row.Timestamp,row.Metrics,row.Samples,row.SamplingRate);if(latest is not null)Add(sensor,latest.Timestamp,latest.Metrics,latest.Samples,latest.SamplingRate);});
            }catch(OperationCanceledException){throw;}catch{Interlocked.Increment(ref failed);}
        });
        if(!ct.IsCancellationRequested)await InvokeAsync(()=>{_dataError=failed>0?$"{failed} sensörün ölçüm geçmişi alınamadı. Bağlantı yeniden deneniyor.":null;StateHasChanged();});
    }
    private async Task PollAsync(CancellationToken ct){
        try{var tick=0;using var timer=new PeriodicTimer(TimeSpan.FromSeconds(10));while(await timer.WaitForNextTickAsync(ct)){
            if(++tick%3==0){
                try{var scope=await Access.GetAsync(BarajPermissions.Dashboard,PortalMenuPermissions.DigitalTwin,ct);
                if(!scope.IsAdmin&&!scope.StructureIds.Contains(Id)){await InvokeAsync(()=>{_canRead=false;_structure=null;_sensors=[];_series.Clear();_waveforms.Clear();_error="Yapıya erişim yetkiniz değişti.";StateHasChanged();});return;}
                var structure=await StructuresUC.GetByIdAsync(Id,ct);var sensors=await StructuresUC.GetAllSensorsAsync(ct);ct.ThrowIfCancellationRequested();await InvokeAsync(()=>{if(ct.IsCancellationRequested)return;if(structure is null){_structure=null;_sensors=[];_selected=null;_series.Clear();_error="Baraj kaydı veya erişim yetkisi değişti.";}else ApplyInventory(structure,sensors);});}
                catch(OperationCanceledException){throw;}catch{await InvokeAsync(()=>_dataError="Sensör yerleşimi yenilenemedi; son alınan yerleşim gösteriliyor.");}
            }
            await RefreshAsync(false,ct);
        }}catch(OperationCanceledException){}
    }
    private void Add(Sensor sensor,DateTime timestamp,IReadOnlyDictionary<string,double> metrics,IReadOnlyList<double>? samples=null,double? samplingRate=null){
        foreach(var metric in metrics.Where(m=>double.IsFinite(m.Value))){var key=(sensor.Id,metric.Key);if(!_series.TryGetValue(key,out var points))_series[key]=points=[];var index=points.FindIndex(p=>p.Time==timestamp);if(index>=0)points[index]=new(timestamp,metric.Value);else points.Add(new(timestamp,metric.Value));points.Sort((a,b)=>a.Time.CompareTo(b.Time));if(points.Count>120)points.RemoveRange(0,points.Count-120);}
        if(samples is { Count: > 1 })_waveforms[sensor.Id]=(samples.TakeLast(280).ToList(),samplingRate);
    }
    private static string Points(List<Reading> readings){var min=readings.Min(p=>p.Value);var span=readings.Max(p=>p.Value)-min;var start=readings[0].Time;var duration=Math.Max(1,(readings[^1].Time-start).TotalSeconds);return string.Join(" ",readings.Select(p=>FormattableString.Invariant($"{(p.Time-start).TotalSeconds/duration*280:0.##},{(span==0?35:65-(p.Value-min)/span*60):0.##}")));}
    private static string WaveformPoints(IReadOnlyList<double> samples){var min=samples.Min();var span=samples.Max()-min;return string.Join(" ",samples.Select((sample,index)=>FormattableString.Invariant($"{(double)index/Math.Max(1,samples.Count-1)*280:0.##},{(span==0?35:65-(sample-min)/span*60):0.##}")));}
    private void SelectSensor(Sensor sensor){_selected=sensor;_metric="";if(IsCamera(sensor)&&_canMedia)Navigation.NavigateTo($"/media-dashboard?structureId={Id}&deviceId={Uri.EscapeDataString(sensor.DeviceId)}");}
    private void OnSensor(SensorUpdatedEvent value)=>_=InvokeAsync(()=>{if(!CanRead||_loadCts?.IsCancellationRequested!=false||value.StructureId.HasValue&&value.StructureId!=Id)return;var sensor=_sensors.FirstOrDefault(s=>s.DeviceId==value.DeviceId);if(sensor is null)return;Add(sensor,value.Timestamp,value.AllMetrics.Count>0?value.AllMetrics:new Dictionary<string,double>{{value.MetricKey,value.CurrentValue}});StateHasChanged();});
    private sealed record MonitorRow(DateTime Timestamp, Dictionary<string,double> Metrics, List<double>? Samples, double? SamplingRate);
    private async Task<List<MonitorRow>> ReadHistory(Sensor sensor,CancellationToken ct){
        using var http=Clients.CreateClient("timeseries-api");
        var from=Uri.EscapeDataString(DateTime.UtcNow.AddMinutes(-15).ToString("O"));
        var to=Uri.EscapeDataString(DateTime.UtcNow.ToString("O"));
        return await http.GetFromJsonAsync<List<MonitorRow>>($"api/sensor-data?deviceId={Uri.EscapeDataString(sensor.DeviceId)}&structureId={Id}&from={from}&to={to}&limit=120",ct)??[];
    }
    private async Task<MonitorRow?> ReadLatest(Sensor sensor,CancellationToken ct){
        using var http=Clients.CreateClient("timeseries-api");
        using var response=await http.GetAsync($"api/sensor-data/latest/{Uri.EscapeDataString(sensor.DeviceId)}?structureId={Id}",ct);
        if(response.StatusCode==System.Net.HttpStatusCode.NotFound)return null;
        response.EnsureSuccessStatusCode();return await response.Content.ReadFromJsonAsync<MonitorRow>(ct);
    }
    public void Dispose(){_loadCts?.Cancel();_loadCts?.Dispose();RealtimeState.OnSensorDataReceived-=OnSensor;}
}
