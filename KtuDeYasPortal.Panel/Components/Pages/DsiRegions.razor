@page "/dsi-regions"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "platform.admin")]
@using DeYas.Contracts
@inject PanelApiClients Clients
<PageTitle>DSİ Bölge Kataloğu</PageTitle>
<KtuDeYasPortal.Panel.Components.Shared.SettingsNavigation />
<h1>DSİ bölge müdürlükleri</h1>
<p>Bölge bilgileri veritabanındaki katalogdan gösterilir. Kullanıcıların bölge ve il erişimleri Yetkilendirme ekranından atanır.</p>
@if(_message is not null){<div class="alert alert-info" role="status">@_message</div>}
@if(_regions.Count>0){
<label class="form-label" for="dsi-region">Bölge müdürlüğü</label><select id="dsi-region" class="form-select mb-4" @bind="_number">@foreach(var r in _regions){<option value="@r.Number">@r.Name</option>}</select>
@if(Selected is {} region){
<div class="row g-4"><div class="col-lg-7"><article class="card p-4"><h2 class="h4">@region.Name</h2><dl><dt>Merkez il</dt><dd>@region.Center</dd><dt>Bağlı iller</dt><dd>@string.Join(", ",region.Provinces)</dd>@if(!string.IsNullOrWhiteSpace(region.Notes)){<dt>Görev alanı açıklaması</dt><dd>@region.Notes</dd>}<dt>Doğrulama tarihi</dt><dd>@region.VerifiedOn</dd></dl><a href="@region.SourceUrl" target="_blank" rel="noopener noreferrer">Resmî DSİ bilgileri ↗</a></article></div>
<div class="col-lg-5"><article class="card p-4"><h2 class="h5">Bölge haritası</h2>@if(!string.IsNullOrWhiteSpace(region.MapImageUrl)){<img src="@region.MapImageUrl" alt="@region.Name bölge haritası" style="width:100%;max-height:450px;object-fit:contain" />}else{<p>Resmî harita görseli tanımlı değil.</p>}</article></div></div>
}}
@code{
 private List<DsiRegionInfo> _regions=[];private int _number;private string? _message;
 private DsiRegionInfo? Selected=>_regions.FirstOrDefault(r=>r.Number==_number);
 protected override async Task OnInitializedAsync(){try{_regions=await Clients.CreateClient("timeseries-api").GetFromJsonAsync<List<DsiRegionInfo>>("api/dsi-regions")??[];_number=_regions.FirstOrDefault()?.Number??0;if(_regions.Count==0)_message="Bölge kataloğunda kayıt bulunamadı.";}catch{_message="Bölge kataloğu yüklenemedi. Sunucu bağlantısını kontrol edin.";}}
}
