@page "/"
@layout KtuDeYasPortal.Panel.Components.Layout.MapLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject StructureUseCases StructureUC
@inject IJSRuntime JS
@inject ILogger<Home> Logger
@implements IAsyncDisposable

<PageTitle>DE-YAS · Operasyon Haritası</PageTitle>

<style>
    .op-map-shell {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        height: 100dvh;
        width: 100%;
        position: relative;
    }
    .op-map-toolbar {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .5rem 1rem;
        background: rgba(255,255,255,.92);
        border-bottom: 1px solid rgba(0,0,0,.08);
        flex-shrink: 0;
        z-index: 10;
        backdrop-filter: blur(6px);
        box-shadow: 0 1px 8px rgba(0,0,0,.08);
    }
    .op-map-toolbar h1 {
        font-size: 1rem;
        font-weight: 600;
        margin: 0;
        color: #1a1a2e;
    }
    .op-map-hint {
        font-size: .78rem;
        color: #6c757d;
        margin-left: auto;
        margin-right: 1rem;
    }
    .op-map-error {
        color: #a4262c;
        font-size: .78rem;
    }
    #op-turkey-map {
        flex: 1;
        min-height: 0;
        z-index: 1;
        background: #eaf1f3;
    }
    .op-province-label {
        background: rgba(255,255,255,.62);
        border: 0;
        border-radius: 3px;
        box-shadow: none;
        color: #35566a;
        font-size: 10px;
        font-weight: 600;
        padding: 0 2px;
        text-shadow: 0 1px 2px #fff;
        white-space: nowrap;
    }
    .op-province-label::before { display: none; }
    #op-turkey-map .leaflet-control-attribution {
        padding: 1px 4px;
        background: rgba(255,255,255,.58);
        font-size: 8px;
        line-height: 1.2;
        opacity: .7;
    }
    /* Yapı popup kartı */
    .op-structure-card {
        position: fixed;
        z-index: 1100;
        top: 4.5rem;
        right: 1rem;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 8px 32px rgba(0,0,0,.18);
        width: min(340px, calc(100vw - 2rem));
        max-height: calc(100dvh - 5.5rem);
        overflow-y: auto;
        font-size: .85rem;
    }
    .op-structure-card-header {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .65rem 1rem;
        background: #fff;
        color: #28574f;
        position: sticky;
        top: 0;
        z-index: 1;
    }
    .op-structure-card-header strong { flex: 1; font-size: .9rem; }
    .op-structure-card-header button {
        background: none; border: none; color: inherit;
        font-size: 1.2rem; cursor: pointer; line-height: 1;
    }
    .op-structure-card-body { padding: .75rem 1rem; }
    .op-structure-card-row {
        display: flex; justify-content: space-between;
        padding: .2rem 0; border-bottom: 1px solid #f0f0f0;
    }
    .op-structure-card-row:last-child { border-bottom: none; }
    .op-structure-card-row .label { color: #6c757d; }
    .op-structure-card-body img {
        display: block;
        width: 100%;
        height: clamp(100px, 22dvh, 180px);
        object-fit: contain;
        background: #eef5f6;
        border-radius: 8px;
        margin-bottom: 1rem;
    }
</style>

<div class="op-map-shell">
    <div class="op-map-toolbar">
        <span class="bi bi-map-fill text-success"></span>
        <h1>Operasyon Haritası</h1>
        @if (_structures.Count > 0) {
            <span class="badge bg-success">@_structures.Count yapı</span>
        }
        <span class="op-map-hint">Marker'a tıklayın → sağda yapı detayı</span>
        @if (_mapError is not null)
        {
            <span class="op-map-error" role="alert">@_mapError</span>
        }
        <button class="btn btn-sm btn-outline-secondary" aria-label="Haritayı yenile" title="Haritayı yenile" @onclick="LoadAndRefreshAsync">
            <span class="bi bi-arrow-clockwise"></span>
        </button>
    </div>

    <div id="op-turkey-map"></div>
</div>

@* Yapı bilgi kartı *@
@if (_selectedStructure is not null)
{
    <aside class="op-structure-card" role="dialog" aria-label="Seçili yapı detayı">
        <div class="op-structure-card-header">
            <strong>Seçili yapı</strong>
            <button aria-label="Detayı kapat" @onclick="CloseCard">&times;</button>
        </div>
        <div class="op-structure-card-body">
            <img src="@StructureImage(_selectedStructure)" alt="@_selectedStructure.Name" />
            <h2 class="h5">@_selectedStructure.Name</h2>
            <div class="op-structure-card-row">
                <span class="label">Konum</span>
                <span>@_selectedStructure.Province@(string.IsNullOrEmpty(_selectedStructure.District) ? "" : " / " + _selectedStructure.District)</span>
            </div>
            <div class="op-structure-card-row">
                <span class="label">Sensör</span>
                <span><strong>@_selectedStructure.SensorCount</strong> kayıtlı</span>
            </div>
            <div class="op-structure-card-row">
                <span class="label">Durum</span>
                <span class="badge @(_selectedStructure.IsActive ? "bg-success" : "bg-secondary")">
                    @(_selectedStructure.IsActive ? "Aktif" : "Pasif")
                </span>
            </div>
            @if (_selectedStructure.Latitude.HasValue && _selectedStructure.Longitude.HasValue) {
                <div class="op-structure-card-row">
                    <span class="label">Koordinat</span>
                    <span style="font-size:.75rem">
                        @_selectedStructure.Latitude.Value.ToString("F4"),
                        @_selectedStructure.Longitude.Value.ToString("F4")
                    </span>
                </div>
            }
        </div>
    </aside>
}

@code {
    private List<Structure> _structures = [];
    private Structure? _selectedStructure;
    private bool _mapInitialized;
    private string? _mapError;
    private DotNetObjectReference<Home>? _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAndRefreshAsync();
        StateHasChanged();
    }

    private async Task InitializeMapAsync()
    {
        _mapError = null;
        _objRef ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("initOperationMap", "op-turkey-map", CreateMapMarkers(), _objRef);
            _mapInitialized = true;
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            _mapInitialized = false;
            Logger.LogError(ex, "Operasyon haritası yüklenemedi.");
            _mapError = "Harita yüklenemedi. Tekrar denemek için Yenile düğmesini kullanın.";
        }
    }

    private async Task LoadAndRefreshAsync()
    {
        try
        {
            _structures = await StructureUC.GetAllAsync();
            _mapError = null;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Harita için yapılar alınamadı.");
            _mapError = "Yapılar alınamadı. Lütfen haritayı yenileyin.";
            return;
        }
        if (!_mapInitialized)
        {
            await InitializeMapAsync();
            return;
        }
        await JS.InvokeVoidAsync("refreshOperationMapMarkers", CreateMapMarkers());
        StateHasChanged();
    }

    private List<OperationMapMarker> CreateMapMarkers() => _structures
        .Select(s => new OperationMapMarker(
            s.Id.ToString(), s.Name, s.Latitude, s.Longitude,
            s.StructureType.ToString(), s.SensorCount, s.IsActive, s.Province, s.District ?? ""))
        .ToList();

    [JSInvokable]
    public void OnStructureMarkerClick(string structureId)
    {
        _selectedStructure = _structures.FirstOrDefault(s => s.Id.ToString() == structureId);
        StateHasChanged();
    }

    private async Task CloseCard()
    {
        _selectedStructure = null;
        await JS.InvokeVoidAsync("clearOperationMapSelection");
    }

    private static string StructureImage(Structure structure) =>
        !string.IsNullOrWhiteSpace(structure.ImageUrl) ? structure.ImageUrl : structure.StructureType switch
        {
            StructureType.Dam => "images/structures/dam.svg",
            StructureType.Bridge => "images/structures/bridge.jpg",
            StructureType.Building => "images/structures/building.svg",
            StructureType.Tunnel => "images/structures/tunnel.svg",
            _ => "images/structures/other.svg"
        };

    private sealed record OperationMapMarker(
        string Id, string Name, double? Latitude, double? Longitude, string Type,
        int SensorCount, bool IsActive, string Province, string District);

    public async ValueTask DisposeAsync()
    {
        _objRef?.Dispose();
        try { await JS.InvokeVoidAsync("destroyOperationMap"); } catch { }
    }
}
