@page "/image-settings"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using KtuDeYasPortal.Panel.Domain.Entities
@inject KtuDeYasPortal.Panel.Infrastructure.Persistence.PanelApiClients Clients
@inject KtuDeYasPortal.Panel.Domain.Interfaces.ISensorRepository Sensors
@inject IJSRuntime JS

<PageTitle>Görsel Ayarları · DE-YAS</PageTitle>
<KtuDeYasPortal.Panel.Components.Shared.SettingsNavigation />
<div class="settings-page-content">
<div class="dy-heading">
    <div>
        <h1>Görsel ayarları</h1>
        <p>Fotoğraf ve 3D model dosyalarını buradan yükleyin. Fotoğraflar en fazla 5 MB, 3D modeller en fazla 50 MB olabilir.</p>
    </div>
</div>

@if (_error is not null)   { <div class="alert alert-danger mb-3"   role="alert">@_error</div> }
@if (_success is not null) { <div class="alert alert-success mb-3"  role="status">@_success</div> }

<div class="row g-3">

    @* ── Varsayılan baraj görseli ── *@
    <div class="col-lg-4 col-md-6">
        <section class="card p-3 h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="bi bi-image text-success fs-5"></span>
                <h2 class="h5 mb-0">Varsayılan baraj görseli</h2>
            </div>
            <p class="text-muted small mb-3">Yeni oluşturulan barajlarda kullanılır. Mevcut yapıların görselleri değişmez.</p>
            <img src="@(_defaultUrl ?? "/images/structures/dam.svg")"
                 alt="Varsayılan baraj görseli" class="asset-preview mb-3" />
            <label class="form-label small">PNG veya JPEG yükle</label>
            <InputFile OnChange="UploadDefault" accept="image/png,image/jpeg" disabled="@_busy" class="form-control form-control-sm" />
        </section>
    </div>

    @* ── Varsayılan 3D model (GLB / OBJ / FBX) ── *@
    <div class="col-lg-4 col-md-6">
        <section class="card p-3 h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="bi bi-box text-success fs-5"></span>
                <h2 class="h5 mb-0">Varsayılan 3D model</h2>
                <span class="badge bg-light text-dark border ms-auto" style="font-size:10px">GLB · GLTF · OBJ · FBX</span>
            </div>
            <p class="text-muted small mb-3">Dijital ikiz görünümünde kullanılacak varsayılan yapı geometrisi. En fazla 50 MB.</p>

            @if (!string.IsNullOrWhiteSpace(_modelUrl))
            {
                <div class="asset-preview-3d mb-3 d-flex flex-column align-items-center justify-content-center gap-2">
                    <span class="bi bi-box-seam" style="font-size:48px;color:#9cba9d"></span>
                    <div class="text-center">
                        <div class="fw-semibold small text-success">3D Model Yüklü</div>
                        <div class="text-muted" style="font-size:11px;word-break:break-all">@Path.GetFileName(new Uri(_modelUrl).LocalPath)</div>
                    </div>
                    <a href="@_modelUrl" target="_blank" class="btn btn-sm btn-outline-secondary">
                        <span class="bi bi-download me-1"></span>İndir
                    </a>
                </div>
            }
            else
            {
                <div class="asset-preview-3d mb-3 d-flex flex-column align-items-center justify-content-center gap-2 text-muted">
                    <span class="bi bi-box" style="font-size:48px;opacity:.3"></span>
                    <span class="small">Henüz 3D model yüklenmedi</span>
                </div>
            }

            <label class="form-label small">GLB, GLTF, OBJ veya FBX yükle</label>
            <InputFile OnChange="UploadModel" accept=".glb,.gltf,.obj,.fbx" disabled="@_busy" class="form-control form-control-sm" />

            <div class="mt-2 p-2 rounded" style="background:#f4f6f0;font-size:11px;color:#586d65">
                <span class="bi bi-info-circle me-1"></span>
                GLB veya GLTF formatı önerilir — Three.js/Babylon.js ile doğrudan kullanılabilir. OBJ ve FBX dönüştürme gerektirebilir.
            </div>
        </section>
    </div>

    @* ── Kurumsal arka plan ── *@
    <div class="col-lg-4 col-md-6">
        <section class="card p-3 h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="bi bi-panorama text-success fs-5"></span>
                <h2 class="h5 mb-0">Kurumsal arka plan</h2>
            </div>
            <p class="text-muted small mb-3">Portal ve yönetim panelinin arka planında kullanılır. Değişiklik diğer açık oturumlarda sayfa yenilendiğinde görünür.</p>
            <img src="@($"/institutional-background?v={_backgroundVersion}")"
                 alt="Güncel kurumsal arka plan" class="asset-preview mb-3" />
            <label class="form-label small">PNG veya JPEG yükle</label>
            <InputFile OnChange="UploadBackground" accept="image/png,image/jpeg" disabled="@_busy" class="form-control form-control-sm" />
        </section>
    </div>

    @* ── Sensör fotoğrafı ── *@
    <div class="col-lg-4 col-md-6">
        <section class="card p-3 h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="bi bi-cpu text-success fs-5"></span>
                <h2 class="h5 mb-0">Sensör fotoğrafı</h2>
            </div>
            <p class="text-muted small mb-2">Yalnızca seçtiğiniz sensörün fotoğrafı değişir.</p>
            <label for="image-sensor" class="form-label small">Sensör</label>
            <select id="image-sensor" class="form-select form-select-sm mb-3" @bind="_sensorId" disabled="@_busy">
                <option value="">Sensör seçin</option>
                @foreach (var sensor in _sensors)
                {
                    <option value="@sensor.Id">@sensor.EffectiveDisplayName · @sensor.DeviceId</option>
                }
            </select>
            @if (Selected?.ImageUrl is { Length: > 0 } url)
            {
                <img src="@url" alt="Seçili sensörün fotoğrafı" class="asset-preview mb-3" />
            }
            else
            {
                <div class="asset-preview mb-3 d-flex align-items-center justify-content-center text-muted small">
                    Henüz fotoğraf eklenmedi
                </div>
            }
            <label class="form-label small">PNG veya JPEG yükle</label>
            <InputFile OnChange="UploadSensor" accept="image/png,image/jpeg" disabled="@(_busy || Selected is null)" class="form-control form-control-sm" />
        </section>
    </div>

</div>

@if (_busy) { <p class="mt-3 text-muted small" role="status"><span class="spinner-border spinner-border-sm me-1"></span>Dosya kaydediliyor…</p> }

<style>
    .asset-preview {
        width: 100%;
        height: 160px;
        object-fit: contain;
        border-radius: 10px;
        background: #f1f5f7;
    }
    .asset-preview-3d {
        width: 100%;
        height: 160px;
        border-radius: 10px;
        background: #f1f5f7;
        border: 1px dashed #c8d5c9;
    }
</style>

@code {
    private List<Sensor> _sensors        = [];
    private string       _sensorId       = "";
    private string?      _defaultUrl, _modelUrl, _error, _success;
    private bool         _busy;
    private long         _backgroundVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

    private Sensor? Selected => _sensors.FirstOrDefault(s => s.Id.ToString() == _sensorId);

    private sealed record ImageResult(string? ImageUrl);
    private sealed record ModelResult(string? ModelUrl);
    private sealed record ErrorResult(string? Error);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _sensors    = await Sensors.GetAllAsync();
            var api     = Clients.CreateClient("timeseries-api");
            _defaultUrl = (await api.GetFromJsonAsync<ImageResult>("api/image-assets/default"))?.ImageUrl;
            _modelUrl   = (await api.GetFromJsonAsync<ModelResult>("api/image-assets/default-model"))?.ModelUrl;
        }
        catch { _error = "Görsel ayarları yüklenemedi. Bağlantıyı kontrol edip sayfayı yenileyin."; }
    }

    private Task UploadDefault(InputFileChangeEventArgs e)    => Upload(e, "default");
    private Task UploadBackground(InputFileChangeEventArgs e) => Upload(e, "background");
    private Task UploadSensor(InputFileChangeEventArgs e)     => Upload(e, "sensor");

    private async Task Upload(InputFileChangeEventArgs e, string target)
    {
        if (_busy) return;
        var selected = Selected;
        if (target == "sensor" && selected is null) return;
        _busy = true; _error = null; _success = null;
        try
        {
            var file = e.File;
            if (file.Size > 5 * 1024 * 1024) { _error = "Fotoğraf en fazla 5 MB olabilir."; return; }
            using var form   = new MultipartFormDataContent();
            using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var content = new StreamContent(stream);
            form.Add(content, "file", file.Name);
            var endpoint = target == "sensor"
                ? $"api/image-assets/sensor?sensorId={selected!.Id}"
                : $"api/image-assets/{target}";
            using var response = await Clients.CreateClient("timeseries-api").PostAsync(endpoint, form);
            if (!response.IsSuccessStatusCode)
            {
                _error = (await response.Content.ReadFromJsonAsync<ErrorResult>())?.Error ?? "Fotoğraf kaydedilemedi.";
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<ImageResult>();
            if (target == "sensor")     selected!.ImageUrl = result!.ImageUrl;
            else if (target == "default") _defaultUrl      = result!.ImageUrl;
            else
            {
                _backgroundVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                await JS.InvokeVoidAsync("deyasInstitutionalBackground.refresh", _backgroundVersion);
            }
            _success = "Fotoğraf kaydedildi.";
        }
        catch { _error = "Fotoğraf kaydedilemedi. Bağlantıyı ve dosyanızı kontrol edip yeniden deneyin."; }
        finally { _busy = false; }
    }

    private async Task UploadModel(InputFileChangeEventArgs e)
    {
        if (_busy) return;
        _busy = true; _error = null; _success = null;
        try
        {
            var file = e.File;
            if (file.Size > 50 * 1024 * 1024) { _error = "3D model dosyası en fazla 50 MB olabilir."; return; }
            using var form    = new MultipartFormDataContent();
            using var stream  = file.OpenReadStream(50 * 1024 * 1024);
            using var content = new StreamContent(stream);
            form.Add(content, "file", file.Name);
            using var response = await Clients.CreateClient("timeseries-api").PostAsync("api/image-assets/model", form);
            if (!response.IsSuccessStatusCode)
            {
                _error = (await response.Content.ReadFromJsonAsync<ErrorResult>())?.Error ?? "Model kaydedilemedi.";
                return;
            }
            _modelUrl = (await response.Content.ReadFromJsonAsync<ModelResult>())?.ModelUrl;
            _success  = "3D model kaydedildi.";
        }
        catch { _error = "3D model kaydedilemedi. Bağlantıyı ve dosyanızı kontrol edip yeniden deneyin."; }
        finally { _busy = false; }
    }
}
</div>