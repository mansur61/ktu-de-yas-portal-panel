@page "/image-settings"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using KtuDeYasPortal.Panel.Domain.Entities
@inject KtuDeYasPortal.Panel.Infrastructure.Persistence.PanelApiClients Clients
@inject KtuDeYasPortal.Panel.Domain.Interfaces.IStructureRepository Structures
@inject IJSRuntime JS

<PageTitle>Görsel Ayarları · DE-YAS</PageTitle>
<KtuDeYasPortal.Panel.Components.Shared.SettingsNavigation />
<div class="settings-page-content">

<div class="dy-heading">
    <div>
        <h1>Görsel ayarları</h1>
        <p>Yapıya özgü fotoğraf ve 3D model yükleyin. PNG/JPEG en fazla 5 MB, 3D modeller en fazla 50 MB.</p>
    </div>
</div>

@if (_error is not null)   { <div class="alert alert-danger mb-3 py-2"  role="alert">@_error <button type="button" class="btn-close float-end" @onclick="() => _error = null"></button></div> }
@if (_success is not null) { <div class="alert alert-success mb-3 py-2" role="status">@_success <button type="button" class="btn-close float-end" @onclick="() => _success = null"></button></div> }

<div class="row g-3">

    @* ── Yapı görseli ── *@
    <div class="col-lg-4 col-md-6">
        <section class="card p-3 h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="bi bi-image text-success fs-5"></span>
                <h2 class="h5 mb-0">Yapı görseli</h2>
            </div>
            <label class="form-label small fw-semibold mb-1">Yapı seçin</label>
            <SearchableSelect TItem="KtuDeYasPortal.Panel.Domain.Entities.Structure"
                Items="@_structures"
                TextSelector="@(s => $"{s.Name} · {s.Province}")"
                Value="@ImageStructure"
                ValueChanged="@(s => _imageStructureId = s?.Id.ToString() ?? string.Empty)"
                Placeholder="Yapı ara…"
                AllowClear="true"
                Disabled="@_busy" />
            <p class="text-muted small my-2">
                @(ImageStructure is null
                    ? "Yeni oluşturulan yapılarda gösterilir. Mevcut yapıların görseli değişmez."
                    : "Yalnızca bu yapının görselini değiştirir.")
            </p>
            <img src="@(ImageStructure?.ImageUrl ?? _defaultImageUrl ?? "/images/structures/dam.svg")"
                 alt="Yapı görseli" class="asset-preview mb-3" />
            <label class="form-label small">PNG veya JPEG yükle</label>
            <InputFile OnChange="UploadImage" accept="image/png,image/jpeg" disabled="@_busy" class="form-control form-control-sm" />
        </section>
    </div>

    @* ── 3D Model ── *@
    <div class="col-lg-4 col-md-6">
        <section class="card p-3 h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="bi bi-box text-success fs-5"></span>
                <h2 class="h5 mb-0">Yapı 3D modeli</h2>
                <span class="badge bg-light text-dark border ms-auto" style="font-size:10px">GLB · GLTF · OBJ · FBX</span>
            </div>
            <label class="form-label small fw-semibold mb-1">Yapı seçin</label>
            <SearchableSelect TItem="KtuDeYasPortal.Panel.Domain.Entities.Structure"
                Items="@_structures"
                TextSelector="@(s => $"{s.Name} · {s.Province}")"
                Value="@ModelStructure"
                ValueChanged="@(s => _modelStructureId = s?.Id.ToString() ?? string.Empty)"
                Placeholder="Yapı ara…"
                AllowClear="true"
                Disabled="@_busy" />
            <p class="text-muted small my-2">
                @(ModelStructure is null
                    ? "Dijital ikizde yapı bazında model yoksa kullanılır. En fazla 50 MB."
                    : "Bu yapının dijital ikiz görünümünde kullanılır. En fazla 50 MB.")
            </p>
            @{ var modelUrl = ModelStructure?.ModelUrl ?? _defaultModelUrl; }
            @if (!string.IsNullOrWhiteSpace(modelUrl))
            {
                <div class="asset-preview-3d mb-3 d-flex flex-column align-items-center justify-content-center gap-2">
                    <span class="bi bi-box-seam" style="font-size:42px;color:#9cba9d"></span>
                    <div class="text-center">
                        <div class="fw-semibold small text-success">3D Model Yüklü</div>
                        <div class="text-muted" style="font-size:10px;word-break:break-all">
                            @(Uri.TryCreate(modelUrl, UriKind.Absolute, out var mu) ? System.IO.Path.GetFileName(mu.LocalPath) : modelUrl)
                        </div>
                    </div>
                    <a href="@modelUrl" target="_blank" class="btn btn-sm btn-outline-secondary py-0">
                        <span class="bi bi-download me-1"></span>İndir
                    </a>
                </div>
            }
            else
            {
                <div class="asset-preview-3d mb-3 d-flex flex-column align-items-center justify-content-center gap-2 text-muted">
                    <span class="bi bi-box" style="font-size:42px;opacity:.3"></span>
                    <span class="small">Henüz 3D model yüklenmedi</span>
                </div>
            }
            <label class="form-label small">GLB, GLTF, OBJ veya FBX yükle</label>
            <InputFile OnChange="UploadModel" accept=".glb,.gltf,.obj,.fbx" disabled="@_busy" class="form-control form-control-sm" />
            <div class="mt-2 p-2 rounded" style="background:#f4f6f0;font-size:11px;color:#586d65">
                <span class="bi bi-info-circle me-1"></span>GLB veya GLTF önerilir — Three.js ile doğrudan çalışır.
            </div>
        </section>
    </div>

    @* ── Sensör fotoğrafı ── *@
    <div class="col-lg-4 col-md-6">
        <section class="card p-3 h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="bi bi-cpu text-success fs-5"></span>
                <h2 class="h5 mb-0">Sensör fotoğrafı</h2>
            </div>

            <label class="form-label small fw-semibold mb-1">Yapı seçin</label>
            <SearchableSelect TItem="KtuDeYasPortal.Panel.Domain.Entities.Structure"
                Items="@_structures"
                TextSelector="@(s => $"{s.Name} · {s.Province}")"
                Value="@SensorStructure"
                ValueChanged="@(async s => await OnSensorStructureChanged(s?.Id.ToString() ?? string.Empty))"
                Placeholder="Yapı ara…"
                AllowClear="true"
                Disabled="@_busy" />

            @if (!string.IsNullOrEmpty(_sensorStructureId))
            {
                <label class="form-label small fw-semibold mt-2 mb-1">Sensör seçin</label>
                <SearchableSelect TItem="KtuDeYasPortal.Panel.Domain.Entities.Sensor"
                    Items="@_structureSensors"
                    TextSelector="@(s => $"{s.EffectiveDisplayName} · {s.DeviceId}")"
                    Value="@SelectedSensor"
                    ValueChanged="@(s => _sensorId = s?.Id.ToString() ?? string.Empty)"
                    Placeholder="Sensör ara…"
                    AllowClear="true"
                    Disabled="@_busy" />
            }

            <div class="mt-3">
                @if (SelectedSensor?.ImageUrl is { Length: > 0 } surl)
                {
                    <img src="@surl" alt="Sensör fotoğrafı" class="asset-preview mb-3" />
                }
                else
                {
                    <div class="asset-preview mb-3 d-flex align-items-center justify-content-center text-muted small">
                        @(string.IsNullOrEmpty(_sensorStructureId) ? "Önce yapı seçin" :
                          string.IsNullOrEmpty(_sensorId) ? "Sensör seçin" : "Henüz fotoğraf eklenmedi")
                    </div>
                }
                <label class="form-label small">PNG veya JPEG yükle</label>
                <InputFile OnChange="UploadSensor" accept="image/png,image/jpeg"
                           disabled="@(_busy || SelectedSensor is null)" class="form-control form-control-sm" />
            </div>
        </section>
    </div>

    @* ── Kurumsal arka plan ── *@
    <div class="col-lg-4 col-md-6">
        <section class="card p-3 h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="bi bi-panorama text-success fs-5"></span>
                <h2 class="h5 mb-0">Kurumsal arka plan</h2>
                <span class="badge bg-light text-dark border ms-auto" style="font-size:10px">Global</span>
            </div>
            <p class="text-muted small mb-3">Tüm portal ve panel ekranlarında kullanılır. Yapı seçiminden bağımsızdır.</p>
            <img src="@($"/institutional-background?v={_backgroundVersion}")"
                 alt="Güncel kurumsal arka plan" class="asset-preview mb-3" />
            <label class="form-label small">PNG veya JPEG yükle</label>
            <InputFile OnChange="UploadBackground" accept="image/png,image/jpeg" disabled="@_busy" class="form-control form-control-sm" />
        </section>
    </div>

</div>

@if (_busy) { <p class="mt-3 text-muted small" role="status"><span class="spinner-border spinner-border-sm me-1"></span>Dosya kaydediliyor…</p> }

</div>

<style>
    .asset-preview     { width:100%; height:140px; object-fit:contain; border-radius:10px; background:#f1f5f7; }
    .asset-preview-3d  { width:100%; height:140px; border-radius:10px; background:#f1f5f7; border:1px dashed #c8d5c9; }
</style>

@code {
    private List<Structure> _structures       = [];
    private List<Sensor>    _structureSensors = [];  // seçili yapının sensörleri (detaylı)

    private string _imageStructureId  = "";
    private string _modelStructureId  = "";
    private string _sensorStructureId = "";
    private string _sensorId          = "";

    private string? _defaultImageUrl, _defaultModelUrl, _error, _success;
    private bool    _busy;

    private long    _backgroundVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

    private Structure? ImageStructure  => _structures.FirstOrDefault(s => s.Id.ToString() == _imageStructureId);
    private Structure? ModelStructure  => _structures.FirstOrDefault(s => s.Id.ToString() == _modelStructureId);
    private Structure? SensorStructure => _structures.FirstOrDefault(s => s.Id.ToString() == _sensorStructureId);
    private Sensor?    SelectedSensor  => _structureSensors.FirstOrDefault(s => s.Id.ToString() == _sensorId);

    private sealed record ImageResult(string? ImageUrl);
    private sealed record ModelResult(string? ModelUrl);
    private sealed record ErrorResult(string? Error);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var api    = Clients.CreateClient("timeseries-api");
            // Önce sensörlü endpoint'i dene, eski sunucuda normal listeye fall back
            try   { _structures = await Structures.GetAllWithSensorsAsync(); }
            catch { _structures = await Structures.GetAllAsync(); }
            _defaultImageUrl = (await api.GetFromJsonAsync<ImageResult>("api/image-assets/default"))?.ImageUrl;
        }
        catch (Exception ex) { _error = $"Görsel ayarları yüklenemedi: {ex.Message}"; return; }

        try { _defaultModelUrl = (await Clients.CreateClient("timeseries-api").GetFromJsonAsync<ModelResult>("api/image-assets/default-model"))?.ModelUrl; }
        catch { /* eski sunucu */ }
    }

    // Yapı seçilince o yapının sensörlerini filtrele — ek API isteği yok
    private Task OnSensorStructureChanged(string structureId)
    {
        _sensorStructureId = structureId;
        _sensorId          = "";
        _structureSensors  = string.IsNullOrEmpty(structureId)
            ? []
            : _structures
                .FirstOrDefault(s => s.Id.ToString() == structureId)
                ?.Sensors
                .Where(ss => ss.IsActive)
                .Select(ss => new Sensor
                {
                    Id          = ss.SensorId,
                    Name        = ss.Name,
                    DisplayName = ss.DisplayName,
                    DeviceId    = ss.DeviceId,
                    SensorType  = Enum.TryParse<DeYas.Contracts.Sensors.SensorType>(ss.SensorType, out var st)
                                  ? st : DeYas.Contracts.Sensors.SensorType.Generic,
                    Unit        = ss.Unit,
                    Topic       = ss.Topic,
                    Description = ss.Description,
                    Metrics     = ss.Metrics,
                    ImagePositionX = ss.ImagePositionX,
                    ImagePositionY = ss.ImagePositionY,
                    ImageUrl       = ss.ImageUrl,
                    ProtocolType   = ss.SourceKind,
                })
                .ToList()
            ?? [];
        return Task.CompletedTask;
    }

    // ── Upload: yapı görseli ──────────────────────────────────────────────
    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        if (_busy) return;
        _busy = true; _error = null; _success = null;
        try
        {
            var file = e.File;
            if (file.Size > 5 * 1024 * 1024) { _error = "Fotoğraf en fazla 5 MB olabilir."; return; }
            using var form    = new MultipartFormDataContent();
            using var stream  = file.OpenReadStream(5 * 1024 * 1024);
            using var content = new StreamContent(stream);
            form.Add(content, "file", file.Name);
            if (ImageStructure is { } sel)
            {
                using var resp = await Clients.CreateClient("timeseries-api").PostAsync($"api/image-assets/structure-image?structureId={sel.Id}", form);
                if (!resp.IsSuccessStatusCode) { _error = (await resp.Content.ReadFromJsonAsync<ErrorResult>())?.Error ?? "Yüklenemedi."; return; }
                sel.ImageUrl = (await resp.Content.ReadFromJsonAsync<ImageResult>())?.ImageUrl;
            }
            else
            {
                using var resp = await Clients.CreateClient("timeseries-api").PostAsync("api/image-assets/default", form);
                if (!resp.IsSuccessStatusCode) { _error = (await resp.Content.ReadFromJsonAsync<ErrorResult>())?.Error ?? "Yüklenemedi."; return; }
                _defaultImageUrl = (await resp.Content.ReadFromJsonAsync<ImageResult>())?.ImageUrl;
            }
            _success = "Fotoğraf kaydedildi.";
        }
        catch { _error = "Fotoğraf kaydedilemedi."; }
        finally { _busy = false; }
    }

    // ── Upload: 3D model ─────────────────────────────────────────────────
    private async Task UploadModel(InputFileChangeEventArgs e)
    {
        if (_busy) return;
        _busy = true; _error = null; _success = null;
        try
        {
            var file = e.File;
            if (file.Size > 50 * 1024 * 1024) { _error = "3D model en fazla 50 MB olabilir."; return; }
            using var form    = new MultipartFormDataContent();
            using var stream  = file.OpenReadStream(50 * 1024 * 1024);
            using var content = new StreamContent(stream);
            form.Add(content, "file", file.Name);
            var endpoint = ModelStructure is { } sel ? $"api/image-assets/model?structureId={sel.Id}" : "api/image-assets/model";
            using var response = await Clients.CreateClient("timeseries-api").PostAsync(endpoint, form);
            if (!response.IsSuccessStatusCode) { _error = (await response.Content.ReadFromJsonAsync<ErrorResult>())?.Error ?? "Yüklenemedi."; return; }
            var url = (await response.Content.ReadFromJsonAsync<ModelResult>())?.ModelUrl;
            if (ModelStructure is { } selStr) selStr.ModelUrl = url;
            else _defaultModelUrl = url;
            _success = "3D model kaydedildi.";
        }
        catch { _error = "3D model kaydedilemedi."; }
        finally { _busy = false; }
    }

    // ── Upload: sensör fotoğrafı ──────────────────────────────────────────
    private async Task UploadSensor(InputFileChangeEventArgs e)
    {
        if (_busy || SelectedSensor is null) return;
        _busy = true; _error = null; _success = null;
        try
        {
            var file = e.File;
            if (file.Size > 5 * 1024 * 1024) { _error = "Fotoğraf en fazla 5 MB olabilir."; return; }
            using var form    = new MultipartFormDataContent();
            using var stream  = file.OpenReadStream(5 * 1024 * 1024);
            using var content = new StreamContent(stream);
            form.Add(content, "file", file.Name);
            using var response = await Clients.CreateClient("timeseries-api").PostAsync($"api/image-assets/sensor?sensorId={SelectedSensor.Id}", form);
            if (!response.IsSuccessStatusCode) { _error = (await response.Content.ReadFromJsonAsync<ErrorResult>())?.Error ?? "Yüklenemedi."; return; }
            SelectedSensor.ImageUrl = (await response.Content.ReadFromJsonAsync<ImageResult>())?.ImageUrl;
            _success = "Sensör fotoğrafı kaydedildi.";
        }
        catch { _error = "Sensör fotoğrafı kaydedilemedi."; }
        finally { _busy = false; }
    }

    // ── Upload: kurumsal arka plan ────────────────────────────────────────
    private async Task UploadBackground(InputFileChangeEventArgs e)
    {
        if (_busy) return;
        _busy = true; _error = null; _success = null;
        try
        {
            var file = e.File;
            if (file.Size > 5 * 1024 * 1024) { _error = "Fotoğraf en fazla 5 MB olabilir."; return; }
            using var form    = new MultipartFormDataContent();
            using var stream  = file.OpenReadStream(5 * 1024 * 1024);
            using var content = new StreamContent(stream);
            form.Add(content, "file", file.Name);
            using var response = await Clients.CreateClient("timeseries-api").PostAsync("api/image-assets/background", form);
            if (!response.IsSuccessStatusCode) { _error = (await response.Content.ReadFromJsonAsync<ErrorResult>())?.Error ?? "Yüklenemedi."; return; }
            _backgroundVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            await JS.InvokeVoidAsync("deyasInstitutionalBackground.refresh", _backgroundVersion);
            _success = "Arka plan kaydedildi.";
        }
        catch { _error = "Arka plan kaydedilemedi."; }
        finally { _busy = false; }
    }
}
