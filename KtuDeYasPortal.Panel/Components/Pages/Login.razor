@page "/login"
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>DSİ Panel Girişi</PageTitle>
<div class="login-wrapper"><div class="login-card">
    <div class="login-header"><span class="bi bi-shield-lock-fill login-icon"></span><h4>DSİ Baraj İzleme</h4><p class="text-muted">Panel kullanıcı erişimi</p></div>
    <div class="login-body">
        <div class="btn-group w-100 mb-4"><a class="btn @(!RegisterMode ? "btn-primary" : "btn-outline-primary")" href="/login">Giriş Yap</a><a class="btn @(RegisterMode ? "btn-primary" : "btn-outline-primary")" href="/login?register=true">Kayıt Ol</a></div>
        @if (Error is not null) { <div class="alert alert-warning">@(Error == "token" ? "Kimlik servisinde JWT anahtarı ve token üretimi yapılandırılmalıdır." : Error == "register" ? "Kayıt tamamlanamadı. Kullanıcı adını ve en az 8 karakterli şifreyi kontrol edin." : "Kullanıcı adı veya şifre hatalı.")</div> }
        @if (Registered) { <div class="alert alert-success">Kayıt tamamlandı. Giriş yapabilirsiniz; yapı yetkileriniz yönetici tarafından verilir.</div> }
        <form method="post" action="@(RegisterMode ? "/session/register" : "/session/login")">
            <AntiforgeryToken />
            <label class="form-label fw-semibold">Kullanıcı adı</label><input name="username" class="form-control mb-3" autocomplete="username" required />
            <label class="form-label fw-semibold">Şifre</label><input name="password" type="password" class="form-control mb-3" autocomplete="@(RegisterMode ? "new-password" : "current-password")" required />
            @if (RegisterMode) { <label class="form-label">Kurum</label><input name="organization" class="form-control mb-3" /> }
            <button class="btn btn-primary w-100 py-2" type="submit">@(RegisterMode ? "Kayıt Ol" : "Giriş Yap")</button>
        </form>
    </div>
</div></div>
@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "register")] public bool RegisterMode { get; set; }
    [SupplyParameterFromQuery(Name = "registered")] public bool Registered { get; set; }
}
