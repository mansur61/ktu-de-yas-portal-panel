@using DeYas.Contracts.Authorization
@inject PanelAccess Access
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "media.access")]
@page "/media-dashboard"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IMediaArchiveClient MediaArchive
@inject ILiveCameraClient LiveCamera
@inject StructureUseCases StructureUC
@inject IStructureSimulationClient StructureSimClient
@inject IJSRuntime JS

<PageTitle>Medya Arşivi</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0 fw-bold">Medya Arşivi</h4>
        <small class="text-muted">Sahadan merkeze aktarılan video kayıtları</small>
    </div>
    <button class="btn btn-outline-primary" @onclick="LoadAsync" disabled="@_loading">
        <span class="bi bi-arrow-clockwise me-1"></span> Yenile
    </button>
</div>

<div class="card shadow-sm mb-3"><div class="card-body"><div class="row g-2 align-items-end">
    <div class="col-lg-3 col-md-6"><label class="form-label small">Yapı</label><select class="form-select" @bind="_structureId" @bind:after="OnStructureFilterChanged"><option value="">Tüm yapılar</option>@foreach (var item in _structures) { <option value="@item.Id">@item.Name</option> }</select></div>
    <div class="col-lg-3 col-md-6"><label class="form-label small">Kamera</label><select class="form-select" @bind="_deviceId" @bind:after="StopLiveAsync"><option value="">Tüm kameralar</option>@foreach (var item in Cameras) { <option value="@item.DeviceId">@item.EffectiveDisplayName (@item.DeviceId)</option> }</select></div>
    <div class="col-lg-2 col-md-6"><label class="form-label small">Arşiv başlangıcı</label><input class="form-control" type="datetime-local" @bind="_from" /></div>
    <div class="col-lg-2 col-md-6"><label class="form-label small">Arşiv bitişi</label><input class="form-control" type="datetime-local" @bind="_to" /></div>
    <div class="col-lg-2 col-md-6 d-grid"><button class="btn btn-primary" @onclick="LoadAsync">Filtrele</button></div>
</div></div></div>

<div class="nav nav-tabs mb-3">
    <button class="nav-link @(_tab == MediaTab.Live ? "active" : "")" @onclick="() => SelectTabAsync(MediaTab.Live)">Canlı görüntü</button>
    <button class="nav-link @(_tab == MediaTab.Archive ? "active" : "")" @onclick="() => SelectTabAsync(MediaTab.Archive)">
        Medya Arşivi
        @if (_archiveTotalCount.HasValue)
        {
            <span class="badge rounded-pill text-bg-secondary ms-2" aria-label="@($"{_archiveTotalCount.GetValueOrDefault():N0} medya kaydı")">@_archiveTotalCount.GetValueOrDefault().ToString("N0")</span>
        }
    </button>

</div>

<div id="archive-help" popover="auto" class="archive-protection-help"><strong>Araştırma koruması</strong><p>Koruma açıkken saklama süresi dolsa bile kayıt otomatik silinmez. Korumayı kaldırdığınızda normal saklama politikası yeniden uygulanır. Kaydı elle silmek için de önce korumayı kaldırmanız gerekir.</p></div>

@if (_tab == MediaTab.Live)
{
    <div class="card shadow-sm mb-3"><div class="card-body">
        <div class="d-flex flex-wrap align-items-end gap-2">
            <div><label class="form-label small">Video süresi (saniye)</label><input type="number" min="1" max="60" class="form-control" style="width:150px" @bind="_recordSeconds" disabled="@_capturing" /></div>
            <button class="btn btn-primary" @onclick="StartLiveAsync" disabled="@(!CanLive || _liveStarting || _liveSession is not null)">@(_liveStarting ? "Bağlanıyor…" : "Canlı görüntüyü başlat")</button>
            @if (_liveSession is not null) { <button class="btn btn-outline-danger" @onclick="StopLiveAsync">Yayını kapat</button> }
            <button class="btn btn-success" @onclick="CaptureAsync" disabled="@(!CanCapture || _capturing)">@(_capturing ? "Kayıt alınıyor…" : "Seçili kameradan video al")</button>
        </div>
        <div class="form-text mt-2">Canlı akıştan 1–60 saniyelik video kaydedin. Yukarıdaki tarihler yalnız arşiv kayıtlarını filtreler.</div>
    </div></div>
}
@if (_tab == MediaTab.Live && _liveError is not null) { <div class="alert alert-warning">@_liveError <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="StartLiveAsync">Yeniden dene</button></div> }
@if (_tab == MediaTab.Live && (_liveSession is not null || _liveStarting))
{
    <section class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center"><strong>Canlı kamera · @_deviceId</strong><button class="btn btn-sm btn-outline-danger" @onclick="StopLiveAsync">Yayını kapat</button></div>
        <div class="card-body bg-dark text-center">
            @if (_liveStarting) { <div class="text-light py-5"><span class="spinner-border me-2"></span>Saha kamerasından yayın bekleniyor…</div> }
            <video id="live-camera-video" class="w-100" autoplay playsinline style="max-height:70vh;@( _liveStarting ? "display:none" : "")"></video>
        </div>
        <div class="card-footer small text-muted">Canlı oturum bitişi (tarayıcınızın yerel saati): @_liveExpiresLocal</div>
    </section>
}
@if (_captureNotice is not null) { <div class="alert alert-info">@_captureNotice</div> }
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger">@_error</div> }
@if (_loading) { <div class="text-center py-5"><span class="spinner-border text-primary"></span></div> }
else if (_tab == MediaTab.Archive && !VisibleAssets.Any()) { <div class="alert alert-light border"><span class="bi bi-camera-video me-2"></span>Bu filtrede merkezi arşive ulaşmış medya kaydı yok.</div> }
else if (_tab == MediaTab.Archive) {
    @if (_page > 0 || _nextCursor is not null)
    {
        <nav class="d-flex justify-content-end align-items-center gap-2 mb-3" aria-label="Medya arşivi sayfaları">
            <span class="small text-muted me-2">Sayfa @(_page + 1) · @_assets.Count kayıt</span>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_loading || _page == 0)" @onclick="PreviousPageAsync">Önceki</button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_loading || _nextCursor is null)" @onclick="NextPageAsync">Sonraki</button>
        </nav>
    }
    <p>Toplam @(_archiveTotalCount?.ToString("N0") ?? "—") kayıt · Bu sayfada @_assets.Count</p>
    <MediaArchiveGrid ItemCount="_assets.Count" CapacityChanged="ArchiveCapacityChanged">
    @foreach (var asset in VisibleAssets)
    {
        <MediaArchiveCard @key="asset.Id" SensorName="@CameraName(asset)" RecordId="asset.Id" Timestamp="asset.CapturedAt" Kind="video"
            DurationSeconds="asset.DurationSeconds" PreviewUrl="@_thumbnails.GetValueOrDefault(asset.Id)" OnOpen="() => OpenAsync(asset)">
            <Actions>
                @if (asset.IsProtected) { <span class="badge text-bg-warning">Araştırma için korunuyor</span> }
                <button type="button" class="archive-protection-info" popovertarget="archive-help" aria-label="Araştırma koruması bilgisi"><i class="bi bi-info-circle-fill" aria-hidden="true"></i></button>
                @if (CanProtect(asset))
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleProtectionAsync(asset)">@(asset.IsProtected ? "Korumayı kaldır" : "Araştırma için koru")</button>
                    <button class="btn btn-sm btn-outline-danger" disabled="@(asset.IsProtected || _deleting)" title="@(asset.IsProtected ? "Silmek için önce korumayı kaldırın" : "Video kaydını sil")" aria-label="Video kaydını sil" @onclick="() => DeleteAsync(asset)"><i class="bi bi-trash"></i></button>
                }
            </Actions>
        </MediaArchiveCard>
    }
    </MediaArchiveGrid>
}

@if (_selected is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.55)"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">@_selected.DeviceId · @_selected.CapturedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</h5><button class="btn-close" @onclick="Close"></button></div>
        <div class="modal-body text-center bg-dark">@if (_previewLoading) { <span class="spinner-border text-light my-5"></span> } else if (_previewUrl is null || _previewError is not null) { <p class="text-light m-4">@(_previewError ?? "Medya bağlantısı üretilemedi.")</p> } else if (_selected.Kind == "video") { <video src="@_previewUrl" controls class="w-100" style="max-height:65vh" @onerror="PreviewLoadFailed"></video> } else { <img src="@_previewUrl" class="img-fluid" style="max-height:65vh" @onerror="PreviewLoadFailed" /> }</div>
    </div></div></div>
}

@code {
    [SupplyParameterFromQuery(Name="structureId")] public Guid? QueryStructureId { get; set; }
    [SupplyParameterFromQuery(Name="deviceId")] public string? QueryDeviceId { get; set; }
    private bool _capturing;
    private int _recordSeconds = 10;
    private bool _liveStarting;
    private int _liveRequestGeneration;
    private LiveCameraSession? _liveSession;
    private string? _liveError;
    private string? _liveExpiresLocal;
    private string? _captureNotice;
    private Structure? SelectedStructure => _structures.FirstOrDefault(s => s.Id.ToString() == _structureId);
    private bool CanCapture => SelectedStructure is { } s
        && Cameras.Any(c => c.DeviceId == _deviceId) && (_mediaAccess.IsAdmin || _mediaAccess.StructureIds.Contains(s.Id)) && (_manageAccess.IsAdmin || _manageAccess.StructureIds.Contains(s.Id));
    private bool CanLive => SelectedStructure is { } s && Cameras.Any(c => c.DeviceId == _deviceId)
        && (_mediaAccess.IsAdmin || _mediaAccess.StructureIds.Contains(s.Id));

    private async Task StartLiveAsync()
    {
        if (!CanLive || _liveStarting || _liveSession is not null) return;
        var request = ++_liveRequestGeneration;
        var targetStructure = SelectedStructure!.Id;
        var targetDevice = _deviceId;
        _liveStarting = true; _liveError = null;
        try
        {
            var session = await LiveCamera.StartAsync(targetStructure, targetDevice);
            if (request != _liveRequestGeneration || SelectedStructure?.Id != targetStructure || _deviceId != targetDevice)
            { await LiveCamera.StopAsync(targetStructure, session.SessionId); return; }
            _liveSession = session;
            _liveStructureId = targetStructure;
            _liveExpiresLocal = await JS.InvokeAsync<string>("deyasLiveCamera.formatExpiry", session.ExpiresAt.ToString("O"));
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);
            if (request != _liveRequestGeneration) return;
            await JS.InvokeVoidAsync("deyasLiveCamera.start", "live-camera-video", session.WhepUrl, session.ViewerToken);
        }
        catch (Exception ex)
        {
            if (request != _liveRequestGeneration) return;
            _liveError = ex.Message.Split("\n")[0];
            if (_liveSession is not null)
            {
                try { await LiveCamera.StopAsync(targetStructure, _liveSession.SessionId); } catch { }
                _liveSession = null;
            }
        }
        finally { _liveStarting = false; }
    }

    private async Task StopLiveAsync()
    {
        _liveRequestGeneration++;
        var session = _liveSession;
        _liveSession = null;
        if (session is null) return;
        try { await JS.InvokeVoidAsync("deyasLiveCamera.stop", "live-camera-video"); }
        catch { }
        try { await LiveCamera.StopAsync(_liveStructureId!.Value, session.SessionId); }
        catch (Exception ex) { _liveError = $"Yayın durdurma isteği iletilemedi: {ex.Message}"; }
    }
    private async Task CaptureAsync()
    {
        if (!CanCapture || _capturing) return;
        _capturing = true; _captureNotice = null; _error = null;
        try
        {
            await LiveCamera.CaptureAsync(SelectedStructure!.Id, _deviceId, _recordSeconds, "video");
            _captureNotice = "Video kaydı başarıyla arşive eklendi.";
            _to = DateTime.Now;
            if (_from > _to) _from = _to.Value.AddHours(-24);
            _tab = MediaTab.Archive;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _capturing = false; }
    }
    private List<Structure> _structures = [];
    private PanelAccessSnapshot _manageAccess = new(false, []);
    private PanelAccessSnapshot _mediaAccess = new(false, []);
    private List<MediaAsset> _assets = [];
    private string _structureId = "", _deviceId = "";
    private DateTime? _from = DateTime.Now.AddHours(-24), _to = DateTime.Now;
    private bool _loading, _previewLoading; private string? _error, _previewUrl, _previewError; private MediaAsset? _selected;
    private long? _archiveTotalCount;
    private Guid? _protectionInfoAssetId;
    private MediaTab _tab = MediaTab.Live;
    private int ArchivePageSize = 4;
    private readonly Dictionary<Guid, string?> _thumbnails = new();
    private bool _deleting;
    private int _loadGeneration;
    private Guid? _liveStructureId;
    private List<string?> _cursorStack = [null];
    private string? _nextCursor;
    private int _page;
    private IEnumerable<MediaAsset> VisibleAssets => _assets;
    private IEnumerable<StructureSensor> Cameras => _structures.Where(s => string.IsNullOrWhiteSpace(_structureId) || s.Id.ToString() == _structureId).SelectMany(s => s.Sensors).Where(s => s.SensorType.Equals("Camera", StringComparison.OrdinalIgnoreCase));
    protected override async Task OnInitializedAsync() { _mediaAccess = await Access.GetAsync(BarajPermissions.Media, PortalMenuPermissions.Media); _manageAccess = await Access.GetAsync(BarajPermissions.Manage, PortalMenuPermissions.Media); _structures = (await StructureUC.GetAllAsync()).Where(s => _mediaAccess.IsAdmin || _mediaAccess.StructureIds.Contains(s.Id)).ToList(); foreach (var s in _structures) { var detail = await StructureUC.GetByIdAsync(s.Id); if (detail is not null) s.Sensors = detail.Sensors; } if(_structures.Any(s=>s.Id==QueryStructureId)) { _structureId=QueryStructureId!.Value.ToString(); if(Cameras.Any(c=>c.DeviceId==QueryDeviceId))_deviceId=QueryDeviceId!; } await LoadAsync();  }
    private async Task LoadAsync()
    {
        if (_liveSession is not null) await StopLiveAsync();
        _cursorStack = [null];
        _page = 0;
        _archiveTotalCount = null;
        await LoadPageAsync(null);
    }
    private async Task<bool> LoadPageAsync(string? cursor)
    {
        var generation = ++_loadGeneration;
        _loading = true;
        _error = null;
        try
        {
            var result = await MediaArchive.ListPageAsync(
                _structureId, _deviceId, _from?.ToUniversalTime(), _to?.ToUniversalTime(),
                "video", cursor, ArchivePageSize);
            if (generation != _loadGeneration) return false;
            _assets = result.Items.Where(a => a.Kind == "video").ToList();
            _thumbnails.Clear();
            foreach (var asset in _assets.Where(a => !string.IsNullOrWhiteSpace(a.ThumbnailKey)))
            {
                try { _thumbnails[asset.Id] = await MediaArchive.GetPresignedUrlAsync(asset.ThumbnailBucket ?? asset.Bucket, asset.ThumbnailKey); }
                catch { /* The shared card provides a fallback when preview is unavailable. */ }
                if (generation != _loadGeneration) return false;
            }
            _nextCursor = result.NextCursor;
            if (result.TotalCount.HasValue) _archiveTotalCount = result.TotalCount;
            return true;
        }
        catch (Exception ex) { if (generation == _loadGeneration) { _assets = []; _nextCursor = null; _archiveTotalCount = null; _error = $"Medya arşivi okunamadı: {ex.Message}"; } return false; }
        finally { if (generation == _loadGeneration) _loading = false; }
    }
    private async Task NextPageAsync()
    {
        if (_nextCursor is null) return;
        var cursor = _nextCursor;
        if (_cursorStack.Count > _page + 1)
            _cursorStack.RemoveRange(_page + 1, _cursorStack.Count - _page - 1);
        _cursorStack.Add(cursor);
        _page++;
        if (!await LoadPageAsync(cursor))
        {
            _cursorStack.RemoveAt(_cursorStack.Count - 1);
            _page--;
        }
    }
    private async Task PreviousPageAsync()
    {
        if (_page == 0) return;
        _page--;
        if (!await LoadPageAsync(_cursorStack[_page])) _page++;
    }
    private async Task OnStructureFilterChanged()
    {
        await StopLiveAsync();
        if (!Cameras.Any(camera => camera.DeviceId == _deviceId)) _deviceId = string.Empty;
        _archiveTotalCount = null; _assets = [];
    }
    private async Task SelectTabAsync(MediaTab tab) { if (tab == MediaTab.Archive) await StopLiveAsync(); _tab = tab; if (tab == MediaTab.Archive) await LoadAsync(); }
    private async Task OpenAsync(MediaAsset asset) { _selected = asset; _previewUrl = null; _previewError = null; _previewLoading = true; try { _previewUrl = await MediaArchive.GetPresignedUrlAsync(asset.Bucket, asset.ObjectKey); } catch { _previewError = "Kayıt açılırken merkezi arşive ulaşılamadı. Birkaç saniye sonra yeniden deneyin."; } finally { _previewLoading = false; } }
    private bool CanProtect(MediaAsset asset) => _manageAccess.IsAdmin || _structures.Any(s => _manageAccess.StructureIds.Contains(s.Id) && s.Sensors.Any(c => c.DeviceId == asset.DeviceId));
    private async Task ToggleProtectionAsync(MediaAsset asset) { try { await MediaArchive.SetProtectionAsync(asset, !asset.IsProtected); await LoadAsync(); } catch { _error = "Kayıt koruması değiştirilemedi; yapı yönetim yetkisi gerekir."; } }
    private void ToggleProtectionInfo(Guid assetId) => _protectionInfoAssetId = _protectionInfoAssetId == assetId ? null : assetId;
    private string CameraName(MediaAsset asset) => Cameras.FirstOrDefault(c => c.DeviceId == asset.DeviceId)?.EffectiveDisplayName ?? asset.DeviceId;
    private async Task ArchiveCapacityChanged(int size)
    {
        if (size == ArchivePageSize) return;
        ArchivePageSize = size;
        await LoadAsync();
    }
    private async Task DeleteAsync(MediaAsset asset)
    {
        if (_deleting || asset.IsProtected || !CanProtect(asset)) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"{CameraName(asset)} video kaydı kalıcı olarak silinsin mi?")) return;
        _deleting = true;
        try { await MediaArchive.DeleteAsync(asset); await LoadAsync(); }
        catch { _error = "Video silinemedi. Kayıt korumasını, yetkinizi ve arşiv bağlantısını kontrol edin."; }
        finally { _deleting = false; }
    }
    private void PreviewLoadFailed() => _previewError = "Kayıt görüntülenemedi. Merkezi arşiv bağlantısını kontrol edip yeniden deneyin.";
    private void Close() { _selected = null; _previewUrl = null; _previewError = null; }
    public async ValueTask DisposeAsync() { if (_liveSession is not null) await StopLiveAsync(); }
    private static string ArchiveStatus(string status) => status.ToLowerInvariant() switch
    {
        "uploaded" or "processed" => "Merkezi arşivde",
        "uploading" or "processing" => "Arşive aktarılıyor",
        "failed" or "error" => "Arşivleme tamamlanamadı",
        _ => status
    };
    private static string FormatSize(long? value) => value is null ? "Boyut bilinmiyor" : value < 1024 * 1024 ? $"{value.Value / 1024d:0} KB" : $"{value.Value / 1024d / 1024d:0.0} MB";
    private enum MediaTab { Live, Archive }
}
