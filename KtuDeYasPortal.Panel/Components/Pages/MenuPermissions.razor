@page "/menu-permissions"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using DeYas.Contracts.Authorization
@inject IHttpClientFactory HttpFactory
@inject ILogger<MenuPermissions> Logger

<PageTitle>Menü Yetkileri</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Menü Yetkileri</h4>
        <small class="text-muted">Kullanıcının portalda açabileceği menüleri yönetin.</small>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_message)) { <div class="alert alert-success py-2">@_message</div> }
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger py-2">@_error</div> }

<div class="card shadow-sm">
    <div class="card-header bg-white"><strong><span class="bi bi-list-check me-2 text-primary"></span>Portal Menü Yetkileri</strong></div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-lg-5">
                <label class="form-label">Kullanıcı kimliği</label>
                <input class="form-control" @bind="_userId" placeholder="Kayıtlı UserId" />
            </div>
            <div class="col-lg-2">
                <button class="btn btn-outline-primary w-100" @onclick="LoadAsync" disabled="@_loading">
                    @if (_loading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Menüyü Yükle
                </button>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-2 mt-3">
            @foreach (var menu in Options)
            {
                <label class="form-check border rounded p-3">
                    <input class="form-check-input" type="checkbox" checked="@_selected.Contains(menu.Key)" @onchange="() => Toggle(menu.Key)" />
                    <span class="form-check-label"><strong class="d-block">@menu.Label</strong><small class="text-muted">@menu.Description</small></span>
                </label>
            }
        </div>
        <button class="btn btn-primary mt-3" @onclick="SaveAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_userId))">
            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Menü Yetkilerini Kaydet
        </button>
    </div>
</div>

@code {
    private static readonly (string Key, string Label, string Description)[] Options =
    [
        (PortalMenuPermissions.Home, "Ana sayfa", "Portal ana ekranını açar."),
        (PortalMenuPermissions.Structures, "Baraj izleme", "Baraj listesini ve detaylarını açar."),
        (PortalMenuPermissions.Sensors, "Sensör izleme", "Sensör ekranını açar."),
        (PortalMenuPermissions.Dashboard, "Zaman serisi", "Baraj bazlı zaman serisi ekranını açar."),
        (PortalMenuPermissions.Alerts, "Alertler", "Alert kuralları ve akışını açar."),
        (PortalMenuPermissions.Media, "Görüntüleme", "Video ve medya ekranlarını açar."),
        (PortalMenuPermissions.Historical, "Geçmiş veriler", "Geçmiş veri ekranını açar."),
        (PortalMenuPermissions.DigitalTwin, "Digital Twin", "Digital Twin ekranını açar.")
    ];
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private string _userId = string.Empty;
    private string? _message;
    private string? _error;
    private bool _loading;
    private bool _saving;
    private HttpClient AuthApi => HttpFactory.CreateClient("auth-api");

    private void Toggle(string permission)
    {
        if (!_selected.Add(permission)) _selected.Remove(permission);
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(_userId)) return;
        _loading = true; _error = null;
        try
        {
            var permissions = await AuthApi.GetFromJsonAsync<List<string>>(
                $"api/auth/menu-permissions?userId={Uri.EscapeDataString(_userId)}") ?? [];
            _selected.Clear();
            foreach (var permission in permissions) _selected.Add(permission);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Menu permissions could not be loaded for {UserId}", _userId);
            _error = "Menü yetkileri yüklenemedi. Ayrıntı için panel container logunu kontrol edin.";
        }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_userId)) return;
        _saving = true; _message = null; _error = null;
        try
        {
            var response = await AuthApi.PutAsJsonAsync("api/auth/menu-permissions",
                new UpdateMenuPermissionsRequest(_userId, _selected.ToArray()));
            if (!response.IsSuccessStatusCode) { _error = await response.Content.ReadAsStringAsync(); return; }
            _message = "Menü yetkileri kaydedildi.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Menu permissions could not be saved for {UserId}", _userId);
            _error = "Menü yetkileri kaydedilemedi. Ayrıntı için panel container logunu kontrol edin.";
        }
        finally { _saving = false; }
    }
}
