@page "/permissions"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "platform.admin")]
@using System.Net.Http.Json
@using DeYas.Contracts.Authorization
@inject KtuDeYasPortal.Panel.Infrastructure.Persistence.PanelApiClients Clients
<PageTitle>Rol ve Yetki Atama · SAHA</PageTitle>
<KtuDeYasPortal.Panel.Components.Shared.SettingsNavigation />
<header class="access-heading"><div><small>SAHA / YÖNETİM</small><h1>Rol ve Yetki Atama</h1><p>Kullanıcıların izleme seviyesini, erişim kapsamını ve işlem izinlerini yönetin.</p></div><button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@_saving">Yenile</button></header>
@if(_error is not null){<div class="alert alert-danger" role="alert">@_error</div>}
@if(_message is not null){<div class="alert alert-success" role="status">@_message</div>}
@if(_loading){<p role="status">Kullanıcılar ve yetki ağacı yükleniyor…</p>}else{
<div class="access-grid" data-ready="@(_interactiveReady ? "true" : "false")">
    <aside class="access-pane"><h2>Kullanıcılar <small>@_users.Count</small></h2><input class="form-control mb-3" aria-label="Kullanıcı ara" placeholder="Kullanıcı ara…" @bind="_search" @bind:event="oninput" />@foreach(var user in _users.Where(u=>u.UserName.Contains(_search,StringComparison.CurrentCultureIgnoreCase))){<button class="access-user @(user.UserId==_selectedId?"selected":"")" disabled="@_saving" @onclick="()=>SelectUser(user.UserId)"><span>@user.UserName.FirstOrDefault()</span><div><strong>@user.UserName</strong><small>@(user.IsPanelAdmin?"Platform yöneticisi":user.OrganizationName??"Portal kullanıcısı")</small></div></button>}</aside>
    <section class="access-pane"><h2>Hiyerarşik yetki ağacı</h2><label class="form-label" for="access-level">Yetki seviyesi</label><select id="access-level" class="form-select mb-3" @bind="_level" @bind:after="LevelChanged" disabled="@(_saving||_selectedId.Length==0)"><option value="1">Seviye 1 · Genel Müdür</option><option value="2">Seviye 2 · Bölge Müdürü</option><option value="3">Seviye 3 · İl Yetkilisi</option><option value="4">Seviye 4 · Yapı Sorumlusu</option></select>
        @if(_level==2){<label class="form-label" for="region-name">Bölge müdürlüğü adı</label><select id="region-name" class="form-select mb-3" @bind="_regionName" @bind:after="DsiRegionChanged"><option value="">Bölge seçin</option>@if(_regionName.Length>0&&!_regions.Any(r=>r.Name==_regionName)){<option value="@_regionName">@_regionName (mevcut kapsam)</option>}@foreach(var r in _regions){<option value="@r.Name">@r.Name</option>}</select>@if(SelectedRegion is {} selectedRegion){<p class="small">@string.Join(", ",selectedRegion.Provinces)</p>@if(selectedRegion.Notes.Length>0){<p class="alert alert-warning">@selectedRegion.Notes</p>}}}
        @if(_structures.Any(s=>string.IsNullOrWhiteSpace(s.Province))){<div class="alert alert-warning" role="status">İl bilgisi eksik yapılar var. Bölge/il yetkisine dahil etmek için Barajlar ve saha kurulumu ekranında bu yapıların ilini kaydedin.</div>}
        <div class="access-tree"><label class="access-tree-root"><input type="checkbox" checked="@(_level==1)" disabled="@(_level!=1)" /> Türkiye</label>
        @if(_level==2){<label class="access-region"><input type="checkbox" checked="@(SelectableProvinces.Any()&&SelectableProvinces.All(p=>_provinces.Contains(p)))" disabled="@(_saving||!SelectableProvinces.Any())" @onchange="ToggleRegion" /> <i class="bi bi-diagram-3"></i> @(string.IsNullOrWhiteSpace(_regionName)?"Bölge Müdürlüğü":_regionName)</label>}
        @foreach(var province in _structures.Where(s=>_level!=2||SelectedRegion is null||SelectableProvinces.Contains(s.Province)).GroupBy(s=>s.Province).OrderBy(g=>g.Key)){
            <details open><summary><label @onclick:stopPropagation><input type="checkbox" checked="@ProvinceSelected(province.Key)" disabled="@(_level==1||_saving||(_level is 2 or 3 && string.IsNullOrWhiteSpace(province.Key)))" @onchange="e=>ToggleProvince(province.Key,e.Value is true)" /> @(string.IsNullOrWhiteSpace(province.Key)?"İl bilgisi eksik":province.Key) <small>@province.Count() yapı</small></label></summary>
            @foreach(var structure in province.OrderBy(s=>s.Name)){
                <details class="access-structure"><summary><label @onclick:stopPropagation><input type="checkbox" checked="@StructureSelected(structure)" disabled="@(_level!=4||_saving)" @onchange="e=>ToggleStructure(structure.Id,e.Value is true)" /> @structure.Name</label></summary><div class="access-sensors">@foreach(var sensor in _sensors.Where(s=>structure.SensorIds.Contains(s.Id))){<label><input type="checkbox" checked="@(StructureSelected(structure)&&!_excludedSensors.Contains(sensor.Id))" disabled="@(!StructureSelected(structure)||_saving||SelectedAdmin)" @onchange="e=>ToggleSensor(sensor.Id,e.Value is true)" /> <i class="bi bi-broadcast-pin"></i> @sensor.Name</label>}<small>Yeni sensörler yapı kapsamını devralır; seçimini kaldırdığınız sensörlere erişilmez.</small></div></details>
            }</details>
        }</div><div class="access-tree-actions"><button class="btn btn-outline-primary" @onclick="SelectAll" disabled="@(_saving||_level==3)">Tümünü Seç</button><span>@_structures.Count(StructureSelected) yapı seçili</span></div>
    </section>
    <aside class="access-pane"><h2>İşlem izinleri</h2>@foreach(var operation in Operations){<label class="access-operation"><input type="checkbox" checked="@_operations.Contains(operation.Key)" disabled="@(operation.Key=="view"||_saving||operation.Key=="users"&&!SelectedAdmin)" @onchange="e=>ToggleOperation(operation.Key,e.Value is true)" /><span><strong>@operation.Label</strong><small>@operation.Description</small></span></label>}
        <div class="access-preview"><strong>Girişte açılacak ekran</strong><p>@Preview</p></div><button class="btn btn-primary w-100" disabled="@(_saving||_selectedId.Length==0)" @onclick="SaveAsync">@(_saving?"Kaydediliyor…":"Kaydet")</button>
    </aside>
</div>}
@code{
    private List<DeYas.Contracts.DsiRegionInfo> _regions=[];
    private DeYas.Contracts.DsiRegionInfo? SelectedRegion=>_regions.FirstOrDefault(r=>r.Name==_regionName);
    private void DsiRegionChanged(){_provinces.Clear();if(SelectedRegion is {} region)_provinces.UnionWith(region.Provinces);_excludedSensors.Clear();}
    private List<UserOption> _users=[];private List<StructureOption> _structures=[];private List<SensorOption> _sensors=[];
    private string _selectedId="",_search="",_regionName="";private int _level=4;
    private readonly HashSet<string> _provinces=[];private readonly HashSet<Guid> _structureIds=[];private readonly HashSet<Guid> _excludedSensors=[];private readonly HashSet<string> _operations=["view"];
    private bool _interactiveReady;
    protected override void OnAfterRender(bool firstRender){if(firstRender){_interactiveReady=true;StateHasChanged();}}
    private bool _loading=true,_saving;private string? _error,_message;
    private bool SelectedAdmin=>_users.Any(u=>u.UserId==_selectedId&&u.IsPanelAdmin);
    private static readonly (string Key,string Label,string Description)[] Operations=[("view","Görüntüleme","Yapılar, sensörler ve sağlık görünümü"),("live","Canlı İzleme","3D sensör akışı, grafikler ve kameralar"),("reports","Raporlama","Geçmiş ölçümler ve tarih aralığı sorguları"),("alarms","Alarm Yönetimi","Alarm kayıtları ve incelemeleri"),("users","Kullanıcı Yönetimi","Mevcut platform yöneticisi yetkisi gerekir")];
    private string Preview=>_level switch{1=>"Türkiye haritası ve yetkili yapılar",2=>"Bölgeye bağlı illerin haritası",3=>"Atanmış ilin haritası",_=>_structureIds.Count==1?"Doğrudan seçili yapının 3D canlı izleme ekranı":"Yalnız atanmış yapıların özet kartları"};
    protected override Task OnInitializedAsync()=>LoadAsync();
    private async Task LoadAsync(){_loading=true;_error=null;try{_regions=await Clients.CreateClient("timeseries-api").GetFromJsonAsync<List<DeYas.Contracts.DsiRegionInfo>>("api/dsi-regions")??[];_users=await Clients.CreateClient("auth-api").GetFromJsonAsync<List<UserOption>>("api/auth/users")??[];_structures=await Clients.CreateClient("timeseries-api").GetFromJsonAsync<List<StructureOption>>("api/structures")??[];_sensors=await Clients.CreateClient("timeseries-api").GetFromJsonAsync<List<SensorOption>>("api/sensors")??[];}catch{_error="Yetki verileri yüklenemedi. Yeniden deneyin.";}finally{_loading=false;}}
    private async Task SelectUser(string id){_saving=true;_selectedId=id;_message=null;_error=null;try{var profile=await Clients.CreateClient("auth-api").GetFromJsonAsync<MonitoringAccess>($"api/monitoring-access?userId={Uri.EscapeDataString(id)}");if(profile is null)return;_level=profile.Level;_regionName=profile.RegionName;_provinces.Clear();_provinces.UnionWith(profile.Provinces);_structureIds.Clear();_structureIds.UnionWith(profile.StructureIds);_excludedSensors.Clear();_excludedSensors.UnionWith(profile.ExcludedSensorIds??[]);_operations.Clear();_operations.UnionWith(profile.Operations);_operations.Add("view");}catch{_error="Kullanıcı kapsamı okunamadı.";}finally{_saving=false;}}
    private bool ProvinceSelected(string province)=>_level==1||_level is 2 or 3&&_provinces.Contains(province)||_level==4&&_structures.Where(s=>s.Province==province).All(s=>_structureIds.Contains(s.Id));
    private bool StructureSelected(StructureOption s)=>_level==1||_level is 2 or 3&&_provinces.Contains(s.Province)||_level==4&&_structureIds.Contains(s.Id);
    private void LevelChanged(){_provinces.Clear();_structureIds.Clear();_excludedSensors.Clear();}
    private IEnumerable<string> SelectableProvinces=>_level==2&&SelectedRegion is {} r?r.Provinces:_structures.Select(s=>s.Province).Where(p=>!string.IsNullOrWhiteSpace(p)).Distinct();
    private void ToggleRegion(ChangeEventArgs e){_provinces.Clear();if(e.Value is true)_provinces.UnionWith(SelectableProvinces);}
    private void ToggleSensor(Guid id,bool selected){if(selected)_excludedSensors.Remove(id);else _excludedSensors.Add(id);}
    private void ToggleProvince(string province,bool selected){if(_level==4){foreach(var s in _structures.Where(s=>s.Province==province))ToggleStructure(s.Id,selected);}else{if(_level==3)_provinces.Clear();if(selected)_provinces.Add(province);else _provinces.Remove(province);}}
    private void ToggleStructure(Guid id,bool selected){if(selected)_structureIds.Add(id);else _structureIds.Remove(id);}
    private void ToggleOperation(string key,bool selected){if(selected)_operations.Add(key);else _operations.Remove(key);}
    private void SelectAll(){_excludedSensors.Clear();if(_level==4)_structureIds.UnionWith(_structures.Select(s=>s.Id));if(_level==2)_provinces.UnionWith(SelectableProvinces);}
    private async Task SaveAsync(){
        _provinces.RemoveWhere(string.IsNullOrWhiteSpace);
        if(_level==2&&(string.IsNullOrWhiteSpace(_regionName)||_provinces.Count==0)){_message=null;_error="Seviye 2 için bölge müdürlüğü adı ve en az bir il seçin. İl listesi boşsa önce yapıların il bilgisini kaydedin.";return;}
        if(_level==3&&_provinces.Count!=1){_message=null;_error="Seviye 3 için il bilgisi tanımlı tam bir il seçin.";return;}
        _saving=true;_error=null;_message=null;try{var response=await Clients.CreateClient("auth-api").PutAsJsonAsync($"api/monitoring-access/{Uri.EscapeDataString(_selectedId)}",new MonitoringAccess(_level,_regionName,_provinces.ToArray(),_structureIds.ToArray(),_operations.ToArray(),_excludedSensors.Where(id=>_structures.Where(StructureSelected).Any(s=>s.SensorIds.Contains(id))).ToArray()));if(!response.IsSuccessStatusCode){_error=await response.Content.ReadAsStringAsync();return;}_message="Rol, erişim kapsamı ve işlem izinleri kaydedildi. Açık oturumların kapsamı bir sonraki yenilemede güncellenir.";}catch{_error="Kaydetme işlemi tamamlanamadı. Yeniden deneyin.";}finally{_saving=false;}}
    private sealed record UserOption(string UserId,string UserName,string? OrganizationName,string Role,bool IsPanelAdmin);
    private sealed record StructureOption(Guid Id,string Name,string Province,List<Guid> SensorIds);
    private sealed record SensorOption(Guid Id,string Name);
}
