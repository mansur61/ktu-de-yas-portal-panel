@page "/sensor-setup"
@rendermode InteractiveServer
@inject SensorDashboardUseCases DashboardUC
@inject ILogger<SensorSetup> Logger

<PageTitle>Sensör Kurulum Durumu</PageTitle>

<div class="dy-heading"><div><div class="dy-eyebrow">Baraj ve Sensör Yönetimi</div><h1>Bağlantı ve kurulum kontrolü</h1><p>Kaydı, cihaz bağlantısını ve örnek ölçümü ayrı ayrı kontrol edin.</p></div><a class="btn btn-outline-secondary" href="structures">Barajlara dön</a></div>
<div class="dy-guide"><h2>Bir sensörün kaydedilmiş olması çalıştığı anlamına gelmez</h2><p>Önce bağlantıyı, ardından veri okumasını ve örnek ölçümü doğrulayın. Veri toplama baraj ekranından ayrıca başlatılır.</p></div>
@if (_error is not null) { <div class="alert alert-warning" role="alert">@_error</div> }

@if (_loading)
{
    <div class="spinner-border spinner-border-sm text-muted my-3"></div>
}
else if (_structures.Count == 0)
{
    <div class="alert alert-info">Önce bir yapı ve sensör tanımlayın.</div>
}
else
{
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2 d-flex flex-wrap align-items-center gap-2">
            <span class="fw-semibold">Yapı:</span>
            @foreach (var structure in _structures.Take(10))
            {
                <button class="btn btn-sm @(_selectedStructureId == structure.Id ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => SelectStructureAsync(structure.Id)">
                    @structure.Name <span class="badge bg-white text-dark ms-1">@structure.SensorCount</span>
                </button>
            }
            @if (_structures.Count > 10)
            {
                <select class="form-select form-select-sm" style="width:260px" value="@_selectedStructureId" @onchange="OnStructureChanged">
                    <option value="">Diğer yapıyı seç…</option>
                    @foreach (var structure in _structures.Skip(10))
                    {
                        <option value="@structure.Id">@structure.Name (@structure.SensorCount sensör)</option>
                    }
                </select>
            }
            <button class="btn btn-sm btn-outline-secondary ms-auto" disabled="@_readinessLoading" @onclick="LoadReadinessAsync">
                <span class="bi bi-arrow-clockwise me-1"></span>Yenile
            </button>
        </div>
    </div>

    @if (_selectedStructure is not null)
    {
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
            <span class="text-muted small">Sensör:</span>
            <button class="btn btn-sm @(_selectedSensorId is null ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SelectSensor(null)">
                Tümü <span class="badge bg-white text-dark ms-1">@_sensors.Count</span>
            </button>
            @foreach (var sensor in _sensors.Take(10))
            {
                <button class="btn btn-sm @(_selectedSensorId == sensor.SensorId ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SelectSensor(sensor.SensorId)">@sensor.Name</button>
            }
            @if (_sensors.Count > 10)
            {
                <select class="form-select form-select-sm" style="width:280px" value="@(_selectedSensorId?.ToString() ?? string.Empty)" @onchange="OnSensorChanged">
                    <option value="">Diğer sensörü seç…</option>
                    @foreach (var sensor in _sensors.Skip(10))
                    {
                        <option value="@sensor.SensorId">@sensor.Name</option>
                    }
                </select>
            }
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-warning">@_error</div>
        }
        <div class="table-responsive card">
            <table class="table mb-0"><thead><tr><th>Sensör</th><th>Kaydı</th><th>Bağlantı</th><th>Veri okuma</th><th>Örnek ölçüm</th><th>İşlem</th></tr></thead><tbody>
            @foreach (var sensor in VisibleSensors) {
                var ready = _readiness.GetValueOrDefault(sensor.SensorId);
                var isTcp = sensor.SourceKind.Equals("tcp", StringComparison.OrdinalIgnoreCase)
                            || (string.IsNullOrEmpty(sensor.SourceKind)
                                && (!string.IsNullOrWhiteSpace(sensor.IpAddress) && sensor.Port.HasValue));
                <tr><td><strong>@sensor.Name</strong><details><summary class="dy-subtle">Teknik bilgiler</summary><small>@GetSourceType(sensor) · @GetEndpoint(sensor)<br />@sensor.DeviceId</small></details></td>
                <td><span class="dy-chip neutral">Kaydedildi</span><small class="d-block">@(ready is null ? "Çalışma durumu alınamadı" : LifecycleLabel(ready.LifecycleStatus))</small></td>
                @if (isTcp) {
                    <td>@(ready is null ? "Bilinmiyor" : ready.ConnectionValid ? "✓ Doğrulandı" : "○ Kontrol gerekiyor")</td>
                    <td>@(ready is null ? "Bilinmiyor" : ready.ParserValid ? "✓ Okunabiliyor" : "○ Doğrulanmadı")</td>
                    <td>@(ready is null ? "Bilinmiyor" : ready.MetricPreviewValid ? "✓ Kontrol edildi" : "○ Kontrol gerekiyor")</td>
                    <td><div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-sm btn-outline-primary" disabled="@(_activeSensorId is not null || _readinessLoading)" @onclick="() => RunConnectionTestAsync(sensor)">1. Bağlantıyı kontrol et</button>
                        <button class="btn btn-sm btn-outline-primary" disabled="@(_activeSensorId is not null || ready?.ConnectionValid != true)" @onclick="() => RunParserValidationAsync(sensor)">2. Veriyi doğrula</button>
                        <button class="btn btn-sm btn-outline-primary" disabled="@(_activeSensorId is not null || ready?.ParserValid != true)" @onclick="() => GenerateMetricPreviewAsync(sensor)">3. Ölçümü kontrol et</button>
                    </div></td>
                } else {
                    <td colspan="3"><span class="dy-chip neutral">Push — cihaz veri gönderir</span></td>
                    <td><a href="sensor-dashboard" class="btn btn-sm btn-outline-secondary">Ölçümleri izle</a><small class="d-block text-muted mt-1">UDP/MQTT kaynağı. Bağlantı testi uygulanamaz; gelen veriyi izleme ekranından doğrulayın.</small></td>
                }
                </tr>
            }
            </tbody></table>
            @if (!VisibleSensors.Any()) { <div class="dy-empty"><p>Bu barajda kayıtlı sensör yok. Barajlar ve saha kurulumu ekranından ekleyin.</p></div> }
        </div>
    }
}

@code {
    private List<Structure> _structures = [];
    private Structure? _selectedStructure;
    private List<StructureSensor> _sensors = [];
    private Dictionary<Guid, SensorReadinessDto> _readiness = [];
    private Guid _selectedStructureId;
    private Guid? _selectedSensorId;
    private bool _loading = true;
    private bool _readinessLoading;
    private string? _error;
    private Guid? _activeSensorId;
    private string _activeStep = string.Empty;

    private IEnumerable<StructureSensor> VisibleSensors => _selectedSensorId is Guid id
        ? _sensors.Where(sensor => sensor.SensorId == id) : _sensors;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _structures = await DashboardUC.GetAllStructuresAsync();
            if (_structures.Count > 0) await SelectStructureAsync(_structures[0].Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sensor setup page could not load structures.");
            _error = "Baraj listesi alınamadı. Bağlantıyı kontrol edip sayfayı yeniden yükleyin.";
        }
        finally { _loading = false; }
    }

    private async Task SelectStructureAsync(Guid id)
    {
        _selectedStructureId = id;
        _selectedSensorId = null;
        _selectedStructure = await DashboardUC.GetStructureByIdAsync(id);
        _sensors = _selectedStructure?.Sensors.Where(sensor => sensor.IsActive).OrderBy(sensor => sensor.SensorOrder).ToList() ?? [];
        await LoadReadinessAsync();
    }

    private async Task LoadReadinessAsync()
    {
        _readinessLoading = true;
        _error = null;
        try
        {
            var results = await Task.WhenAll(_sensors.Select(async sensor =>
            {
                try { return (sensor.SensorId, Data: await DashboardUC.GetSensorReadinessAsync(sensor.SensorId)); }
                catch { return (sensor.SensorId, Data: (SensorReadinessDto?)null); }
            }));
            _readiness = results.Where(result => result.Data is not null).ToDictionary(result => result.SensorId, result => result.Data!);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sensor readiness could not be loaded for structure {StructureId}", _selectedStructureId);
            _error = "Kurulum bilgisi alınamadı. Yenile düğmesiyle tekrar deneyin.";
        }
        finally { _readinessLoading = false; }
    }

    private Task OnStructureChanged(ChangeEventArgs args) => Guid.TryParse(args.Value?.ToString(), out var id) ? SelectStructureAsync(id) : Task.CompletedTask;
    private void OnSensorChanged(ChangeEventArgs args) => SelectSensor(Guid.TryParse(args.Value?.ToString(), out var id) ? id : null);
    private void SelectSensor(Guid? id) => _selectedSensorId = id;
    private static string LifecycleLabel(string status) => status switch {
        "Running" => "Veri toplama çalışıyor", "Reconnecting" => "Bağlantı yeniden kuruluyor", "Ready" => "Başlatmaya hazır",
        "Stopped" => "Veri toplama durduruldu", "ConnectionFailed" => "Bağlantı başarısız", _ => "Kurulum kontrolü gerekiyor"
    };
    private static string StatusMark(bool? success) => success == true ? "✓" : success == false ? "✗" : "?";
    private static string GetSourceType(StructureSensor sensor) =>
        sensor.ProtocolType.Contains("tcp", StringComparison.OrdinalIgnoreCase) || sensor.ProtocolType.Contains("modbus", StringComparison.OrdinalIgnoreCase) ? "TCP" :
        sensor.ProtocolType.Equals("UDP", StringComparison.OrdinalIgnoreCase) ? "UDP" : "MQTT";
    private static string GetEndpoint(StructureSensor sensor) => !string.IsNullOrWhiteSpace(sensor.IpAddress) && sensor.Port.HasValue
        ? $"{sensor.IpAddress}:{sensor.Port}" : (string.IsNullOrWhiteSpace(sensor.Topic) ? "—" : sensor.Topic);

    private async Task RunConnectionTestAsync(StructureSensor sensor)
    {
        await RunStepAsync(sensor.SensorId, "conn", () => DashboardUC.TestConnectionLifecycleAsync(sensor.SensorId, new ConnectionTestRequestDto
        {
            IpAddress = sensor.IpAddress, Port = sensor.Port, TimeoutMs = sensor.TimeoutMs ?? 5000,
            Profile = string.IsNullOrWhiteSpace(sensor.ProtocolType) ? "Unknown" : sensor.ProtocolType,
            Encoding = string.IsNullOrWhiteSpace(sensor.Encoding) ? "utf-8" : sensor.Encoding
        }), "Bağlantı testi");
    }

    private async Task RunParserValidationAsync(StructureSensor sensor)
    {
        await RunStepAsync(sensor.SensorId, "parser", () => DashboardUC.ValidateParserAsync(sensor.SensorId, new ParserValidationRequestDto
        {
            IpAddress = sensor.IpAddress, Port = sensor.Port, TimeoutMs = sensor.TimeoutMs ?? 5000,
            Profile = string.IsNullOrWhiteSpace(sensor.ProtocolType) ? "Unknown" : sensor.ProtocolType,
            Encoding = string.IsNullOrWhiteSpace(sensor.Encoding) ? "utf-8" : sensor.Encoding
        }), "Veri okuma kontrolü");
    }

    private async Task GenerateMetricPreviewAsync(StructureSensor sensor)
    {
        var metrics = (sensor.Metrics ?? string.Empty).Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .Select(metric => new MetricPreviewInputDto { MetricCode = metric }).ToList();
        if (metrics.Count == 0) metrics.Add(new MetricPreviewInputDto { MetricCode = "value" });
        await RunStepAsync(sensor.SensorId, "metric", () => DashboardUC.GenerateMetricPreviewAsync(sensor.SensorId, new GenerateMetricPreviewRequestDto
        {
            ParserProfile = sensor.ProtocolType, Metrics = metrics
        }), "Örnek ölçüm kontrolü");
    }

    private async Task RunStepAsync<T>(Guid sensorId, string step, Func<Task<T>> action, string operation)
    {
        _error = null;
        _activeSensorId = sensorId;
        _activeStep = step;
        try { await action(); await LoadReadinessAsync(); }
        catch (Exception ex) { _error = $"{operation} başarısız: {ex.Message}"; }
        finally { _activeSensorId = null; _activeStep = string.Empty; }
    }
}
