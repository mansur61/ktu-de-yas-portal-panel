    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadStructuresAsync();

        // Operasyon haritasından gelen query string parametreleri
        var uri = new Uri(Nav.Uri);
        var qs  = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (qs.TryGetValue("openWizard", out var ow) && ow == "1")
        {
            if (qs.TryGetValue("newLat", out var latStr) && double.TryParse(latStr, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lat))
                _newLat = lat;
            if (qs.TryGetValue("newLng", out var lngStr) && double.TryParse(lngStr, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lng))
                _newLng = lng;
            if (qs.TryGetValue("province", out var prov) && !string.IsNullOrWhiteSpace(prov))
            {
                // Nominatim'den gelen il adını listedekiyle eşleştir (büyük/küçük harf, suffix temizle)
                var raw = prov.ToString()
                    .Replace(" İli", "").Replace(" ili", "")
                    .Replace(" Province", "").Replace(" province", "")
                    .Trim();
                // Önce tam eşleşme dene, sonra büyük/küçük harf duyarsız
                _newProvince = _provinces.FirstOrDefault(p =>
                    string.Equals(p, raw, StringComparison.OrdinalIgnoreCase)) ?? raw;
                _newDistricts = _districtMap.TryGetValue(_newProvince, out var d) ? d.ToList() : [];
            }
            if (qs.TryGetValue("district", out var dist) && !string.IsNullOrWhiteSpace(dist))
            {
                var rawDist = dist.ToString()
                    .Replace(" İlçesi", "").Replace(" ilçesi", "")
                    .Replace(" District", "").Replace(" district", "")
                    .Trim();
                _newDistrict = _newDistricts.FirstOrDefault(d =>
                    string.Equals(d, rawDist, StringComparison.OrdinalIgnoreCase)) ?? rawDist;
            }
            ShowCreateWizard();
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _timerCts   = new CancellationTokenSource();
            _clickTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(400));
            _ = PollClicksAsync(_timerCts.Token);
        }

        // Wizard adım 2 — harita DOM'a gelince init et
        if (_showCreateWizard && _wizardStep == 2 && !_mapInitialized)
        {
            _mapInitialized = true;
            try
            {
                await JS.InvokeVoidAsync("initMap", "new-map", _newLat, _newLng);
                if (!string.IsNullOrEmpty(_newProvince))
                    await JS.InvokeVoidAsync("panToProvince", _newProvince);
            }
            catch { }
        }
        // Wizard adım 2 dışında harita flag'ini sıfırla
        else if (!(_showCreateWizard && _wizardStep == 2))
        {
            _mapInitialized = false;
        }

        // Wizard adım 4 (arayüzde 3. adım) — yapı resmi DOM'a gelince init et.
        if (_showCreateWizard && _wizardStep == 4 && !_wizardImageInitialized && _newType.HasValue)
        {
            _wizardImageInitialized = true;
            try
            {
                var imgPath = _structureTypes[_newType.Value].ImagePath;
                var markers = _newStructureSensors.Select(s => new {
                    id = s.Id.ToString(), deviceId = s.DeviceId,
                    name = s.Name, sensorType = s.SensorType.ToString(),
                    unit = s.Unit, topic = s.Topic,
                    imagePositionX = s.ImagePositionX, imagePositionY = s.ImagePositionY,
                    status = "Offline",
                    lastValue = (double?)null,
                    lastUpdated = (DateTime?)null, alertMessage = (string?)null
                }).ToList();
                await JS.InvokeVoidAsync("initStructureImage", "wizard-image", imgPath, markers);
            }
            catch { }
        }
        else if (!(_showCreateWizard && _wizardStep == 4))
        {
            _wizardImageInitialized = false;
        }

        // Yapı detayı — resmi init et
        if (_editingStructure != null && !_detailImageInitialized)
        {
            _detailImageInitialized = true;
            await RenderStructureImageAsync();
        }
        else if (_editingStructure == null)
        {
            _detailImageInitialized = false;
        }
    }

    private async Task PollClicksAsync(CancellationToken ct)
    {
        while (await _clickTimer!.WaitForNextTickAsync(ct))
        {
            // Node-RED'de cihaz durdurulduğunda Edge state dosyası değişir.
            // Kartlar sayfa yenilemeden kısa sürede aktif/pasif sayısını günceller.
            if (_editingStructure is null && _structures is not null &&
                DateTimeOffset.UtcNow - _lastEdgeLifecycleRefreshAt >= TimeSpan.FromSeconds(5))
            {
                _lastEdgeLifecycleRefreshAt = DateTimeOffset.UtcNow;
                await InvokeAsync(async () =>
                {
                    await LoadEdgeLifecycleStatesAsync();
                    StateHasChanged();
                });
            }
            if(_showCreateWizard&&_wizardStep==4&&!_showSensorPopup&&!_setupSaving&&DateTime.UtcNow-_lastSensorRefresh>TimeSpan.FromSeconds(10)) {
                _lastSensorRefresh=DateTime.UtcNow;
                await InvokeAsync(async()=>{try{await RefreshDiscoveredSensorsAsync();StateHasChanged();}catch{_setupNotice="Sensör listesi yenilenemedi; yeniden deneyin.";}});
            }
            // Mevcut yapı detay sayfasında sensör ekle
            if (_editingStructure != null && !_showSensorPopup)
                await InvokeAsync(CheckPendingClickAsync);
            // Wizard adım 3'te sensör ekle
            else if (_showCreateWizard && _wizardStep == 4 && !_showSensorPopup)
                await InvokeAsync(CheckWizardPendingClickAsync);
        }
    }

    // ── Data ──────────────────────────────────────────────────────────────────
    private async Task LoadStructuresAsync()
    {
        try
        {
            _structures = (await StructureUC.GetAllAsync()).OrderByDescending(s => s.CreatedAt).ToList();
        }
        catch (Exception ex)
        {
            _structures = new();
            _simulationErrorMessage = $"Yapılar merkez API'den alınamadı: {ex.Message}";
            return;
        }

        // Liste ucu kart özetlerini (SensorCount/SensorTypeCounts) döndürür;
        // cihaz bazlı Edge durumu için ise DeviceId içeren ilişki listesi gerekir.
        // Sadece Edge'i tanımlı sahaların detayını alıyoruz.
        await LoadStructureSensorDetailsAsync();
        _telemetryRunningStructureIds.Clear();

        // Merkez TimescaleDB'ye son iki dakika içinde veri yazılmışsa yapı
        // gerçekten çalışıyordur. UI lifecycle state'ine değil canlı kayda bakar.
        var since = DateTime.UtcNow.AddMinutes(-2);
        foreach (var structure in _structures)
        {
            try
            {
                var rows = await TimeseriesRepo.QueryAsync(
                    deviceId: null,
                    locationId: null,
                    from: since,
                    to: DateTime.UtcNow,
                    limit: 1,
                    structureId: structure.Id.ToString());
                if (rows.Count > 0)
                    _telemetryRunningStructureIds.Add(structure.Id);
            }
            catch
            {
                // DB durum sorgusundaki geçici hata yapı yönetimini engellemez.
            }
        }

        await LoadEdgeLifecycleStatesAsync();
    }

    private async Task LoadStructureSensorDetailsAsync()
    {
        if (_structures is null)
            return;

        var edgeStructures = _structures
            .Where(structure => !string.IsNullOrWhiteSpace(structure.EdgeApiUrl))
            .ToList();
        var semaphore = new SemaphoreSlim(12);
        var details = edgeStructures.Select(async structure =>
        {
            await semaphore.WaitAsync();
            try { return (structure.Id, Detail: await StructureUC.GetByIdAsync(structure.Id)); }
            catch { return (structure.Id, Detail: (Structure?)null); }
            finally { semaphore.Release(); }
        });

        foreach (var result in await Task.WhenAll(details))
        {
            if (result.Detail is null)
                continue;

            var structure = _structures.FirstOrDefault(item => item.Id == result.Id);
            if (structure is null)
                continue;

            structure.Sensors = result.Detail.Sensors;
        }
    }

    private async Task LoadEdgeLifecycleStatesAsync()
    {
        _forwardingStates.Clear();
        _localPipelineStates.Clear();
        _deviceLifecycleStates.Clear();
        var edgeStructures = _structures
            .Where(structure => !string.IsNullOrWhiteSpace(structure.EdgeApiUrl))
            .ToList();
        var semaphore = new SemaphoreSlim(12);
        var checks = edgeStructures.Select(async structure =>
        {
            await semaphore.WaitAsync();
            try
            {
                var state = await StructureSimClient.GetStateAsync(structure.EdgeApiUrl!, structure.Id);
                return (structure.Id, State: state, Success: true);
            }
            catch
            {
                // Bir sahanın erişilememesi diğer kartları etkilemez.
                return (structure.Id, State: (EdgeLifecycleState?)null, Success: false);
            }
            finally { semaphore.Release(); }
        });

        foreach (var result in await Task.WhenAll(checks))
        {
            if (result.Success && result.State is not null)
            {
                _forwardingStates[result.Id] = result.State.ForwardingEnabled;
                _localPipelineStates[result.Id] = result.State.LocalPipelinesEnabled;
                _deviceLifecycleStates[result.Id] = result.State.DeviceStates;
            }
        }
    }

    private bool IsLocalPipelineEnabled(Guid structureId) =>
        _localPipelineStates.TryGetValue(structureId, out var enabled) && enabled;

    private sealed record DeviceRuntimeSummary(string Label, int Active, int Passive);

    private IEnumerable<DeviceRuntimeSummary> GetDeviceRuntimeSummary(Structure structure)
    {
        if (!_deviceLifecycleStates.TryGetValue(structure.Id, out var states) || structure.Sensors.Count == 0)
            return Array.Empty<DeviceRuntimeSummary>();

        // Yapı bazlı Durdur, Edge Layer'ın ortak local pipeline gate'ini kapatır.
        // Bu durumda Node-RED'deki cihaz satırları ve tekil durumları korunur;
        // fakat kartta tüm kayıtlı cihazların etkin durumu pasif gösterilmelidir.
        var structureRuntimeEnabled = !_localPipelineStates.TryGetValue(structure.Id, out var localEnabled) || localEnabled;

        return structure.Sensors
            .Where(sensor => sensor.IsActive && !string.IsNullOrWhiteSpace(sensor.DeviceId))
            .GroupBy(sensor => string.IsNullOrWhiteSpace(sensor.SensorType) ? "Sensor" : sensor.SensorType,
                StringComparer.OrdinalIgnoreCase)
            .Select(group =>
            {
                var passive = structureRuntimeEnabled
                    ? group.Count(sensor => states.TryGetValue(sensor.DeviceId, out var state) && !state.RuntimeEnabled)
                    : group.Count();
                return new DeviceRuntimeSummary(GetSensorTypeLabel(group.Key), group.Count() - passive, passive);
            })
            .OrderBy(summary => summary.Label);
    }

    private void SetStatus(string message, string level)
    {
        _simulationStatusMessage = message;
        (_simulationStatusAlertClass, _simulationStatusIcon) = level switch
        {
            "stopped" => ("alert-danger", "bi-stop-circle"),
            "info" => ("alert-info", "bi-info-circle"),
            _ => ("alert-success", "bi-play-circle")
        };
    }

    private static IEnumerable<string> GetSensorTypeSummary(Structure structure) =>
        structure.SensorTypeCounts
            .Where(x => x.Value > 0)
            .OrderBy(x => SensorTypeDisplayOrder(x.Key))
            .ThenBy(x => x.Key)
            .Select(x => $"{x.Value} {GetSensorTypeLabel(x.Key)}");

    private static int SensorTypeDisplayOrder(string sensorType) => sensorType.ToLowerInvariant() switch
    {
        "vibration" or "accelerometer" or "acceleration" => 0,
        "camera" or "video" => 1,
        "lidar" => 2,
        _ => 10
    };

    private static string GetSensorTypeLabel(string sensorType) => sensorType.ToLowerInvariant() switch
    {
        "vibration" => "Titreşim",
        "accelerometer" or "acceleration" => "İvmeölçer",
        "camera" or "video" => "Kamera",
        "lidar" => "Lidar / mesafe",
        "strain" => "Gerinim", "tilt" => "Eğim", "temperature" => "Sıcaklık",
        "pressure" => "Basınç", "humidity" => "Nem", "ultrasonic" => "Ultrasonik mesafe",
        "water" => "Su seviyesi", "wind" => "Rüzgâr", "gps" => "Konum (GPS)",
        "image" => "Görüntü", "generic" => "Diğer ölçüm",
        _ => sensorType
    };

    private async Task StartStructureSimulationAsync(Guid structureId)
    {
        if (_startingStructureIds.Contains(structureId))
            return;

        _simulationErrorMessage = null;
        _simulationStatusMessage = null;

        var structure = _structures?.FirstOrDefault(s => s.Id == structureId);
        if (structure == null)
        {
            _simulationErrorMessage = "Yapı bulunamadı; simülasyon başlatılamadı.";
            return;
        }

        if (structure.SensorCount == 0)
        {
            _simulationErrorMessage = $"{structure.Name} için sensör tanımlı değil; yapı çalıştırılamaz.";
            return;
        }

        _startingStructureIds.Add(structureId);
        var structureName = structure.Name;

        try
        {
            if (string.IsNullOrWhiteSpace(structure.EdgeApiUrl))
            {
                _simulationErrorMessage = $"{structure.Name} için saha Edge URL tanımlı değil.";
                return;
            }

            await StructureSimClient.StartAsync(structure.EdgeApiUrl, structure.Id);
            SetStatus($"{structureName} için saha yerel akışı çalıştırıldı.", "started");

            _runningStructureIds.Add(structureId);
            _localPipelineStates[structureId] = true;
        }
        catch (Exception ex)
        {
            _simulationErrorMessage = $"Simülasyon başlatılamadı: {ex.Message}";
        }
        finally
        {
            _startingStructureIds.Remove(structureId);
        }
    }

    private async Task StopStructureSimulationAsync(Guid structureId)
    {
        if (_stoppingStructureIds.Contains(structureId))
            return;

        _simulationErrorMessage  = null;
        _simulationStatusMessage = null;
        _stoppingStructureIds.Add(structureId);

        try
        {
            var structure = _structures?.FirstOrDefault(s => s.Id == structureId);
            if (string.IsNullOrWhiteSpace(structure?.EdgeApiUrl))
            {
                _simulationErrorMessage = $"{structure?.Name ?? "Yapı"} için saha Edge URL tanımlı değil.";
                return;
            }
            await StructureSimClient.StopAsync(structure.EdgeApiUrl, structureId);
            SetStatus($"{structure.Name} için saha yerel akışı durduruldu.", "stopped");
            _runningStructureIds.Remove(structureId);
            _localPipelineStates[structureId] = false;
        }
        catch (Exception ex)
        {
            _simulationErrorMessage = $"Simülasyon durdurulamadı: {ex.Message}";
        }
        finally
        {
            _stoppingStructureIds.Remove(structureId);
        }
    }

    private async Task SetStructureForwardingAsync(Guid structureId, bool enabled)
    {
        var structure = _structures?.FirstOrDefault(s => s.Id == structureId);
        if (string.IsNullOrWhiteSpace(structure?.EdgeApiUrl))
        {
            _simulationErrorMessage = $"{structure?.Name ?? "Yapı"} için saha Edge URL tanımlı değil.";
            return;
        }

        try
        {
            await StructureSimClient.SetForwardingAsync(structure.EdgeApiUrl, structureId, enabled);
            _forwardingStates[structureId] = enabled;
            SetStatus($"{structure.Name} için merkeze aktarım {(enabled ? "açıldı" : "durduruldu")}. Yerel saha akışı değişmedi.", "info");
        }
        catch (Exception ex)
        {
            _simulationErrorMessage = $"Merkeze aktarım değiştirilemedi: {ex.Message}";
        }
    }

    /// <summary>
    /// Yapıya özgü Node-RED dashboard ekranını (/ui) yeni sekmede açar.
    /// Flow editörü değil, canlı deploy (dashboard) görünümü açılır.
    /// Öncelik: structures.node_red_url (DB) → NodeRed:PerStructureUrls:{type} (config) → NodeRed:BaseUrl (fallback).
    /// </summary>
    private async Task OpenNodeRedAsync(Guid structureId, string structureName)
    {
        var structure = _structures?.FirstOrDefault(s => s.Id == structureId);

        // Yapıya özgü base URL — DB > config per-type > merkez fallback
        string baseUrl;
        if (!string.IsNullOrWhiteSpace(structure?.NodeRedUrl))
        {
            baseUrl = structure.NodeRedUrl.TrimEnd('/');
        }
        else if (structure?.StructureType is not null)
        {
            var perType = Configuration[$"NodeRed:PerStructureUrls:{structure.StructureType}"];
            baseUrl = !string.IsNullOrWhiteSpace(perType)
                ? perType.TrimEnd('/')
                : (Configuration["NodeRed:BaseUrl"] ?? "http://localhost:1880").TrimEnd('/');
        }
        else
        {
            baseUrl = (Configuration["NodeRed:BaseUrl"] ?? "http://localhost:1880").TrimEnd('/');
        }

        // #flow/tab-platform-pipeline → editör açılır ve doğrudan canlı akış tab'ına atlar.
        // Bu tab ID tüm per-structure instance'larda (baraj, köprü, ...) aynıdır.
        var url = baseUrl + "/#flow/tab-platform-pipeline";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    /// <summary>
    /// Merkez Node-RED dashboard ekranını (/ui) açar — tüm yapıların canlı akışını gösterir.
    /// </summary>
    private async Task OpenCentralNodeRedAsync()
    {
        var baseUrl = (Configuration["NodeRed:CentralUrl"]
                    ?? Configuration["NodeRed:BaseUrl"]
                    ?? "http://localhost:1880").TrimEnd('/');

        // Merkez instance'ın ana pipeline tab'ı: tab-monitor
        var url = baseUrl + "/api/ui/#flow/tab-monitor";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

