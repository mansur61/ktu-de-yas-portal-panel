@page "/structures"
@using Microsoft.AspNetCore.Authorization
@using DeYas.Contracts.Authorization
@attribute [Authorize]
@inject PanelAccess SetupAccess
@rendermode InteractiveServer
@using KtuDeYasPortal.Panel.Components.Shared
@using DeYas.Contracts.Sensors
@using DeYas.Contracts.Simulation
@using DeYas.Contracts.Integration
@inject StructureUseCases StructureUC
@inject IStructureSimulationClient StructureSimClient
@inject ITimeseriesRepository TimeseriesRepo
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Baraj Yönetimi</PageTitle>

<style>
    .site-env-group {
        border: 2px solid #9aa7b5 !important;
        box-shadow: 0 .125rem .35rem rgba(31, 41, 55, .08);
        overflow: hidden;
    }

    .site-env-group-header {
        background: #f3f6f9;
        border-bottom: 1px solid #c8d0d9;
    }

    .site-env-group-header button {
        color: #263746;
        text-decoration: none;
    }

    .site-env-group .form-control,
    .site-env-group .form-select,
    .site-env-group .input-group-text {
        border-color: #8795a5;
        border-width: 2px;
    }
</style>

@* ══════════════════════════════════════════════════════════════════
   ANA SAYFA — Liste + Başlık
   ══════════════════════════════════════════════════════════════════ *@
@if (_editingStructure == null && !_showCreateWizard)
{
    @if (!string.IsNullOrWhiteSpace(_simulationStatusMessage))
    {
        <div class="alert @_simulationStatusAlertClass d-flex align-items-center gap-2 mb-3 py-2">
            <span class="bi @_simulationStatusIcon"></span>
            <div>@_simulationStatusMessage</div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_simulationErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2">
            <span class="bi bi-exclamation-triangle"></span>
            <div>@_simulationErrorMessage</div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="dy-eyebrow">Baraj ve Sensör Yönetimi</div><h1 class="mb-2">Barajlar ve saha kurulumu</h1>
            <small class="text-muted">Barajı tanımlayın, sensörleri ekleyin ve sahaya götürülecek paketi hazırlayın.</small>
        </div>
        <div class="d-flex gap-2 align-items-center">

            <button class="btn btn-primary" @onclick="ShowCreateWizard">
                <span class="bi bi-plus-lg me-1"></span> Yeni Baraj
            </button>
        </div>
    </div>

    @if (_structures is null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Yükleniyor…</p>
        </div>
    }
    else if (_structures.Count == 0)
    {
        <div class="alert alert-info d-flex align-items-center gap-3">
            <span class="bi bi-info-circle-fill fs-4"></span>
            <div>Henüz baraj tanımlanmamış. <strong>Yeni Baraj</strong> butonuyla ekleyebilirsiniz.</div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var s in _structures)
            {
                <div class="col-sm-6 col-xl-4">
                    <div class="structure-card @(s.IsActive ? "" : "opacity-60")" @onclick="() => OpenStructureDetail(s.Id)">
                        <img src="@(!string.IsNullOrEmpty(s.ImageUrl) ? s.ImageUrl : GetStructureImagePath(s.StructureType))"
                             class="structure-card-img" alt="@s.Name"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                        <div class="structure-card-img-placeholder" style="display:none">
                            <span>@GetStructureEmoji(s.StructureType)</span>
                        </div>
                        <div class="structure-card-body">
                            <div class="structure-card-title">@s.Name</div>

                            <div class="structure-card-sub">
                                <span class="bi bi-geo-alt me-1"></span>
                                @s.Province@(string.IsNullOrEmpty(s.District) ? "" : " / " + s.District)
                            </div>
                            <div class="structure-card-badges">
                                <span class="badge" style="background:#6f42c1">@GetStructureLabel(s.StructureType)</span>
                                <span class="badge bg-primary">@s.SensorCount sensör</span>
                                @foreach (var sensorType in GetSensorTypeSummary(s))
                                {
                                    <span class="badge bg-light text-dark border">@sensorType</span>
                                }
                                @foreach (var runtimeSummary in GetDeviceRuntimeSummary(s))
                                {
                                    <span class="badge @(runtimeSummary.Passive > 0 ? "bg-warning text-dark" : "bg-light text-dark border")"
                                          title="Node-RED cihaz kontrolü Edge Layer'da anlık saklanır.">
                                        @runtimeSummary.Active aktif · @runtimeSummary.Passive pasif @runtimeSummary.Label
                                    </span>
                                }
                                @if (_localPipelineStates.TryGetValue(s.Id, out var localPipelineEnabled))
                                {
                                    <span class="badge @(localPipelineEnabled ? "bg-success" : "bg-danger")">
                                        <span class="bi @(localPipelineEnabled ? "bi-broadcast" : "bi-stop-circle") me-1"></span>
                                        @(localPipelineEnabled ? "Saha yerel akış aktif" : "Saha yerel akış durduruldu")
                                    </span>
                                }
                                else if (s.IsActive)
                                { <span class="badge bg-secondary">Envanterde</span> }
                                else
                                { <span class="badge bg-secondary">Envanter dışı</span> }
                                @if (_forwardingStates.TryGetValue(s.Id, out var forwarding))
                                {
                                    <span class="badge @(forwarding ? "bg-info text-dark" : "bg-secondary")">
                                        @(forwarding ? "Merkeze iletim açık" : "Merkeze iletim kapalı")
                                    </span>
                                }
                                @* Prod lifecycle özeti — yalnızca prod modda göster *@
                                @if (_isProdMode && s.TotalSensorCount > 0)
                                {
                                    <span class="badge @(s.CanStart ? "bg-success" : "bg-warning text-dark")"
                                          title="Ready: @s.ReadySensorCount / @s.TotalSensorCount">
                                        ✓ @s.ReadySensorCount / @s.TotalSensorCount
                                    </span>
                                    @if (s.ConnectionPendingSensorCount > 0)
                                    {
                                        <span class="badge bg-danger" title="@s.ConnectionPendingSensorCount bağlantı testi eksik">
                                            🔌 @s.ConnectionPendingSensorCount
                                        </span>
                                    }
                                    @if (s.ParserPendingSensorCount > 0)
                                    {
                                        <span class="badge bg-warning text-dark" title="@s.ParserPendingSensorCount parser doğrulaması eksik">
                                            ⚙️ @s.ParserPendingSensorCount
                                        </span>
                                    }
                                    @if (s.MetricPreviewPendingCount > 0)
                                    {
                                        <span class="badge bg-secondary" title="@s.MetricPreviewPendingCount metrik önizleme eksik">
                                            📊 @s.MetricPreviewPendingCount
                                        </span>
                                    }
                                }
                            </div>
                            <div class="mt-3 d-flex justify-content-end gap-2">
                                @if (IsLocalPipelineEnabled(s.Id))
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => StopStructureSimulationAsync(s.Id)"
                                            @onclick:stopPropagation="true"
                                            disabled="@_stoppingStructureIds.Contains(s.Id)">
                                        @if (_stoppingStructureIds.Contains(s.Id))
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        else
                                        {
                                            <span class="bi bi-stop-fill me-1"></span>
                                        }
                                        Durdur
                                    </button>
                                }
                                <button class="btn btn-sm btn-success"
                                        @onclick="() => StartStructureSimulationAsync(s.Id)"
                                        @onclick:stopPropagation="true"
                                        disabled="@(_startingStructureIds.Contains(s.Id) || IsLocalPipelineEnabled(s.Id) || GetStartDisabled(s))"
                                        title="@GetStartTooltip(s)">
                                    @if (_startingStructureIds.Contains(s.Id))
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    else
                                    {
                                        <span class="bi bi-play-fill me-1"></span>
                                    }
                                    @if (s.SensorCount == 0)
                                    {
                                        <span>Sensör yok</span>
                                    }
                                    else if (_isProdMode && !s.CanStart && s.TotalSensorCount > 0 && string.IsNullOrWhiteSpace(s.EdgeApiUrl))
                                    {
                                        <span>Hazır değil</span>
                                    }
                                    else
                                    {
                                        @(IsLocalPipelineEnabled(s.Id) ? "Veri toplama açık" : "Veri toplamayı başlat")
                                    }
                                </button>
                                @if (s.SensorCount > 0)
                                {
                                <button class="btn btn-sm @( _forwardingStates.TryGetValue(s.Id, out var isForwardingActive) && isForwardingActive ? "btn-outline-secondary" : "btn-outline-primary")"
                                        @onclick="() => SetStructureForwardingAsync(s.Id, !(_forwardingStates.TryGetValue(s.Id, out var current) && current))"
                                        @onclick:stopPropagation="true"
                                        title="Yerel akışı değiştirmeden merkez aktarımını açar veya kapatır.">
                                    <span class="bi bi-cloud-arrow-@( _forwardingStates.TryGetValue(s.Id, out var state) && state ? "down" : "up") me-1"></span>
                                    @( _forwardingStates.TryGetValue(s.Id, out var enabled) && enabled ? "Merkeze iletimi durdur" : "Merkeze ilet")
                                </button>
                                }
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => DownloadSavedPackageAsync(s.Id)" @onclick:stopPropagation="true">Saha ZIP’ini indir</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@* ══════════════════════════════════════════════════════════════════
   YENİ YAPI OLUŞTURMA — 3 ADIM
   ══════════════════════════════════════════════════════════════════ *@
<div class="create-structure-panel mb-4" hidden="@(!_showCreateWizard)">
    @if (!string.IsNullOrWhiteSpace(_saveError)) { <div class="alert alert-danger m-3" role="alert">@_saveError</div> }
    @if (!string.IsNullOrWhiteSpace(_setupNotice)) { <div class="alert alert-info m-3" role="status">@_setupNotice</div> }
        <div class="create-panel-header">
            <strong><span class="me-2">🏔️</span>Baraj ve saha kurulumu</strong>
            <button class="btn btn-sm btn-outline-light" @onclick="CancelCreate">Kurulumu kapat</button>
        </div>

        <div class="create-steps">
          <button class="create-step @(_wizardStep == 2 ? "active" : "done")" @onclick="BackFromStep3" aria-expanded="@(_wizardStep == 2)"><span class="create-step-num">1</span>Baraj bilgileri</button>
          <button class="create-step @(_wizardStep == 4 ? "active" : "")" @onclick="SaveBasicInfoAndContinueAsync" disabled="@(_createdStructureId == Guid.Empty || _isSaving)" aria-expanded="@(_wizardStep == 4)"><span class="create-step-num">2</span>Sensörler ve veri kaynakları</button>
          <button class="create-step @(_wizardStep == 5 ? "active" : "")" @onclick="GoToDeploymentStep" disabled="@(_createdStructureId == Guid.Empty || _setupSaving)" aria-expanded="@(_wizardStep == 5)"><span class="create-step-num">3</span>Saha ZIP’ini hazırla</button>
        </div>

        <div class="p-4">
            @* ADIM 2 — Temel bilgiler. Bu alan görünürlükle yönetilir; Razor blok
               kapanışının sayfaya düz metin olarak düşmesini önler. *@
            <div hidden="@(_wizardStep != 2)">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="setup-name" class="form-label fw-semibold">Baraj adı <span class="text-danger">*</span></label>
                        <input id="setup-name" class="form-control" @bind="_newName" @bind:event="oninput" placeholder="Örn: Yusufeli Barajı" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Yapı Türü</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var type in AvailableStructureTypes)
                            {
                                var selected = _newType == type.Key;
                                <button type="button"
                                        class="btn @(selected ? "btn-primary" : "btn-outline-secondary") d-flex align-items-center gap-2"
                                        @onclick="() => SelectNewType(type.Key)">
                                    <img src="@type.Value.ImagePath" alt="@type.Value.Label" style="width:28px;height:28px;object-fit:contain" />
                                    <span>@type.Value.Label</span>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Durum</label>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" @bind="_newIsActive" id="chkActive" />
                            <label class="form-check-label" for="chkActive">Aktif baraj kaydı</label><div class="form-text">Aktif kayıt, merkezi veri toplama servislerinin baraj listesine dahil edilir. Kapatmak kaydı silmez. Veri toplamayı başlatmak veya durdurmak baraj kartından ayrıca yapılır.</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Açıklama</label>
                        <input class="form-control" @bind="_newDescription" placeholder="Yapı hakkında kısa bir açıklama" />
                    </div>
                    @* ── Konum bilgileri de burada ── *@
                    <div class="col-12"><hr class="my-1" /><small class="text-muted fw-semibold">Konum Bilgileri</small></div>
                    <div class="col-md-4">
                        <label class="form-label">İl <span class="text-danger">*</span></label>
                        <select class="form-select" value="@_newProvince" @onchange="OnNewProvinceChanged">
                            <option value="">-- İl Seçin --</option>
                            @foreach (var p in _provinces)
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">İlçe</label>
                        <select class="form-select" value="@_newDistrict" @onchange="OnNewDistrictChanged"
                                disabled="@(string.IsNullOrEmpty(_newProvince))">
                            <option value="">-- İlçe Seçin --</option>
                            @foreach (var d in _newDistricts)
                            {
                                <option value="@d">@d</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Adres</label>
                        <input id="address-input" class="form-control" @bind="_newAddress" placeholder="Cadde / mahalle" />
                    </div>
                    @* ── Harita ── *@
                    <div class="col-12"><details class="dy-technical" ontoggle="if(this.open && window.refreshSetupMap) window.refreshSetupMap()" open><summary>Haritada konum seç (isteğe bağlı)</summary>
                        <label class="form-label">
                            <span class="bi bi-map me-1"></span>Konum Seç
                            <small class="text-muted fw-normal"> — Haritaya tıklayın ya da marker'ı sürükleyin</small>
                        </label>
                        <div id="new-map" class="map-container"></div>
                        <div class="row mt-2 g-2">
                            <div class="col-md-4">
                                <label class="form-label small">Enlem</label>
                                <input id="lat-input" type="number" class="form-control form-control-sm" @bind="_newLat" step="0.000001" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Boylam</label>
                                <input id="lng-input" type="number" class="form-control form-control-sm" @bind="_newLng" step="0.000001" />
                            </div>
                        </div>
                    </details></div>
                    @* Teknik hizmet seçimi günlük forma dahil edilmez. *@
                    <div class="col-12"><details class="dy-technical"><summary>Teknik hizmet ayarları (isteğe bağlı)</summary><hr class="my-1" /><small class="text-muted fw-semibold">Node-RED Entegrasyonu</small>
                    <div class="col-12">
                        <label class="form-label">
                            <span class="bi bi-diagram-3 me-1"></span>Node-RED URL
                            @if (!string.IsNullOrWhiteSpace(_newNodeRedUrl))
                            {
                                <span class="badge bg-success ms-2" style="font-size:0.7rem">Otomatik atandı</span>
                            }
                            else
                            {
                                <small class="text-muted fw-normal"> — Boş bırakılırsa ortak instance kullanılır</small>
                            }
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <span class="bi bi-diagram-3@(!string.IsNullOrWhiteSpace(_newNodeRedUrl) ? "-fill text-success" : " text-muted")"></span>
                            </span>
                            <input class="form-control @(!string.IsNullOrWhiteSpace(_newNodeRedUrl) ? "bg-light" : "")"
                                   @bind="_newNodeRedUrl"
                                   readonly="@(!string.IsNullOrWhiteSpace(Configuration[$"NodeRed:PerStructureUrls:{_newType}"]))"
                                   placeholder="http://localhost:1881 (Baraj için merkez Dam Node-RED)" />
                            @if (!string.IsNullOrWhiteSpace(_newNodeRedUrl))
                            {
                                <button class="btn btn-outline-secondary" type="button"
                                        title="Temizle — ortak instance kullanılır"
                                        @onclick="() => _newNodeRedUrl = string.Empty">
                                    <span class="bi bi-x-lg"></span>
                                </button>
                            }
                            else if (HasAutomaticNodeRedUrl)
                            {
                                <button class="btn btn-outline-primary" type="button"
                                        title="Yapı tipi için tanımlı Node-RED URL'ini yeniden ata"
                                        @onclick="RestoreAutomaticNodeRedUrl">
                                    <span class="bi bi-arrow-counterclockwise"></span>
                                </button>
                            }
                        </div>
                        <div class="form-text">
                            @if (!string.IsNullOrWhiteSpace(_newNodeRedUrl))
                            {
                                <span class="text-success"><span class="bi bi-check-circle me-1"></span>Baraj verilerinin izlendiği merkez <code>nodered-center-dam</code> instance'ı atandı. Bu adres Edge Config'e kaydedilir.</span>
                            }
                            else
                            {
                                <span>Boş bırakılırsa ortak Node-RED kullanılır. Özel Kubernetes pod'u veya farklı bir saha instance'ı gerekiyorsa tarayıcıdan erişilebilen URL'i girin.</span>
                            }
                        </div>
                    </div></details></div>
                </div>
                <div class="d-flex align-items-center justify-content-between gap-3 mt-4"><span class="dy-subtle">Kaydettikten sonra bu barajın kurulumuna listeden devam edebilirsiniz.</span><button class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newProvince) || _isSaving)" @onclick="SaveBasicInfoAndContinueAsync">@(_isSaving ? "Kaydediliyor…" : "Kaydet ve sensör ekle →")</button></div>
            </div>

            <div hidden="@(_wizardStep != 4)">
              @{ var hasPassiveSources = _friendlyUdpSources.Any() || MqttConnections().Any() || _cameraSettings.Cameras.Any(); }
              <div class="dy-heading"><div><h2 class="dy-form-heading">Hangi sensörleri izleyeceksiniz?</h2><p>TCP cihaz bağlantısıyla sensörü hemen ekleyin ya da UDP/MQTT kaynağını tanımlayın; sensörler saha kurulumu sonrası otomatik bulunur.</p></div><button class="btn btn-primary" @onclick="OpenWizardSensorEditor">+ Sensör ekle</button></div>
              <details id="wizard-placement" class="dy-technical" open><summary>Görsel üzerinde sensör konumu seç (isteğe bağlı)</summary><p class="dy-subtle">Mevcut sensörü yerleştirmek için satırındaki "Görselde yerleştir" düğmesini kullanın. Boş bir noktaya tıklamak yeni sensör için temiz kaynak seçimini açar.</p>@if(_wizardPlacingSensorId.HasValue){<div class="alert alert-info">Seçilen sensörün konumu için görsele tıklayın. <button class="btn btn-sm btn-outline-secondary" @onclick="()=>_wizardPlacingSensorId=null">Yerleştirmeyi iptal et</button></div>}@if(!_newStructureSensors.Any() && hasPassiveSources){<div class="alert alert-light border small py-2 mb-2"><span class="bi bi-info-circle me-1 text-secondary"></span>Yalnız UDP/MQTT kaynağı tanımlı. Saha kurulumu sonrası sensörler bu yapıya kaydedildiğinde yapı kartına tıklayarak görselde konumlandırabilirsiniz.</div>}<div class="wizard-image-wrapper" id="wizard-image"></div></details>

              @* ── KAYITLI SENSÖRLER (TCP / doğrudan eklenen) — Tab + Arama + Pagination ── *@
              @{
                var wizFiltered = string.IsNullOrWhiteSpace(_wizSensorSearch)
                    ? _newStructureSensors
                    : _newStructureSensors.Where(s =>
                        s.Name.Contains(_wizSensorSearch, StringComparison.OrdinalIgnoreCase) ||
                        s.DeviceId.Contains(_wizSensorSearch, StringComparison.OrdinalIgnoreCase) ||
                        s.SensorType.ToString().Contains(_wizSensorSearch, StringComparison.OrdinalIgnoreCase)).ToList();
                var wizTotalPages = (int)Math.Ceiling(wizFiltered.Count / 10.0);
                if (_wizSensorPage >= wizTotalPages) _wizSensorPage = Math.Max(0, wizTotalPages - 1);
                var wizPaged = wizFiltered.Skip(_wizSensorPage * 10).Take(10).ToList();
              }

              @* Tab başlıkları *@
              <div class="mt-3">
                <ul class="nav nav-tabs border-0" role="tablist">
                  <li class="nav-item">
                    <button class="nav-link @(_wizTab == "sensors" ? "active" : "")" @onclick='() => _wizTab = "sensors"'>
                      <span class="bi bi-cpu me-1"></span>Kayıtlı sensörler
                      <span class="badge @(_wizTab == "sensors" ? "bg-primary" : "bg-secondary") ms-1">@_newStructureSensors.Count</span>
                    </button>
                  </li>
                  <li class="nav-item">
                    <button class="nav-link @(_wizTab == "sources" ? "active" : "")" @onclick='() => _wizTab = "sources"'>
                      <span class="bi bi-broadcast me-1"></span>Veri kaynakları
                      @if (hasPassiveSources) {
                        <span class="badge @(_wizTab == "sources" ? "bg-primary" : "bg-secondary") ms-1">@(_friendlyUdpSources.Count + MqttConnections().Count + _cameraSettings.Cameras.Count)</span>
                      }
                    </button>
                  </li>
                </ul>
              </div>

              @* ── Tab: Sensörler ── *@
              @if (_wizTab == "sensors") {
                @if (_newStructureSensors.Count > 0) {
                  <div class="d-flex align-items-center gap-2 py-2">
                    <div class="input-group input-group-sm" style="max-width:280px">
                      <span class="input-group-text"><span class="bi bi-search"></span></span>
                      <input class="form-control" placeholder="Ara: ad, tip, cihaz kimliği…"
                             @bind="_wizSensorSearch" @bind:event="oninput"
                             @bind:after="() => _wizSensorPage = 0" />
                      @if (!string.IsNullOrEmpty(_wizSensorSearch)) {
                        <button class="btn btn-outline-secondary" @onclick="() => { _wizSensorSearch = string.Empty; _wizSensorPage = 0; }"><span class="bi bi-x"></span></button>
                      }
                    </div>
                    <small class="text-muted">@wizFiltered.Count / @_newStructureSensors.Count sensör</small>
                    <small class="text-muted ms-1">— bağlantı testi yapılmış, DB'ye yazılmış</small>
                  </div>
                  <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Sensör</th><th>Ölçüm türü</th><th>Görsel konumu</th><th></th></tr></thead><tbody>
                  @foreach (var sensor in wizPaged) {
                    var wizIdx = _newStructureSensors.IndexOf(sensor);
                    <tr>
                      <td><strong>@sensor.Name</strong><div class="dy-subtle small">@SensorSourceLabel(sensor)</div></td>
                      <td>@GetSensorTypeLabel(sensor.SensorType.ToString())</td>
                      <td><span class="@(sensor.ImagePositionX.HasValue ? "text-success" : "text-muted") small">@(sensor.ImagePositionX.HasValue ? "✓ Konumlandırıldı" : "Seçilmedi (isteğe bağlı)")</span></td>
                      <td class="text-nowrap">
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => PlaceWizardSensorAsync(sensor)">Görselde yerleştir</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveWizardSensor(wizIdx)" aria-label="@($"{sensor.Name} sensörünü barajdan kaldır")">Kaldır</button>
                      </td>
                    </tr>
                  }
                  </tbody></table></div>
                  @if (wizTotalPages > 1) {
                    <div class="d-flex align-items-center justify-content-between pb-1">
                      <small class="text-muted">Sayfa @(_wizSensorPage + 1) / @wizTotalPages</small>
                      <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" disabled="@(_wizSensorPage == 0)" @onclick="() => _wizSensorPage--"><span class="bi bi-chevron-left"></span></button>
                        @for (var pi = 0; pi < wizTotalPages; pi++) { var pageIdx = pi;
                          <button class="btn @(_wizSensorPage == pageIdx ? "btn-primary" : "btn-outline-secondary")" @onclick="() => _wizSensorPage = pageIdx">@(pageIdx + 1)</button>
                        }
                        <button class="btn btn-outline-secondary" disabled="@(_wizSensorPage >= wizTotalPages - 1)" @onclick="() => _wizSensorPage++"><span class="bi bi-chevron-right"></span></button>
                      </div>
                    </div>
                  }
                } else if (!hasPassiveSources) {
                  <div class="alert alert-info mt-2" role="status">
                    <h3 class="h6">Henüz sensör veya kaynak eklenmedi</h3>
                    <p class="mb-0"><strong>"+ Sensör ekle"</strong> butonuyla başlayın. TCP cihazınız varsa bağlantıyı test edip sensörü hemen oluşturabilirsiniz. UDP/MQTT kullanıyorsanız "Veri kaynakları" sekmesinden kaynak ekleyin.</p>
                  </div>
                } else {
                  <div class="alert alert-light py-2 small mt-2 d-flex align-items-center gap-2">
                    <span class="bi bi-info-circle text-secondary"></span>
                    <span>Yalnız UDP/MQTT kaynağı tanımlı. Saha kurulumu sonrası sensörler otomatik kaydedildiğinde buraya gelecek.</span>
                  </div>
                }
              }

              @* ── Tab: Veri kaynakları ── *@
              @if (_wizTab == "sources") {
                @if (hasPassiveSources) {
                  <div class="alert alert-warning py-2 small d-flex align-items-start gap-2 mt-2 mb-2">
                    <span class="bi bi-info-circle-fill mt-1 flex-shrink-0"></span>
                    <span>Bu bağlantılar <strong>sensör değildir</strong>. Saha kurulumu tamamlanıp veri gelmeye başladığında sensörler <strong>bu yapıya otomatik kaydedilir</strong>. Tek bir UDP portu veya MQTT topic'inden birden fazla sensör gelebilir.</span>
                  </div>
                }
                @foreach (var source in _friendlyUdpSources) { <div class="dy-source-row"><div><strong>@(string.IsNullOrWhiteSpace(source.Name) ? source.Host : source.Name)</strong><p class="mb-0">UDP · @source.Host:@source.Port</p><span class="dy-chip neutral">Saha başlatılınca sensörler otomatik bulunur</span></div><button class="btn btn-outline-secondary btn-sm" @onclick="() => RemoveFriendlySource(source)">Kaynağı kaldır</button></div> }
                @foreach(var source in MqttConnections()) { <div class="dy-source-row"><div><strong>@source.Name</strong><p class="mb-0">MQTT · @source.Host:@source.Port · @source.Topic</p><span class="dy-chip neutral">@source.ScalarMetric · Saha başlatılınca sensörler otomatik bulunur</span></div><button class="btn btn-outline-secondary btn-sm" @onclick="()=>EditMqttConnection(source)">Düzenle</button><button class="btn btn-outline-secondary btn-sm ms-1" @onclick="()=>RemoveMqttConnection(source)">Kaynağı kaldır</button></div> }
                @foreach (var camera in _cameraSettings.Cameras) { <div class="dy-source-row"><div><strong>@camera.Id</strong><p class="mb-0">Kamera · @(camera.SourceType == "usb" ? "Saha bilgisayarına takılı" : camera.SourceType == "mqtt" ? "Başka bilgisayardan" : "Ağ üzerinden")</p><span class="dy-chip neutral">Kamera ayarı kaydedilecek · görüntü ayrıca kontrol edilir</span></div><button class="btn btn-outline-secondary btn-sm" @onclick="() => EditSetupCamera(camera)">Düzenle</button><button class="btn btn-outline-secondary btn-sm ms-1" @onclick="() => RemoveSetupCamera(camera)">Kaldır</button></div> }
                @if (!hasPassiveSources) {
                  <div class="alert alert-light py-2 small mt-2">Kayıtlı UDP/MQTT kaynağı yok. "+ Sensör ekle" butonundan UDP veya MQTT kaynak ekleyebilirsiniz.</div>
                }
              }
              <div class="dy-guide mt-3"><h3 class="h6">Saha dosyasını ayrıca doldurmanız gerekmez</h3><p>Burada seçtiğiniz kaynaklar saha ayarlarına ve ZIP'e otomatik yazılır. Sensörün kaydedilmesi ile gerçek veri gelmesi ayrı gösterilir.</p></div>
              <div class="d-flex flex-wrap justify-content-between gap-2 mt-4"><button class="btn btn-outline-secondary" @onclick="BackFromStep3">← Baraj bilgileri</button><button class="btn btn-outline-secondary" @onclick="SaveFieldSetupAsync" disabled="@_setupSaving">Kaydet, sonra devam et</button><button class="btn btn-primary" @onclick="GoToDeploymentStep" disabled="@(_setupSaving || !HasSetupSources)">Kaydet ve ZIP hazırla →</button></div>
            </div>

            <div hidden="@(_wizardStep != 5)">
                    <div class="card border-success">
                        <div class="card-header bg-success text-white"><strong>Saha kurulum paketi</strong></div>
                        <div class="card-body">
                            <h2 class="h4">Saha ZIP’ini hazırlayın</h2><p>Aşağıdaki bölümleri sırayla tamamlayın. Sensör ve kamera kaynakları hazır; tekrar girmeniz gerekmez.</p><div class="dy-chip neutral mb-3">@_setupName · @SourceCount kaynak</div>
                            @if (_packageDownloaded) { <div class="alert alert-success">ZIP tarayıcıya gönderildi. Saha kurulumu ve veri gelişi kurulum sonrasında kontrol edilir.</div> }
                            <div class="dy-package-step"><button class="dy-package-toggle" @onclick="() => _packageSection = 1" aria-expanded="@(_packageSection == 1)"><span>1</span><strong>Hangi bilgisayara kurulacak?</strong><small>@(_samePcDeployment ? "Başka barajla ortak bilgisayar" : "Bu baraja ayrılmış bilgisayar")</small></button><div class="p-3" hidden="@(_packageSection != 1)"><p>Bu baraj için ayrı bir bilgisayar varsa aşağıdaki seçeneği kapalı bırakın.</p>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" @bind="_samePcDeployment" id="samePcDeployment" />
                                <label class="form-check-label fw-semibold" for="samePcDeployment">Bu bilgisayarda başka bir baraj da çalışacak</label>
                            </div>
                            @if (_samePcDeployment)
                            {
                                <div class="border rounded p-3 mb-3 bg-light">
                                    <div class="small text-success fw-semibold mb-2">Bu seçim ortak EMQX, Kafka, TimescaleDB ve Timeseries API paketi ile yalnız bu yapının Edge + Node-RED paketini üretir. Ortak altyapı portları bir kez açılır; her ek yapı için yalnız Edge ve Node-RED host portları farklı olmalıdır.</div>
                                    <div class="row g-2">
                                        <div class="col-md-4"><label class="form-label small">Bu kurulumun kısa adı</label><input class="form-control form-control-sm" @bind="_samePcProjectName" placeholder="saha-a" /><div class="form-text">İkinci ZIP'te farklı olmalı: <code>saha-b</code>.</div></div>
                                        <div class="col-md-4"><label class="form-label small">Edge API host portu</label><input class="form-control form-control-sm" type="number" @bind="_samePcEdgePort" min="1024" max="65535" /><div class="form-text">Mevcut: <code>5080</code>. İkinci örnek: <code>5081</code>.</div></div>
                                        <div class="col-md-4"><label class="form-label small">Node-RED host portu</label><input class="form-control form-control-sm" type="number" @bind="_samePcNodeRedPort" min="1024" max="65535" /><div class="form-text">Mevcut: <code>1880</code>. İkinci örnek: <code>1881</code>.</div></div>
                                    </div>
                                    <div class="form-text mt-2">İlk ZIP'te ortak altyapıyı bir kez başlatın. Sonraki yapı ZIP'lerinde aynı ortak altyapı portlarını kullanın; yalnız <code>saha-b</code>, Edge <code>5081</code> ve Node-RED <code>1881</code> farklı olsun. Edge/Node-RED URL'si ZIP'te seçilen portla güncellenir.</div>
                                </div>
                            }
                            <button class="btn btn-primary" @onclick="() => _packageSection = 2">Devam: merkez bağlantısı →</button></div></div>
                            <div class="dy-package-step"><button class="dy-package-toggle" @onclick="() => _packageSection = 2" aria-expanded="@(_packageSection == 2)"><span>2</span><strong>Merkeze nasıl bağlanacak?</strong><small>Önceden tanımlı merkez adresleri</small></button><div class="p-3" hidden="@(_packageSection != 2)"><p>Merkez adresleri hazır gelir. Kurulum sorumlusu farklı adres verdiyse değiştirin. Sensör kaynaklarını önceki adımda tanımladınız.</p><div class="row g-3">
                            @foreach (var key in new[] { "CENTRAL_AUTH_API_BASE_URL", "CENTRAL_TIMESERIES_API_BASE_URL", "CENTRAL_MQTT_HOST" }) { <div class="col-md-6"><label class="form-label">@(key == "CENTRAL_AUTH_API_BASE_URL" ? "Merkez giriş hizmeti" : key == "CENTRAL_TIMESERIES_API_BASE_URL" ? "Merkez ölçüm hizmeti" : "Merkez veri iletim adresi")</label><input class="form-control" value="@GetEnv(key)" @onchange="e => SetEnv(key, e.Value?.ToString())" /></div> }
                            </div><details class="dy-technical"><summary>Kurulum uzmanı için diğer saha ayarları</summary><div class="row g-3"><div class="col-md-6"><label class="form-label">Saha kontrol adresi</label><input class="form-control" @bind="_newEdgeApiUrl" /></div><div class="col-md-6"><label class="form-label">Node-RED adresi</label><input class="form-control" @bind="_newNodeRedUrl" /></div></div>
                            @foreach (var group in EnvironmentGroups) { <details class="dy-technical"><summary>@group.Label</summary><div class="row g-3">@foreach (var field in SiteEnvironmentFields.Where(f => GetEnvironmentGroup(f.Key) == group.Key && ShouldShowEnvironmentField(f.Key))) { <div class="col-md-6"><label class="form-label">@field.Label</label>@if (IsGeneratedSourceField(field.Key)) { <textarea class="form-control" readonly>@(field.Key == "DEYAS_BRIDGE_TCP_SOURCES" ? BuildTcpSourcesJson() : GetEnv(field.Key))</textarea> } else { <input class="form-control" value="@GetEnv(field.Key)" @onchange="e => SetEnv(field.Key, e.Value?.ToString())" /> }<div class="form-text">@field.Description</div></div> }</div></details> }</details>
                            <button class="btn btn-primary" @onclick="() => _packageSection = 3">Devam: erişim bilgileri →</button></div></div>
                            <div class="dy-package-step"><button class="dy-package-toggle" @onclick="() => _packageSection = 3" aria-expanded="@(_packageSection == 3)"><span>3</span><strong>Kurulum erişim bilgileri</strong><small>Kurulum sorumlusunun dolduracağı alanlar</small></button><div class="p-3" hidden="@(_packageSection != 3)"><p>Bu bilgileri bilmiyorsanız boş bırakabilirsiniz. Kurulum sorumlusu ZIP içindeki erişim dosyasını sahada tamamlayabilir.</p>
                            <label for="package-key" class="form-label">Merkezin kurulum erişim anahtarı (biliyorsanız)</label><input id="package-key" type="password" class="form-control" @bind='_deploymentSecrets["DEYAS_JWT_SIGNING_KEY"]' autocomplete="new-password" /><div class="form-text">Merkezdeki anahtarla aynı olmalı; en az 32 karakter. Bilmiyorsanız kurulum sorumlusu sahada tamamlasın. Yalnız ZIP’e yazılır.</div>
                            <details class="dy-technical"><summary>Merkez ek bir bağlantı hesabı istiyorsa</summary><p class="dy-subtle">Standart kurulumda boş bırakılır. Sensör kaynağının hesabı sensör ekleme ekranında girilir.</p><div class="row g-3"><div class="col-md-6"><label class="form-label">Merkez veri iletim kullanıcı adı</label><input class="form-control" @bind='_deploymentSecrets["CENTRAL_MQTT_USERNAME"]' /></div><div class="col-md-6"><label class="form-label">Merkez veri iletim parolası</label><input type="password" class="form-control" @bind='_deploymentSecrets["CENTRAL_MQTT_PASSWORD"]' /></div></div></details><p class="dy-subtle">Yerel hizmet parolaları otomatik oluşturulur. ZIP’i kurulum sorumlusuyla paylaşın.</p>
                            <button class="btn btn-primary" @onclick="() => _packageSection = 4">Devam: kontrol et ve indir →</button></div></div>
                            <div class="dy-package-step"><button class="dy-package-toggle" @onclick="() => _packageSection = 4" aria-expanded="@(_packageSection == 4)"><span>4</span><strong>Kontrol et ve ZIP’i indir</strong><small>@SourceCount kaynak · @_setupName</small></button><div class="p-3" hidden="@(_packageSection != 4)"><p><strong>@_setupName</strong> için @SourceCount kaynak tanımlandı. Kaynak ayarları dosyalara otomatik eklenecek.</p><p>İndirdikten sonra ZIP’i saha bilgisayarında açın ve <strong>ONCE_BUNU_OKUYUN.md</strong> dosyasını okuyun.</p>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-outline-secondary" @onclick="GoBackToSensorStep"><span class="bi bi-arrow-left me-1"></span>Geri: Sensör Ekle</button>
                                <button class="btn btn-primary" @onclick="DownloadDeploymentPackage" disabled="@(_packageBusy || _setupSaving)"><span class="bi bi-file-earmark-zip me-1"></span>@(_packageBusy ? "Paket hazırlanıyor…" : "Saha kurulum ZIP'ini indir")</button>
                            </div></div></div>
                        </div>
                    </div>
            </div>
        </div>
    </div>

@* ══════════════════════════════════════════════════════════════════
   YAPI DETAY — Görsel + Sensör Overlay
   ══════════════════════════════════════════════════════════════════ *@
@if (_editingStructure != null)
{
    <div class="structure-detail-panel mb-4">
        <div class="structure-detail-header">
            <div class="d-flex align-items-center gap-2 overflow-hidden">
                <img src="@(_editingStructure.ImageUrl ?? GetStructureImagePath(_editingStructure.StructureType))"
                     style="width:2rem;height:2rem;object-fit:contain;border-radius:4px;flex-shrink:0"
                     alt="@_editingStructure.Name"
                     onerror="this.onerror=null;this.src=''" />
                <div class="overflow-hidden">
                    <h5 class="mb-0 text-truncate">@_editingStructure.Name</h5>
                    <small class="text-white-50">
                        @_editingStructure.Province
                        @(string.IsNullOrEmpty(_editingStructure.District) ? "" : " / " + _editingStructure.District)
                        · @GetStructureLabel(_editingStructure.StructureType)
                    </small>
                </div>
            </div>
            <div class="d-flex gap-2 flex-shrink-0">
                <button class="btn btn-sm btn-outline-light" @onclick="() => EditSavedSourcesAsync(_editingStructure.Id)">Sensörleri ve kaynakları düzenle</button>
                <button class="btn btn-sm btn-light" @onclick="() => AddSensorToExistingAsync(_editingStructure.Id)">Yeni sensör ekle</button>
                <button class="btn btn-sm btn-outline-light" @onclick="() => EditSavedSourcesAsync(_editingStructure.Id)" title="Barajı ve sensörlerini düzenle">
                    <span class="bi bi-pencil me-1"></span>Düzenle
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(_editingStructure.Id)" title="Sil">
                    <span class="bi bi-trash"></span>
                </button>
                <button class="btn btn-sm btn-outline-light" @onclick="CloseDetail">
                    <span class="bi bi-x-lg"></span>
                </button>
            </div>
        </div>

        @* ── Görsel Overlay — JS initStructureImage() doldurur ── *@
        <div class="structure-image-wrapper" id="structure-image">
            @* JS tarafından doldurulur *@
        </div>
        <div class="structure-image-click-hint">
            <span class="bi bi-crosshair me-1"></span>@(_placingSensorId.HasValue ? "Seçili sensörün konumunu resme tıklayarak belirleyin" : "Resme tıklayarak sensör ekleyin")
        </div>

        @if (_editingStructure.Sensors?.Any(s => !s.ImagePositionX.HasValue || !s.ImagePositionY.HasValue) == true)
        {
            <div class="alert alert-warning mx-3 mt-3 mb-0 d-flex align-items-center gap-2">
                <span class="bi bi-geo-alt-fill"></span>
                <select class="form-select form-select-sm" @bind="_placingSensorId">
                    <option value="">Konumu belirlenmemiş sensör seçin</option>
                    @foreach (var sensor in _editingStructure.Sensors.Where(s => !s.ImagePositionX.HasValue || !s.ImagePositionY.HasValue))
                    {
                        <option value="@sensor.SensorId">@sensor.Name (@sensor.DeviceId)</option>
                    }
                </select>
            </div>
        }

        @* ── Alt bilgi + Kayıtlı Sensörler ── *@
        <div class="structure-detail-info">
            @if (!string.IsNullOrEmpty(_editingStructure.Description))
            {
                <span><span class="bi bi-info-circle me-1 text-muted"></span>@_editingStructure.Description</span>
            }
            @if (_editingStructure.Latitude.HasValue)
            {
                <span><span class="bi bi-crosshair me-1 text-muted"></span>
                    @_editingStructure.Latitude.Value.ToString("F5"), @_editingStructure.Longitude!.Value.ToString("F5")
                </span>
            }
            <span><span class="bi bi-cpu me-1 text-muted"></span>@(_editingStructure.Sensors?.Count ?? 0) sensör</span>
            <span class="ms-auto">
                <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshMarkersAsync">
                    <span class="bi bi-arrow-clockwise me-1"></span>Yenile
                </button>
            </span>
        </div>

        @* ── Tab: Sensörler / Kaynaklar ── *@
        @{
            var allDetailSensors   = _editingStructure.Sensors ?? [];
            var filteredSensors    = string.IsNullOrWhiteSpace(_detailSensorSearch)
                ? allDetailSensors
                : allDetailSensors.Where(s =>
                    s.Name.Contains(_detailSensorSearch, StringComparison.OrdinalIgnoreCase) ||
                    s.DeviceId.Contains(_detailSensorSearch, StringComparison.OrdinalIgnoreCase) ||
                    s.SensorType.Contains(_detailSensorSearch, StringComparison.OrdinalIgnoreCase)).ToList();
            var totalPages         = (int)Math.Ceiling(filteredSensors.Count / (double)10);
            if (_detailSensorPage >= totalPages) _detailSensorPage = Math.Max(0, totalPages - 1);
            var pagedSensors       = filteredSensors.Skip(_detailSensorPage * 10).Take(10).ToList();

            // Kaynaklar tab'ı için saha env'den kaynak bilgilerini oku
            var detailEnvJson = _editingStructure.SiteEnvironmentJson ?? "{}";
            List<(string Kind, string Label, string Endpoint)> detailSources = [];
            try {
                using var doc = System.Text.Json.JsonDocument.Parse(detailEnvJson);
                var root = doc.RootElement;
                if (root.TryGetProperty("DEYAS_BRIDGE_UDP_SOURCES", out var udpEl)) {
                    using var udpDoc = System.Text.Json.JsonDocument.Parse(udpEl.GetString() ?? "[]");
                    foreach (var s in udpDoc.RootElement.EnumerateArray()) {
                        var h = s.TryGetProperty("host", out var hv) ? hv.GetString() ?? "" : "";
                        var p = s.TryGetProperty("port", out var pv) ? pv.GetInt32() : 0;
                        if (!string.IsNullOrEmpty(h)) detailSources.Add(("UDP", $"UDP · {h}:{p}", $"{h}:{p}"));
                    }
                }
                if (root.TryGetProperty("DEYAS_BRIDGE_SOURCE_MQTT_HOST", out var mqttHost) &&
                    !string.IsNullOrWhiteSpace(mqttHost.GetString())) {
                    var mh = mqttHost.GetString() ?? "";
                    var mp = root.TryGetProperty("DEYAS_BRIDGE_SOURCE_MQTT_PORT", out var mpv) ? mpv.GetString() ?? "1883" : "1883";
                    var mt = root.TryGetProperty("DEYAS_BRIDGE_SOURCE_MQTT_TOPIC", out var mtv) ? mtv.GetString() ?? "" : "";
                    detailSources.Add(("MQTT", $"MQTT · {mh}:{mp}", mt));
                }
                // Çoklu MQTT kaynakları (yeni format)
                if (root.TryGetProperty("DEYAS_BRIDGE_MQTT_SOURCES", out var mqttSources)) {
                    using var mqttDoc = System.Text.Json.JsonDocument.Parse(mqttSources.GetString() ?? "[]");
                    foreach (var s in mqttDoc.RootElement.EnumerateArray()) {
                        var h = s.TryGetProperty("host", out var hv) ? hv.GetString() ?? "" : "";
                        var p = s.TryGetProperty("port", out var pv) ? pv.GetInt32() : 1883;
                        var t = s.TryGetProperty("topic", out var tv) ? tv.GetString() ?? "" : "";
                        var n = s.TryGetProperty("name", out var nv) ? nv.GetString() ?? "" : "";
                        if (!string.IsNullOrEmpty(h) && !detailSources.Any(x => x.Kind == "MQTT" && x.Endpoint == t))
                            detailSources.Add(("MQTT", $"MQTT · {(string.IsNullOrEmpty(n) ? h : n)} · {h}:{p}", t));
                    }
                }
            } catch { /* JSON parse hatası — sessizce atla */ }
        }

        <div class="px-3 pt-2 pb-0">
            <ul class="nav nav-tabs nav-tabs-sm border-0" role="tablist">
                <li class="nav-item">
                    <button class="nav-link @(_detailTab == "sensors" ? "active" : "")"
                            @onclick='() => _detailTab = "sensors"'>
                        <span class="bi bi-cpu me-1"></span>Sensörler
                        <span class="badge @(_detailTab == "sensors" ? "bg-primary" : "bg-secondary") ms-1">@allDetailSensors.Count</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_detailTab == "sources" ? "active" : "")"
                            @onclick='() => _detailTab = "sources"'>
                        <span class="bi bi-broadcast me-1"></span>Veri kaynakları
                        @if (detailSources.Count > 0) {
                            <span class="badge @(_detailTab == "sources" ? "bg-primary" : "bg-secondary") ms-1">@detailSources.Count</span>
                        }
                    </button>
                </li>
            </ul>
        </div>

        @* ── Tab içeriği: Sensörler ── *@
        @if (_detailTab == "sensors") {
        <div class="px-3 pb-3">
            @if (allDetailSensors.Count > 0) {
                <div class="d-flex align-items-center gap-2 py-2">
                    <div class="input-group input-group-sm" style="max-width:280px">
                        <span class="input-group-text"><span class="bi bi-search"></span></span>
                        <input class="form-control" placeholder="Ara: ad, tip, cihaz kimliği…"
                               @bind="_detailSensorSearch" @bind:event="oninput"
                               @bind:after="() => _detailSensorPage = 0" />
                        @if (!string.IsNullOrEmpty(_detailSensorSearch)) {
                            <button class="btn btn-outline-secondary" @onclick="() => { _detailSensorSearch = string.Empty; _detailSensorPage = 0; }">
                                <span class="bi bi-x"></span>
                            </button>
                        }
                    </div>
                    <small class="text-muted">@filteredSensors.Count / @allDetailSensors.Count sensör</small>
                </div>
            }
            @if (pagedSensors.Count > 0) {
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0" style="font-size:0.83rem">
                        <thead class="table-light">
                            <tr>
                                <th style="width:32px"></th>
                                <th>Sensör Adı</th>
                                <th>Tip</th>
                                <th>Cihaz kimliği</th>
                                <th>Metrikler</th>
                                <th style="width:40px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ss in pagedSensors)
                            {
                                var icon = GetSensorEmoji(ss.SensorType);
                                var metricsCsv = !string.IsNullOrWhiteSpace(ss.Metrics) ? ss.Metrics : ss.Description;
                                <tr>
                                    <td class="text-center">@icon</td>
                                    <td>
                                        @ss.Name
                                        @if (!string.IsNullOrEmpty(ss.SourceKind)) {
                                            <span class="badge bg-light text-muted border ms-1" style="font-size:0.6rem">@ss.SourceKind.ToUpperInvariant()</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-secondary">@ss.SensorType</span></td>
                                    <td><code style="font-size:0.75rem">@ss.DeviceId</code></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(metricsCsv))
                                        {
                                            @foreach (var m in metricsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(4))
                                            { <span class="badge bg-info text-dark me-1" style="font-size:0.65rem">@m</span> }
                                            @if (metricsCsv.Split(',').Length > 4) { <span class="badge bg-light text-muted border" style="font-size:0.65rem">+@(metricsCsv.Split(',').Length - 4)</span> }
                                        }
                                        else { <small class="text-muted">-</small> }
                                    </td>
                                    <td>
                                        <button class="btn btn-outline-danger btn-sm py-0 px-1"
                                                style="font-size:0.7rem;line-height:1.5"
                                                title="Sensörü bu yapıdan kaldır"
                                                @onclick="() => RemoveSensorFromStructureAsync(ss.SensorId)">
                                            <span class="bi bi-trash"></span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (totalPages > 1) {
                    <div class="d-flex align-items-center justify-content-between pt-2">
                        <small class="text-muted">Sayfa @(_detailSensorPage + 1) / @totalPages</small>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" disabled="@(_detailSensorPage == 0)"
                                    @onclick="() => _detailSensorPage--">
                                <span class="bi bi-chevron-left"></span>
                            </button>
                            @for (var pi = 0; pi < totalPages; pi++) {
                                var pageIdx = pi;
                                <button class="btn @(_detailSensorPage == pageIdx ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => _detailSensorPage = pageIdx">@(pageIdx + 1)</button>
                            }
                            <button class="btn btn-outline-secondary" disabled="@(_detailSensorPage >= totalPages - 1)"
                                    @onclick="() => _detailSensorPage++">
                                <span class="bi bi-chevron-right"></span>
                            </button>
                        </div>
                    </div>
                }
            } else if (allDetailSensors.Count > 0) {
                <div class="alert alert-info py-2 small mt-2">Arama sonucu bulunamadı.</div>
            } else {
                <div class="alert alert-light py-2 small mt-2">Bu yapıda kayıtlı sensör yok. Sensör eklemek için "Yeni sensör ekle" butonunu kullanın.</div>
            }
        </div>
        }

        @* ── Tab içeriği: Veri kaynakları ── *@
        @if (_detailTab == "sources") {
        <div class="px-3 pb-3 pt-2">
            @if (detailSources.Count > 0) {
                @foreach (var src in detailSources) {
                    <div class="dy-source-row">
                        <div>
                            <strong>@src.Label</strong>
                            @if (!string.IsNullOrEmpty(src.Endpoint)) {
                                <p class="mb-0 text-muted small">@src.Endpoint</p>
                            }
                            <span class="dy-chip neutral">Saha başlatılınca sensörler otomatik kaydedilir</span>
                        </div>
                    </div>
                }
                <div class="alert alert-warning py-2 small d-flex align-items-start gap-2 mt-2">
                    <span class="bi bi-info-circle-fill mt-1 flex-shrink-0 text-warning"></span>
                    <span>Bu bağlantılar sensör değildir. Veri geldiğinde sensörler bu yapıya otomatik kaydedilir; Sensörler sekmesinden görüntüleyebilirsiniz.</span>
                </div>
            } else {
                <div class="alert alert-light py-2 small mt-2">Kayıtlı UDP/MQTT kaynağı yok. Kaynakları yapı kurulum sihirbazından ekleyin.</div>
            }
        </div>
        }

    </div>
}

@* ══════════════════════════════════════════════════════════════════
   SENSÖR EKLEME POPUP
   ══════════════════════════════════════════════════════════════════ *@
@if (_showSensorPopup)
{
    <div class="popup-overlay" @onclick="CloseSensorPopup"></div>
    <div class="sensor-add-popup">
        <div class="sensor-add-popup-header">
            <span><span class="bi bi-plus-circle me-2"></span>@(_sensorSourceKind == "tcp" ? "Sensör ekle — TCP / Modbus" : _registerSourceSensor ? "Sensör ekle" : "Kaynak bağlantısı ekle")</span>
            <button style="background:none;border:none;color:rgba(255,255,255,0.8);font-size:20px;cursor:pointer;padding:0 4px"
                    @onclick="CloseSensorPopup">&times;</button>
        </div>

        <div class="sensor-add-popup-body">
            @if (_isWizardSensorMode) {
                <div class="dy-guide"><h2 class="h5">@(_sensorSourceKind == "tcp" ? "TCP / Modbus sensörü ekle" : _registerSourceSensor ? "Sensörler nereden geliyor?" : "Sahada hangi bağlantılar kullanılacak?")</h2><p>@(_sensorSourceKind == "tcp" ? "Cihazın ağ adresini girin, bağlantıyı test edin; başarılıysa sensör kaydedilir ve bu baraja bağlanır." : _registerSourceSensor ? "TCP seçilirse cihaza bağlanılır, bağlantı başarılı olursa sensör hemen oluşturulur. UDP veya MQTT seçilirse yalnız bağlantı bilgisi kaydedilir; sensörler saha kurulumu sonrası otomatik bulunur." : "Burada yalnız bağlantı ayarlanır. Sensörler saha kurulup ilk veri geldiğinde bulunur; ardından konumlandırabilirsiniz.")</p></div>
                @if (string.IsNullOrEmpty(_sensorSourceKind)) {
                    <fieldset class="mb-3"><legend class="h6">Bağlantı türü — birden fazla seçebilirsiniz</legend>
                    @foreach(var choice in SourceChoices) {
                        var isManual = choice.Kind == "tcp";
                        var noteClass = isManual ? "text-success" : "text-muted";
                        var noteText  = isManual
                            ? "Sensör hemen oluşturulur, bağlantı testi yapılır"
                            : choice.Kind == "camera" ? "Kamera ayarı kaydedilir, görüntü ayrıca kontrol edilir"
                            : "Bağlantı kaydedilir, sensörler saha kurulumunda otomatik bulunur";
                        <div class="form-check my-2">
                            <input id="source-choice-@choice.Kind" class="form-check-input" type="checkbox" name="source-choice"
                                   checked="@_selectedSourceKinds.Contains(choice.Kind)" @onchange="e=>ToggleSourceKind(choice.Kind,e)" />
                            <label class="form-check-label" for="source-choice-@choice.Kind">
                                @choice.Label
                                <small class="@noteClass ms-1">— @noteText</small>
                            </label>
                        </div>
                    }
                    </fieldset>
                    <button class="btn btn-primary mb-3" disabled="@(_selectedSourceKinds.Count==0)" @onclick="StartSourceBatch">Devam et →</button>
                } else {
                    <div class="alert alert-info"><strong>@SourceChoices.First(c=>c.Kind==_sensorSourceKind).Label</strong><div>@(_sensorSourceKind == "tcp" ? "Cihaza bağlanılacak; bağlantı başarılıysa sensör kaydedilir." : "Bağlantı bilgisi kaydedilir. Sensörler saha kurulumu sonrası otomatik bulunur.")@(_pendingSourceKinds.Count>0 ? $" Ardından {_pendingSourceKinds.Count} bağlantıyı daha yapılandıracağız." : "")</div></div>
                }
                <details class="dy-technical mb-3"><summary>Hangi bağlantıyı seçmeliyim?</summary><p><strong>UDP:</strong> Ölçüm bilgisayarının adresini ve veri verdiği portu kullanır. Aynı porttan birden fazla sensör gelebilir; farklı adres veya portlar için ayrıca UDP kaynağı eklenebilir.</p><p><strong>MQTT:</strong> Ölçüm bilgisayarındaki yayın sunucusuna bağlanır. Sunucu adresi, MQTT portu ve dinlenecek konu (topic) gerekir. Aynı bilgisayar hem UDP hem MQTT sağlayabilir; ikisini de seçebilirsiniz. MQTT host alanı UDP bağlantısını ayarlamaz.</p><p><strong>Kamera:</strong> Ölçüm bağlantılarının yanına USB veya ağ kamerası ekleyebilirsiniz. Kamera adresi/USB aygıtı ayrıca tanımlanır; UDP ve MQTT kaynakları korunur.</p><p><strong>TCP / Modbus:</strong> Cihazın adresine bağlanarak ölçüm okur. İvmeölçer, LiDAR veya başka bir cihaz için cihazın sunduğu bağlantıyı seçin; ardından ölçüm türünü belirtin.</p><p class="small text-muted">Adresler kayıtlı saha bilgilerinden veya kurulum varsayılanlarından önerilir; bu sahaya uygunluğunu kontrol edin. Bağlantı yöntemi tek başına her cihazın veri biçimini desteklediği anlamına gelmez. Cihazın mesaj biçimi kurulu okuyucuyla uyumlu olmalıdır. Aynı ölçümü hem UDP hem MQTT’den gönderirseniz iki kez işlenebilir.</p></details>
                @if (_sensorSourceKind is "udp" or "mqtt") {
                  <div class="row g-3"><div class="col-md-6"><label for="source-name" class="form-label">Bağlantıya vereceğiniz ad</label><input id="source-name" class="form-control" @bind="_tcpSensorName" @bind:event="oninput" placeholder="Örn: Gövde titreşim ölçümleri" /></div><div class="col-md-6"><label for="source-measurement" class="form-label">Ne ölçülüyor?</label><select id="source-measurement" class="form-select" @bind="_tcpSensorType" @bind:after="SourceMeasurementChanged"><option value="">Ölçüm türünü seçin</option>@foreach (var type in Enum.GetValues<SensorType>().Where(t => t is not SensorType.Camera and not SensorType.Image)) { <option value="@type.ToString()">@GetSensorTypeLabel(type.ToString())</option> }</select></div>
                  <div class="col-md-8"><label for="source-host" class="form-label">@(_sensorSourceKind == "udp" ? "Ölçüm bilgisayarının adresi (IP)" : "MQTT sunucusunun adresi (IP)")</label><input id="source-host" class="form-control" @bind="_sourceHost" @bind:event="oninput" placeholder="Kurulum sorumlusundan aldığınız adres" /></div><div class="col-md-4"><label for="source-port" class="form-label">@(_sensorSourceKind == "udp" ? "UDP veri portu" : "MQTT portu")</label><input id="source-port" type="number" min="1" max="65535" class="form-control" @bind="_sourcePort" @bind:event="oninput" /></div>
                  @if (_sensorSourceKind == "mqtt") { <div class="col-12"><label for="source-topic" class="form-label">Verinin yayın adresi</label><input id="source-topic" class="form-control" @bind="_sourceTopic" @bind:event="oninput" placeholder="Örn: olcumler/baraj-1/#" /><div class="form-text">Kurulum sorumlusunun verdiği yayın adresini kullanın. Her sensör farklı bir sunucu veya yayın adresi kullanabilir.</div></div><div class="col-12"><details class="dy-technical"><summary>Veri biçimi ve erişim (kurulum uzmanı)</summary><label class="form-label">Veri biçimi</label><select class="form-select" @bind="_sourcePayloadMode"><option value="scalar">Sayısal ölçüm</option><option value="waveform">Titreşim dalga kaydı</option></select><label class="form-label mt-2">Ölçüm alanı</label><input class="form-control" @bind="_sourceMetric" /><div class="form-text">Ölçüm türünden önerilir. Cihaz farklı bir alan adı kullanıyorsa değiştirin.</div><label class="form-label mt-2">Kaynak hesabı</label><input class="form-control" @bind="_sourceUsername" /><label class="form-label mt-2">Kaynak parolası</label><input type="password" class="form-control" @bind="_sourcePassword" /><p class="form-text">Erişim bilgileri yalnız indirilen ZIP’e eklenir.</p></details></div> }
                  @if(_registerSourceSensor) { <div class="col-12"><details class="dy-technical"><summary>Belirli bir sensörü önceden eşle (isteğe bağlı)</summary><p>Bu alanları boş bırakabilirsiniz. Cihaz/kanal bilgileri uyumlu ilk veriden okunur ve sensörler otomatik oluşturulur. Yalnız belirli bir kanalı önceden adlandırmak için iki alanı birlikte doldurun; diğer kanallar yine ayrı bulunur.</p><label for="binding-device" class="form-label">Sistemdeki cihaz kimliği (isteğe bağlı)</label><input id="binding-device" class="form-control" @bind="_bindingDeviceId" @bind:event="oninput" placeholder="Örn: govde-ivme-1" /><label for="binding-stream" class="form-label mt-2">Yayındaki sensör / kanal kodu (isteğe bağlı)</label><input id="binding-stream" class="form-control" @bind="_bindingStreamKey" @bind:event="oninput" placeholder="Örn: 004563/MARIE2 veya mqtt/temperature" /><p class="form-text">Özel eşleme için sistem/kanal kodu ve cihaz kimliği birlikte girilir. MQTT’de tek bir yayın adresi kullanın; # veya + ile toplu dinleme için bu alanları boş bırakın.</p></details></div> }
                  </div><p class="dy-subtle mt-3">@(HasManualSensorBinding ? "Özel eşleme ve bağlantı kaydedilir. Bu kaynaktaki diğer sensörler otomatik bulunmaya devam eder." : "Kimlik bilgisi girmeniz gerekmez. Şimdi bağlantı kaydedilir; saha çalışıp uyumlu veri geldiğinde sensörler ayrı ayrı listelenir. Kaynağın tamamı için tek bir sensör oluşturulmaz.")</p>
                  @if(_pendingPos.HasValue && !HasManualSensorBinding){<p class="form-text">Tıkladığınız nokta bütün bağlantıya atanmaz. Sensörler bulunduğunda her birini görselde ayrı yerleştirebilirsiniz.</p>}

                }
                @if (_sensorSourceKind == "camera") { <CameraSettingsEditor Settings="_setupCameraDraft" AllowAdd="false" /> }
                @if (_sensorSourceKind is "udp" or "mqtt" or "camera") {
                  @if (!string.IsNullOrEmpty(_saveError)) { <div class="alert alert-danger" role="alert">@_saveError</div> }
                  <div class="d-flex gap-2 mt-3"><button class="btn btn-primary" @onclick="SaveConfiguredSourceAsync" disabled="@(_setupSaving || !CanSaveConfiguredSource)">@SourceSaveLabel</button><button class="btn btn-outline-secondary" @onclick="CloseSensorPopup">Vazgeç</button></div>
                }
            }
            @* ── TCP/IP sensörü ekle ── *@
            @if (_addSensorTab == "tcp" && (!_isWizardSensorMode || _sensorSourceKind == "tcp"))
            {
                <div class="alert alert-info border small mb-3 py-3">
                    <div class="fw-semibold mb-1">Cihazın bağlantısını kontrol edin, sonra sensörü kaydedin.</div>
                    Test cihazdan veri alınıp alınamadığını gösterir. Kaydetmek, sensörü bu baraja bağlar; veri toplama ayrı başlatılır.
                </div>

                <div class="alert alert-light border small d-flex align-items-center gap-2 mb-3 py-2">
                    <span class="bi bi-crosshair text-primary"></span>
                    @(_pendingPos.HasValue ? "Görselde bir konum seçildi." : "Görsel konumu seçilmedi. Daha sonra konumlandırabilirsiniz.")
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Sensör Adı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="_tcpSensorName" @bind:event="oninput" placeholder="Örn: Gövde su seviyesi" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Sensör Tipi <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="_tcpSensorType">
                            <option value="">— Seçiniz —</option>
                            @foreach (var sensorType in Enum.GetValues<SensorType>())
                            {
                                <option value="@sensorType.ToString()">@GetSensorTypeLabel(sensorType.ToString())</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="form-label">Cihazın ağ adresi <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="_tcpIpAddress" @bind:event="oninput" placeholder="192.168.1.100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Bağlantı numarası <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" @bind="_tcpPort" @bind:event="oninput" placeholder="502" min="1" max="65535" />
                    </div>
                </div>

                <details class="dy-technical"><summary>Teknik bağlantı ayrıntıları (isteğe bağlı)</summary><p class="dy-subtle">Cihazı kuran kişinin önerdiği veri biçimini kullanın. Adres veya veri biçimi değişirse bağlantı testi yenilenir.</p>                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="form-label">Cihaz veri biçimi</label>
                        <select class="form-select" @bind="_tcpProfile">
                            <option value="GenericTcp">Generic TCP</option>
                            <option value="JsonTcp">JSON TCP</option>
                            <option value="CsvTcp">CSV TCP</option>
                            <option value="ModbusTcp">Modbus TCP</option>
                            <option value="Unknown">Unknown</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Teknik cihaz kimliği</label>
                        <input type="text" class="form-control" @bind="_tcpDeviceId" placeholder="Örn: DEV001" />
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="form-label">Yanıt bekleme süresi (ms)</label>
                        <input type="number" class="form-control" @bind="_tcpTimeout" min="100" max="60000" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ölçüm okuma aralığı (ms)</label>
                        <input type="number" class="form-control" @bind="_tcpPollInterval" min="100" max="60000" />
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="form-label">Veri kodlaması</label>
                        <select class="form-select" @bind="_tcpEncoding">
                            <option value="utf-8">UTF-8</option>
                            <option value="ascii">ASCII</option>
                            <option value="hex">HEX</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Kesilirse yeniden bağlan</label>
                        <select class="form-select" @bind="_tcpReconnectEnabled">
                            <option value="true">Evet</option>
                            <option value="false">Hayır</option>
                        </select>
                    </div>
                </div>

                <div class="mt-3">
                                <label class="form-label">Açıklama</label>
                                <textarea class="form-control" @bind="_tcpDescription" rows="2" placeholder="İsteğe bağlı notlar..."></textarea>
                            </div>

                            @if (!_isWizardSensorMode) { <div class="mt-3">
                                <label class="form-label">Veri alanı eşlemesi (JSON)</label>
                                <textarea class="form-control" @bind="_tcpMappingsJson" rows="4" placeholder='[{"FieldName":"temperature","SourceKey":"reg0","DataType":"float32","Scale":0.1}]'></textarea>
                                <div class="form-text">Opsiyonel. Cihaz verisini mantıksal alanlara eşlemek için JSON dizi formatında mapping girin.</div>
                </div> }

                </details>
                @if (_tcpDiscoveryResult is not null && _tcpDiscoveryResult.Count > 0)
                {
                    <div class="alert alert-info mt-3 py-2 small">
                        <div class="fw-semibold mb-1">Bulunan metrikler</div>
                        <div>@string.Join(", ", _tcpDiscoveryResult)</div>
                    </div>
                }
                else if (_tcpConnectionTestSucceeded)
                {
                    <div class="alert alert-success mt-3 py-2 small">
                        TCP bağlantısı başarılı. Bu yanıtta metrik bulunmadı; cihaz veri göndermiyorsa mapping'i daha sonra ekleyebilirsiniz.
                    </div>
                }

                @if (!string.IsNullOrEmpty(_saveError))
                {
                    <div class="alert alert-danger mt-2 py-2 small">@_saveError</div>
                }

                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-outline-primary" disabled="@(string.IsNullOrWhiteSpace(_tcpIpAddress) || !_tcpPort.HasValue || _isSaving)"
                            @onclick="TestTcpConnectionAsync">
                        <span class="bi bi-plug me-1"></span>Cihaz bağlantısını kontrol et
                    </button>
                    <button class="btn btn-success" disabled="@(string.IsNullOrWhiteSpace(_tcpSensorName) || string.IsNullOrWhiteSpace(_tcpSensorType) || string.IsNullOrWhiteSpace(_tcpIpAddress) || !_tcpPort.HasValue || !HasCurrentTcpConnectionTest || _isSaving)"
                            @onclick="SaveTcpSensorAsync">
                        @if (_isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <span class="bi bi-check-lg me-1"></span>Sensörü kaydet
                    </button>
                    <button class="btn btn-secondary" @onclick="CloseSensorPopup">İptal</button>
                </div>
            }
        </div>
    </div>
}

@* ══════════════════════════════════════════════════════════════════
   YAPI BİLGİ DÜZENLEME POPUP
   ══════════════════════════════════════════════════════════════════ *@
@if (_showEditPopup && _editingStructure != null)
{
    <div class="popup-overlay" @onclick="CloseEditPopup"></div>
    <div class="sensor-add-popup">
        <div class="sensor-add-popup-header edit-popup-header">
            <span><span class="bi bi-pencil me-2"></span>Yapı Bilgilerini Düzenle</span>
            <button style="background:none;border:none;color:rgba(255,255,255,0.8);font-size:20px;cursor:pointer;padding:0 4px"
                    @onclick="CloseEditPopup">&times;</button>
        </div>
        <div class="sensor-add-popup-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Yapı Adı</label>
                    <input class="form-control" @bind="_editName" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Yapı Tipi</label>
                    <select class="form-select" @bind="_editType">
                        @foreach (var st in AvailableStructureTypes)
                        {
                            <option value="@st.Key">@st.Value.Label</option>
                        }
                    </select>
                    <div class="mt-2 text-center">
                        <img src="@GetStructureImagePath(_editType)"
                             style="height:72px;max-width:100%;object-fit:contain;border-radius:6px;background:#f0f4f8;padding:4px"
                             alt="@_structureTypes[_editType].Label"
                             onerror="this.style.visibility='hidden'" />
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">Açıklama</label>
                    <input class="form-control" @bind="_editDescription" />
                </div>
                <div class="col-12">
                    <label class="form-label"><span class="bi bi-hdd-network me-1"></span>Saha Edge URL</label>
                    <input class="form-control" @bind="_editEdgeApiUrl" />
                    <div class="form-text">Çalıştır/Durdur çağrıları bu URL'deki Edge'e gider.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Edge Config JSON</label>
                    <textarea class="form-control font-monospace" rows="5" @bind="_editEdgeConfigJson"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Saha .env JSON</label>
                    <textarea class="form-control font-monospace" rows="5" @bind="_editSiteEnvironmentJson"></textarea>
                </div>
                @if (EditCameraPipelineSelected)
                {
                    <div class="col-12"><CameraSettingsEditor Settings="_editCameraSettings" /></div>
                }
