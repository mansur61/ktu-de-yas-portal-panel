    /// <summary>
    /// TCP/IP Sekmesinden sensör ekle
    /// </summary>
    private async Task TestTcpConnectionAsync()
    {
        if (string.IsNullOrWhiteSpace(_tcpIpAddress) || !_tcpPort.HasValue)
        {
            _saveError = "IP ve port alanlarını doldurunuz.";
            return;
        }

        _saveError = null;
        _isSaving = true;
        try
        {
            if (!TryParseTcpMappings(out var mappings))
                return;

            var request = new TcpSensorCreateRequest
            {
                Name = _tcpSensorName,
                DeviceId = string.IsNullOrWhiteSpace(_tcpDeviceId) ? _tcpSensorName : _tcpDeviceId,
                SensorType = _tcpSensorType,
                Profile = _tcpProfile,
                Encoding = _tcpEncoding,
                ReconnectEnabled = _tcpReconnectEnabled,
                IpAddress = _tcpIpAddress,
                Port = _tcpPort.Value,
                TimeoutMs = _tcpTimeout ?? 5000,
                PollingIntervalMs = _tcpPollInterval ?? 1000,
                Description = _tcpDescription,
                ConnectionMode = "Client",
                Mappings = mappings
            };

            var result = System.Text.Json.JsonSerializer.SerializeToElement(await StructureUC.TestTcpConnectionAsync(request));
            _tcpConnectionTestSucceeded = result.TryGetProperty("succeeded", out var succeeded) && succeeded.GetBoolean();
            _tcpDiscoveryResult = result.TryGetProperty("discoveredMetricKeys", out var metrics) && metrics.ValueKind == System.Text.Json.JsonValueKind.Array
                ? metrics.EnumerateArray().Select(metric => metric.GetString()).Where(metric => !string.IsNullOrWhiteSpace(metric)).Select(metric => metric!).ToList()
                : new();
            _tcpTestEndpoint = _tcpConnectionTestSucceeded ? CurrentTcpEndpoint : null;
            if (!_tcpConnectionTestSucceeded)
                _saveError = result.TryGetProperty("error", out var error) && !string.IsNullOrWhiteSpace(error.GetString())
                    ? $"Bağlantı testi başarısız: {error.GetString()}"
                    : "Bağlantı testi başarısız oldu.";
        }
        catch (Exception ex)
        {
            _saveError = $"Bağlantı testi başarısız: {ex.Message}";
            _tcpConnectionTestSucceeded = false;
            _tcpDiscoveryResult = new();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveTcpSensorAsync()
    {
        if (string.IsNullOrWhiteSpace(_tcpSensorName) ||
            string.IsNullOrWhiteSpace(_tcpSensorType) ||
            string.IsNullOrWhiteSpace(_tcpIpAddress) ||
            !_tcpPort.HasValue)
        {
            _saveError = "Zorunlu alanları doldurunuz.";
            return;
        }

        if (!HasCurrentTcpConnectionTest)
        {
            _saveError = "Bu IP/port/profil için önce bağlantı ve metrik testi yapın.";
            return;
        }

        try
        {
            _isSaving = true;
            var sensorType = Enum.Parse<SensorType>(_tcpSensorType);
            var defaultMetrics = SensorMetricsConfiguration.GetMetrics(sensorType);
            var defaultUnit = SensorMetricsConfiguration.GetUnit(sensorType);

            if (!TryParseTcpMappings(out var mappings))
                return;

            var request = new TcpSensorCreateRequest
            {
                Name = _tcpSensorName,
                DeviceId = !string.IsNullOrWhiteSpace(_tcpDeviceId) ? _tcpDeviceId : _tcpSensorName,
                SensorType = _tcpSensorType,
                Profile = _tcpProfile,
                Encoding = _tcpEncoding,
                ReconnectEnabled = _tcpReconnectEnabled,
                IpAddress = _tcpIpAddress,
                Port = _tcpPort.Value,
                TimeoutMs = _tcpTimeout ?? 5000,
                PollingIntervalMs = _tcpPollInterval ?? 1000,
                Description = _tcpDescription,
                ConnectionMode = "Client",
                DiscoveredMetrics = _tcpDiscoveryResult,
                Mappings = mappings
            };

            if (_isWizardSensorMode && _createdStructureId != Guid.Empty)
            {
                var connected = await StructureUC.CreateConnectedSensorAsync(_createdStructureId, new ConnectedSensorRequest
                {
                    Name = request.Name,
                    DeviceId = request.DeviceId,
                    SensorType = request.SensorType,
                    Unit = defaultUnit,
                    Description = request.Description,
                    SensorLabel = request.Name,
                    SensorOrder = _newStructureSensors.Count,
                    IpAddress = request.IpAddress,
                    Port = request.Port,
                    Profile = request.Profile,
                    Encoding = request.Encoding,
                    TimeoutMs = request.TimeoutMs,
                    PollingIntervalMs = request.PollingIntervalMs,
                    ReconnectEnabled = request.ReconnectEnabled
                });
                _resumedTcpSettings[connected.DeviceId] = System.Text.Json.JsonSerializer.SerializeToElement(new {
                    host = request.IpAddress, port = request.Port, deviceId = connected.DeviceId, profile = request.Profile,
                    timeoutMs = request.TimeoutMs, pollingIntervalMs = request.PollingIntervalMs, encoding = request.Encoding
                });
                _newStructureSensors.Add(new Sensor
                {
                    Id = connected.SensorId, Name = connected.Name, DeviceId = connected.DeviceId,
                    SensorType = sensorType, ProtocolType = connected.ProtocolType,
                    IpAddress = connected.IpAddress, Port = connected.Port, TimeoutMs = request.TimeoutMs,
                    PollingIntervalMs = request.PollingIntervalMs, ImagePositionX = _pendingPos?.x,
                    ImagePositionY = _pendingPos?.y, Unit = defaultUnit, Metrics = defaultMetrics
                });
                _sourceTcp = true;
                UpdateSourceSelection();
                SetEnv("DEYAS_BRIDGE_TCP_SOURCES", BuildTcpSourcesJson());
                await SaveFieldSetupAsync();
                if (string.IsNullOrEmpty(_saveError)) AdvanceSourceBatch();
                return;
            }

            var createdSensor = await StructureUC.CreateTcpSensorAsync(request);

            var newSensor = new Sensor
            {
                Id = createdSensor.Id,
                Name = createdSensor.Name,
                DeviceId = createdSensor.DeviceId,
                SensorType = createdSensor.SensorType,
                Description = createdSensor.Description,
                ProtocolType = createdSensor.ProtocolType,
                IpAddress = createdSensor.IpAddress,
                Port = createdSensor.Port,
                TimeoutMs = createdSensor.TimeoutMs,
                PollingIntervalMs = createdSensor.PollingIntervalMs,
                Topic = createdSensor.Topic,
                Unit = createdSensor.Unit,
                Metrics = createdSensor.Metrics,
                ImagePositionX = _pendingPos?.x,
                ImagePositionY = _pendingPos?.y,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            if (_isWizardSensorMode)
            {
                _newStructureSensors.Add(newSensor);
            }
            else
            {
                if (_editingStructure == null) return;
                var sensorIds = _editingStructure.Sensors?.Select(x => x.SensorId).ToList() ?? new();
                sensorIds.Add(createdSensor.Id);
                await StructureUC.UpdateAsync(_editingStructure.Id, _editingStructure, sensorIds);
                _detailImageInitialized = false;
                await OpenStructureDetail(_editingStructure.Id);
            }

            CloseSensorPopup();
        }
        catch (Exception ex)
        {
            _saveError = $"Sensör kaydedilemedi: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// TCP/IP Sensör Form'unu sıfırla
    /// </summary>
    private void ResetTcpSensorForm()
    {
        _tcpSensorName = string.Empty;
        _tcpSensorType = string.Empty;
        _tcpIpAddress = string.Empty;
        _tcpPort = null;
        _tcpProfile = "GenericTcp";
        _tcpDeviceId = string.Empty;
        _tcpTimeout = 5000;
        _tcpPollInterval = 1000;
        _tcpDescription = string.Empty;
        _tcpEncoding = "utf-8";
        _tcpReconnectEnabled = true;
        _tcpConnectionTestSucceeded = false;
        _tcpTestEndpoint = null;
        _tcpDiscoveryResult = new();
        _tcpMappingsJson = string.Empty;
    }

    private string CurrentTcpEndpoint => $"{_tcpIpAddress.Trim()}:{_tcpPort}:{_tcpProfile}:{_tcpEncoding}";
    private bool HasCurrentTcpConnectionTest => _tcpConnectionTestSucceeded && _tcpTestEndpoint == CurrentTcpEndpoint;

    private bool TryParseTcpMappings(out List<SensorMapping>? mappings)
    {
        mappings = null;
        if (string.IsNullOrWhiteSpace(_tcpMappingsJson))
            return true;

        try
        {
            mappings = System.Text.Json.JsonSerializer.Deserialize<List<SensorMapping>>(_tcpMappingsJson, new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });
        }
        catch (System.Text.Json.JsonException ex)
        {
            _saveError = $"Mappings JSON hatalı: {ex.Message}";
            return false;
        }

        if (mappings == null)
            return true;

        mappings = mappings
            .Where(m => !string.IsNullOrWhiteSpace(m.FieldName) && !string.IsNullOrWhiteSpace(m.SourceKey))
            .ToList();

        return true;
    }

    // ── Prod lifecycle helper'ları ─────────────────────────────────────────────

    /// <summary>
    /// Çalıştır butonunun disabled durumunu hesaplar.
    /// Dev modunda: sensör yoksa pasif.
    /// Prod modunda: EdgeApiUrl varsa (UDP sensörler) VEYA TCP ready sensör varsa aktif.
    /// </summary>
    private bool GetStartDisabled(Structure s)
    {
        if (s.SensorCount == 0) return true;
        if (!_isProdMode) return false;
        // EdgeApiUrl tanımlıysa UDP/MQTT sensörler çalışabilir — TCP lifecycle şartı aranmaz
        if (!string.IsNullOrWhiteSpace(s.EdgeApiUrl)) return false;
        // EdgeApiUrl yoksa TCP kayıtlı hazır sensör gerekir
        return !s.CanStart;
    }

    /// <summary>
    /// Çalıştır butonunun tooltip metnini hesaplar.
    /// </summary>
    private string GetStartTooltip(Structure s)
    {
        if (s.SensorCount == 0)
            return "Yapıya bağlı sensör bulunmuyor.";

        if (!_isProdMode)
            return "Yapıyı çalıştır (Dev modu — simülasyon)";

        if (!string.IsNullOrWhiteSpace(s.EdgeApiUrl))
            return $"Saha Edge üzerinden çalıştır: {s.EdgeApiUrl}";

        if (!s.CanStart)
        {
            var reasons = new List<string>();
            if (s.ConnectionPendingSensorCount > 0)
                reasons.Add($"{s.ConnectionPendingSensorCount} bağlantı testi eksik");
            if (s.ParserPendingSensorCount > 0)
                reasons.Add($"{s.ParserPendingSensorCount} parser doğrulaması eksik");
            if (s.MetricPreviewPendingCount > 0)
                reasons.Add($"{s.MetricPreviewPendingCount} metrik önizleme eksik");
            return reasons.Count > 0
                ? "TCP sensör hazır değil: " + string.Join(", ", reasons)
                : "Çalıştırılmaya hazır TCP sensör bulunmuyor.";
        }

        return $"{s.StartableSensorCount} hazır sensör çalıştırılacak." +
               (s.NotReadySensorCount > 0 ? $" {s.NotReadySensorCount} sensör atlanacak." : "");
    }

    // ── Prod partial-start result modal ───────────────────────────────────────
    private bool _showProdStartResult;
    private DeYas.Contracts.Sensors.ProductionStartResultDto? _lastProdStartResult;

    private void CloseProdStartResult() => _showProdStartResult = false;

    // ── Dispose ───────────────────────────────────────────────────────────────
    public async ValueTask DisposeAsync()
    {
        _timerCts?.Cancel();
        _clickTimer?.Dispose();
        _timerCts?.Dispose();
        try { await JS.InvokeVoidAsync("disconnectSensorHub"); } catch { }
        try { await JS.InvokeVoidAsync("destroyMap"); } catch { }
    }
}
