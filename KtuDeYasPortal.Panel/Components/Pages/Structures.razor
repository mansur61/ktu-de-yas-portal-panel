    private static string? NormalizeJson(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        using var document = System.Text.Json.JsonDocument.Parse(value);
        return document.RootElement.GetRawText();
    }

        private static string ResolveStructurePlaceholders(string value, Structure structure) =>
                value.Replace("{structureId}", structure.Id.ToString(), StringComparison.OrdinalIgnoreCase)
                         .Replace("{structureName}", structure.Name, StringComparison.OrdinalIgnoreCase)
                         .Replace("{structureType}", structure.StructureType.ToString(), StringComparison.OrdinalIgnoreCase)
                         .Replace("{province}", structure.Province, StringComparison.OrdinalIgnoreCase)
                         .Replace("{district}", structure.District ?? string.Empty, StringComparison.OrdinalIgnoreCase);

                private string BuildEdgeConfigJson(Structure structure) =>
                    System.Text.Json.JsonSerializer.Serialize(new
                    {
                        id = structure.Id,
                        name = structure.Name,
                        description = structure.Description ?? string.Empty,
                        structureType = structure.StructureType.ToString(),
                        province = structure.Province,
                        district = structure.District,
                        latitude = structure.Latitude,
                        longitude = structure.Longitude,
                        address = structure.Address,
                        apiBaseUrl = GetEnv("CENTRAL_TIMESERIES_API_BASE_URL").Trim(),
                        nodeRedUrl = structure.NodeRedUrl,
                        edgeApiUrl = structure.EdgeApiUrl,
                        autoRegister = _newAutoRegister,
                        isActive = structure.IsActive
                    }, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });

                private string BuildSiteEnvironmentJson() =>
                    System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string?>(_siteEnvironment)
                    {
                        ["STRUCTURE_ID"] = _createdStructureId == Guid.Empty ? null : _createdStructureId.ToString(),
                        ["STRUCTURE_TYPE"] = _setupStructureType,
                        ["STRUCTURE_NAME"] = _setupName.Trim(),
                        ["STRUCTURE_SLUG"] = ToStructureSlug(_setupName),
                        ["DEYAS_BRIDGE_STRUCTURE_ID"] = _createdStructureId == Guid.Empty ? null : _createdStructureId.ToString(),
                        ["DEYAS_BRIDGE_TCP_SOURCES"] = BuildTcpSourcesJson()
                    }, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });

                private string GetEnv(string key) => _siteEnvironment.TryGetValue(key, out var value) ? value ?? string.Empty : string.Empty;
                private void SetEnv(string key, string? value) => _siteEnvironment[key] = value ?? string.Empty;

                private string BuildSiteEnvironmentEnv()
                {
                    var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                    {
                        ["STRUCTURE_ID"] = _createdStructureId.ToString(),
                        ["STRUCTURE_TYPE"] = _setupStructureType.ToLowerInvariant(),
                        ["STRUCTURE_SLUG"] = ToStructureSlug(_setupName),
                        ["STRUCTURE_NAME"] = _setupName.Trim(),
                        ["DEYAS_BRIDGE_STRUCTURE_ID"] = _createdStructureId.ToString(),
                        ["DEYAS_BRIDGE_TCP_SOURCES"] = BuildTcpSourcesJson()
                    };

                    foreach (var field in SiteEnvironmentFields)
                        values[field.Key] = field.Key == "DEYAS_BRIDGE_TCP_SOURCES" ? BuildTcpSourcesJson() : GetEnv(field.Key);

                    var templatePath = Path.Combine(AppContext.BaseDirectory, "DeploymentTemplates", "saha-deployment", ".env.template");
                    var lines = File.Exists(templatePath) ? File.ReadAllLines(templatePath).ToList() : [];
                    var emitted = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    for (var index = 0; index < lines.Count; index++)
                    {
                        var separator = lines[index].IndexOf('=');
                        if (separator <= 0 || lines[index].TrimStart().StartsWith('#')) continue;
                        var key = lines[index][..separator].Trim();
                        if (!values.TryGetValue(key, out var value)) continue;
                        lines[index] = $"{key}={value}";
                        emitted.Add(key);
                    }

                    foreach (var (key, value) in values.Where(pair => !emitted.Contains(pair.Key)))
                        lines.Add($"{key}={value}");

                    return string.Join(Environment.NewLine, lines) + Environment.NewLine;
                }

                private static string ToStructureSlug(string name)
                {
                    var normalized = System.Text.RegularExpressions.Regex.Replace(name.Trim().ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');
                    return string.IsNullOrWhiteSpace(normalized) ? "saha-yapisi" : normalized;
                }

                private string NormalizeMediaConfigJson()
                {
                    try { return NormalizeJson(_mediaConfigJson) ?? DefaultMediaConfigJson; }
                    catch { return DefaultMediaConfigJson; }
                }

                private string BuildUdpSourcesJson() => System.Text.Json.JsonSerializer.Serialize(
                    _newStructureSensors
                        .Where(sensor => !IsTcpSensor(sensor) && !string.IsNullOrWhiteSpace(sensor.IpAddress) && sensor.Port.HasValue)
                        .Select(sensor => new { host = sensor.IpAddress, port = sensor.Port })
                        .ToList());

                private string BuildTcpSourcesJson() => System.Text.Json.JsonSerializer.Serialize(
                    _newStructureSensors
                        .Where(sensor => IsTcpSensor(sensor) && !string.IsNullOrWhiteSpace(sensor.IpAddress) && sensor.Port.HasValue)
                        .Select(sensor => new
                        {
                            host = sensor.IpAddress,
                            port = sensor.Port,
                            deviceId = sensor.DeviceId,
                            profile = string.IsNullOrWhiteSpace(sensor.ProtocolType) ? "GenericTcp" : sensor.ProtocolType,
                            timeoutMs = sensor.TimeoutMs ?? 5000,
                            pollingIntervalMs = sensor.PollingIntervalMs,
                            encoding = "utf-8"
                        }).ToList());

                private static bool IsTcpSensor(Sensor sensor) => sensor.ProtocolType.Contains("tcp", StringComparison.OrdinalIgnoreCase)
                    || sensor.ProtocolType.Contains("modbus", StringComparison.OrdinalIgnoreCase);

