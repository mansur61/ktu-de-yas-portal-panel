    private static string? NormalizeJson(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        using var document = System.Text.Json.JsonDocument.Parse(value);
        return document.RootElement.GetRawText();
    }

    private static string StripDeploymentSecrets(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return value;
        try
        {
            var values = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, System.Text.Json.JsonElement>>(value);
            if (values is null) return value;
            values.Remove("DEYAS_BRIDGE_SOURCE_MQTT_USERNAME");
            values.Remove("DEYAS_BRIDGE_SOURCE_MQTT_PASSWORD");
            values.Remove("CENTRAL_MQTT_USERNAME");
            values.Remove("CENTRAL_MQTT_PASSWORD");
            values.Remove("DEYAS_JWT_SIGNING_KEY");
            values.Remove("DEYAS_BRIDGE_MQTT_CREDENTIALS");
            foreach (var key in values.Keys.Where(key => key.StartsWith("DEYAS_SOURCE_", StringComparison.Ordinal)).ToList()) values.Remove(key);
            return System.Text.Json.JsonSerializer.Serialize(values, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (System.Text.Json.JsonException) { return value; }
    }

