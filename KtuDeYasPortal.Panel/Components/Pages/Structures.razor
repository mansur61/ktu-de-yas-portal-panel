                    return System.Text.Json.JsonSerializer.Serialize(values, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
                }

                private string GetEnv(string key) => _siteEnvironment.TryGetValue(key, out var value) ? value ?? string.Empty : string.Empty;
                private void SetEnv(string key, string? value) => _siteEnvironment[key] = value ?? string.Empty;

                private string BuildSiteEnvironmentEnv()
                {
                    var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                    {
                        ["STRUCTURE_ID"] = _createdStructureId.ToString(),
                        ["STRUCTURE_TYPE"] = _setupStructureType.ToLowerInvariant(),
                        ["STRUCTURE_SLUG"] = ToStructureSlug(_setupName),
                        ["STRUCTURE_NAME"] = _setupName.Trim(),
                        ["DEYAS_BRIDGE_STRUCTURE_ID"] = _createdStructureId.ToString(),
                        ["DEYAS_BRIDGE_TCP_SOURCES"] = BuildTcpSourcesJson()
                    };

                    foreach (var field in SiteEnvironmentFields)
                        values[field.Key] = field.Key == "DEYAS_BRIDGE_TCP_SOURCES" ? BuildTcpSourcesJson() : GetEnv(field.Key);

                    values["DEYAS_BRIDGE_MQTT_CREDENTIALS"]=System.Text.Json.JsonSerializer.Serialize(MqttConnections().ToDictionary(source=>source.Id,source=>new {username=_deploymentSecrets.GetValueOrDefault(source.UsernameEnv,""),password=_deploymentSecrets.GetValueOrDefault(source.PasswordEnv,"")}),SourceJson);
                    values["DEYAS_BRIDGE_MQTT_CREDENTIALS"] = "'" + values["DEYAS_BRIDGE_MQTT_CREDENTIALS"] + "'";
                    foreach (var camera in _cameraSettings.Cameras.Where(camera => camera.SourceType == "rtsp"))
                        values[camera.SourceEnvironment] = "'" + camera.SourceValue.Replace("'", "\\'") + "'";
                    foreach (var (key, value) in _deploymentSecrets)
                        values[key] = value;
                    foreach (var (key, value) in _localDeploymentSecrets)
                        values[key] = value;

                    if (_samePcDeployment)
                    {
                        values["EMQX_MQTT_HOST_PORT"] = _samePcMqttPort.ToString();
                        values["EMQX_DASHBOARD_HOST_PORT"] = _samePcEmqxDashboardPort.ToString();
                        values["TIMESCALEDB_HOST_PORT"] = _samePcTimescaleDbPort.ToString();
                        values["TIMESERIES_HOST_PORT"] = _samePcTimeseriesPort.ToString();
                        values["NODERED_HOST_PORT"] = _samePcNodeRedPort.ToString();
                        values["EDGE_API_HOST_PORT"] = _samePcEdgePort.ToString();
                    }

                    var templatePath = Path.Combine(AppContext.BaseDirectory, "DeploymentTemplates", "saha-deployment", ".env.template");
                    var lines = File.Exists(templatePath) ? File.ReadAllLines(templatePath).ToList() : [];
                    var emitted = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    // MQTT_CREDENTIALS template'de yorum satırı olarak bulunur;
                    // panel dolduruyor ama sona düz değer olarak eklenmemeli.
                    emitted.Add("DEYAS_BRIDGE_MQTT_CREDENTIALS");
                    // Saha compose'unda kullanılmayan gereksiz image key'leri
                    foreach (var unusedKey in new[] { "PANEL_IMAGE","PORTAL_IMAGE","AUTH_IMAGE","VIDEO_SERVICE_IMAGE",
                        "MEDIA_UPLOAD_IMAGE","MEDIA_PROCESSING_IMAGE","RETENTION_IMAGE",
                        "ALERT_EVALUATOR_IMAGE","ALERT_NOTIFICATION_IMAGE" })
                        emitted.Add(unusedKey);
                    for (var index = 0; index < lines.Count; index++)
                    {
                        var separator = lines[index].IndexOf('=');
                        if (separator <= 0 || lines[index].TrimStart().StartsWith('#')) continue;
                        var key = lines[index][..separator].Trim();
                        if (!values.TryGetValue(key, out var value)) continue;
                        lines[index] = $"{key}={value}";
                        emitted.Add(key);
                    }

                    foreach (var (key, value) in values.Where(pair => !emitted.Contains(pair.Key)))
                        lines.Add($"{key}={value}");

                    return string.Join(Environment.NewLine, lines) + Environment.NewLine;
                }

                private static string ToStructureSlug(string name)
                {
                    var normalized = System.Text.RegularExpressions.Regex.Replace(name.Trim().ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');
                    return string.IsNullOrWhiteSpace(normalized) ? "saha-yapisi" : normalized;
                }

                private static string GenerateDeploymentSecret() =>
                    Convert.ToBase64String(System.Security.Cryptography.RandomNumberGenerator.GetBytes(24))
                        .Replace('+', '-').Replace('/', '_').TrimEnd('=');

