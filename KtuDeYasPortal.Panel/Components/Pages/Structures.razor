    private static string? BuildDeploymentPublicUrl(string? value, int? port)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (port is null || !Uri.TryCreate(value.Trim(), UriKind.Absolute, out var uri)) return value.Trim();
        var builder = new UriBuilder(uri) { Port = port.Value };
        return builder.Uri.GetLeftPart(UriPartial.Authority);
    }

