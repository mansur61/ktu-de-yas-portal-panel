@page "/structures"
@rendermode InteractiveServer
@using DeYas.Contracts.Sensors
@using DeYas.Contracts.Simulation
@using DeYas.Contracts.Integration
@inject StructureUseCases StructureUC
@inject IStructureSimulationClient StructureSimClient
@inject ITimeseriesRepository TimeseriesRepo
@inject IConfiguration Configuration
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Baraj Yönetimi</PageTitle>

@* ══════════════════════════════════════════════════════════════════
   ANA SAYFA — Liste + Başlık
   ══════════════════════════════════════════════════════════════════ *@
@if (_editingStructure == null && !_showCreateWizard)
{
    @if (!string.IsNullOrWhiteSpace(_simulationStatusMessage))
    {
        <div class="alert @_simulationStatusAlertClass d-flex align-items-center gap-2 mb-3 py-2">
            <span class="bi @_simulationStatusIcon"></span>
            <div>@_simulationStatusMessage</div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_simulationErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2">
            <span class="bi bi-exclamation-triangle"></span>
            <div>@_simulationErrorMessage</div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 fw-bold">Baraj Yönetimi</h4>
            <small class="text-muted">Kayıtlı barajlar, sensörler ve konum bilgileri</small>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-outline-warning" @onclick="OpenCentralNodeRedAsync"
                    title="Merkez Node-RED — tüm yapıların MQTT akışını izler">
                <span class="bi bi-diagram-3-fill me-1"></span>Merkez Node-RED
            </button>

            <button class="btn btn-primary" @onclick="ShowCreateWizard">
                <span class="bi bi-plus-lg me-1"></span> Yeni Baraj
            </button>
        </div>
    </div>

    @if (_structures is null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Yükleniyor…</p>
        </div>
    }
    else if (_structures.Count == 0)
    {
        <div class="alert alert-info d-flex align-items-center gap-3">
            <span class="bi bi-info-circle-fill fs-4"></span>
            <div>Henüz baraj tanımlanmamış. <strong>Yeni Baraj</strong> butonuyla ekleyebilirsiniz.</div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var s in _structures)
            {
                <div class="col-sm-6 col-xl-4">
                    <div class="structure-card @(s.IsActive ? "" : "opacity-60")" @onclick="() => OpenStructureDetail(s.Id)">
                        @if (!string.IsNullOrEmpty(s.ImageUrl))
                        {
                            <img src="@s.ImageUrl" class="structure-card-img" alt="@s.Name" />
                        }
                        else
                        {
                            <div class="structure-card-img-placeholder">
                                <span>@GetStructureEmoji(s.StructureType)</span>
                            </div>
                        }
                        <div class="structure-card-body">
                            <div class="structure-card-title">@s.Name</div>
                            <div class="small text-secondary font-monospace mb-1">@s.Id</div>
                            <div class="structure-card-sub">
                                <span class="bi bi-geo-alt me-1"></span>
                                @s.Province@(string.IsNullOrEmpty(s.District) ? "" : " / " + s.District)
                            </div>
                            <div class="structure-card-badges">
                                <span class="badge" style="background:#6f42c1">@GetStructureLabel(s.StructureType)</span>
                                <span class="badge bg-primary">@s.SensorCount sensör</span>
                                @foreach (var sensorType in GetSensorTypeSummary(s))
                                {
                                    <span class="badge bg-light text-dark border">@sensorType</span>
                                }
                                @foreach (var runtimeSummary in GetDeviceRuntimeSummary(s))
                                {
                                    <span class="badge @(runtimeSummary.Passive > 0 ? "bg-warning text-dark" : "bg-light text-dark border")"
                                          title="Node-RED cihaz kontrolü Edge Layer'da anlık saklanır.">
                                        @runtimeSummary.Active aktif · @runtimeSummary.Passive pasif @runtimeSummary.Label
                                    </span>
                                }
                                @if (_localPipelineStates.TryGetValue(s.Id, out var localPipelineEnabled))
                                {
                                    <span class="badge @(localPipelineEnabled ? "bg-success" : "bg-danger")">
                                        <span class="bi @(localPipelineEnabled ? "bi-broadcast" : "bi-stop-circle") me-1"></span>
                                        @(localPipelineEnabled ? "Saha yerel akış aktif" : "Saha yerel akış durduruldu")
                                    </span>
                                }
                                else if (s.IsActive)
                                { <span class="badge bg-success">Aktif</span> }
                                else
                                { <span class="badge bg-secondary">Pasif</span> }
                                @if (_forwardingStates.TryGetValue(s.Id, out var forwarding))
                                {
                                    <span class="badge @(forwarding ? "bg-info text-dark" : "bg-secondary")">
                                        @(forwarding ? "Merkeze iletim açık" : "Merkeze iletim kapalı")
                                    </span>
                                }
                                @* Prod lifecycle özeti — yalnızca prod modda göster *@
                                @if (_isProdMode && s.TotalSensorCount > 0)
                                {
                                    <span class="badge @(s.CanStart ? "bg-success" : "bg-warning text-dark")"
                                          title="Ready: @s.ReadySensorCount / @s.TotalSensorCount">
                                        ✓ @s.ReadySensorCount / @s.TotalSensorCount
                                    </span>
                                    @if (s.ConnectionPendingSensorCount > 0)
                                    {
                                        <span class="badge bg-danger" title="@s.ConnectionPendingSensorCount bağlantı testi eksik">
                                            🔌 @s.ConnectionPendingSensorCount
                                        </span>
                                    }
                                    @if (s.ParserPendingSensorCount > 0)
                                    {
                                        <span class="badge bg-warning text-dark" title="@s.ParserPendingSensorCount parser doğrulaması eksik">
                                            ⚙️ @s.ParserPendingSensorCount
                                        </span>
                                    }
                                    @if (s.MetricPreviewPendingCount > 0)
                                    {
                                        <span class="badge bg-secondary" title="@s.MetricPreviewPendingCount metrik önizleme eksik">
                                            📊 @s.MetricPreviewPendingCount
                                        </span>
                                    }
                                }
                            </div>
                            <div class="small text-secondary mt-2 text-truncate" title="@(string.IsNullOrWhiteSpace(s.EdgeApiUrl) ? "Saha Edge URL henüz kaydedilmedi." : s.EdgeApiUrl)">
                                <span class="bi bi-hdd-network me-1"></span>@(string.IsNullOrWhiteSpace(s.EdgeApiUrl) ? "Saha Edge URL tanımsız" : s.EdgeApiUrl)
                                <span class="bi bi-info-circle ms-1" title="Çalıştır/Durdur yerel saha pipeline'larını; Aktar kontrolleri merkez iletimini yönetir."></span>
                            </div>
                            @if (_forwardingStates.TryGetValue(s.Id, out var knownForwarding))
                            {
                                <div class="small text-secondary font-monospace text-truncate" title="Son lifecycle komutu">
                                    Merkeze aktarım: @(knownForwarding ? "açık" : "kapalı")
                                </div>
                            }
                            <div class="mt-3 d-flex justify-content-end gap-2">
                                @if (IsLocalPipelineEnabled(s.Id))
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => StopStructureSimulationAsync(s.Id)"
                                            @onclick:stopPropagation="true"
                                            disabled="@_stoppingStructureIds.Contains(s.Id)">
                                        @if (_stoppingStructureIds.Contains(s.Id))
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        else
                                        {
                                            <span class="bi bi-stop-fill me-1"></span>
                                        }
                                        Durdur
                                    </button>
                                }
                                <button class="btn btn-sm btn-success"
                                        @onclick="() => StartStructureSimulationAsync(s.Id)"
                                        @onclick:stopPropagation="true"
                                        disabled="@(_startingStructureIds.Contains(s.Id) || IsLocalPipelineEnabled(s.Id) || GetStartDisabled(s))"
                                        title="@GetStartTooltip(s)">
                                    @if (_startingStructureIds.Contains(s.Id))
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    else
                                    {
                                        <span class="bi bi-play-fill me-1"></span>
                                    }
                                    @if (s.SensorCount == 0)
                                    {
                                        <span>Sensör yok</span>
                                    }
                                    else if (_isProdMode && !s.CanStart && s.TotalSensorCount > 0)
                                    {
                                        <span>Hazır değil</span>
                                    }
                                    else
                                    {
                                        @(IsLocalPipelineEnabled(s.Id) ? "Çalışıyor" : "Çalıştır")
                                    }
                                </button>
                                <button class="btn btn-sm @( _forwardingStates.TryGetValue(s.Id, out var isForwardingActive) && isForwardingActive ? "btn-outline-secondary" : "btn-outline-primary")"
                                        @onclick="() => SetStructureForwardingAsync(s.Id, !(_forwardingStates.TryGetValue(s.Id, out var current) && current))"
                                        @onclick:stopPropagation="true"
                                        title="Yerel akışı değiştirmeden merkez aktarımını açar veya kapatır.">
                                    <span class="bi bi-cloud-arrow-@( _forwardingStates.TryGetValue(s.Id, out var state) && state ? "down" : "up") me-1"></span>
                                    @( _forwardingStates.TryGetValue(s.Id, out var enabled) && enabled ? "Aktarımı durdur" : "Aktar")
                                </button>
                                <button class="btn btn-sm btn-outline-warning"
                                        @onclick="() => OpenNodeRedAsync(s.Id, s.Name)"
                                        @onclick:stopPropagation="true"
                                        title="@(string.IsNullOrWhiteSpace(s.NodeRedUrl) ? "Merkez Node-RED Flow Editörü" : $"Flow Editörü: {s.NodeRedUrl}")">
                                    <span class="bi bi-diagram-3 me-1"></span>
                                    @if (string.IsNullOrWhiteSpace(s.NodeRedUrl))
                                    {
                                        <span class="text-muted">Node-RED</span>
                                    }
                                    else
                                    {
                                        <span>Node-RED ✦</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@* ══════════════════════════════════════════════════════════════════
   YENİ YAPI OLUŞTURMA — 3 ADIM
   ══════════════════════════════════════════════════════════════════ *@
<div class="create-structure-panel mb-4" hidden="@(!_showCreateWizard)">
        <div class="create-panel-header">
            <strong><span class="me-2">🏔️</span>Yeni Baraj Oluştur</strong>
            <button class="btn btn-sm btn-outline-light" @onclick="CancelCreate">İptal</button>
        </div>

        <div class="create-steps">
            <div class="create-step @(_wizardStep > 2 ? "done" : "active")">
                <div class="create-step-num">@(_wizardStep > 2 ? "✓" : "1")</div>
                <div>Bilgiler &amp; Konum</div>
            </div>
            <div class="create-step @(_wizardStep == 3 ? "active" : (_wizardStep > 3 ? "done" : ""))">
                <div class="create-step-num">@(_wizardStep > 3 ? "✓" : "2")</div>
                <div>Baraj-Saha Kurulumu</div>
            </div>
            <div class="create-step @(_wizardStep >= 4 ? "active" : "")">
                <div class="create-step-num">@(_wizardStep > 4 ? "✓" : "3")</div>
                <div>Sensör Ekle</div>
            </div>
            <div class="create-step @(_wizardStep == 5 ? "active" : "")">
                <div class="create-step-num">4</div>
                <div>Saha Deployment</div>
            </div>
        </div>

        <div class="p-4">
            @* ADIM 2 — Temel bilgiler. Bu alan görünürlükle yönetilir; Razor blok
               kapanışının sayfaya düz metin olarak düşmesini önler. *@
            <div hidden="@(_wizardStep != 2)">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Yapı Adı <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_newName" placeholder="Örn: Yusufeli Barajı" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Yapı Türü</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var type in AvailableStructureTypes)
                            {
                                var selected = _newType == type.Key;
                                <button type="button"
                                        class="btn @(selected ? "btn-primary" : "btn-outline-secondary") d-flex align-items-center gap-2"
                                        @onclick="() => SelectNewType(type.Key)">
                                    <img src="@type.Value.ImagePath" alt="@type.Value.Label" style="width:28px;height:28px;object-fit:contain" />
                                    <span>@type.Value.Label</span>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Durum</label>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" @bind="_newIsActive" id="chkActive" />
                            <label class="form-check-label" for="chkActive">Aktif</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Açıklama</label>
                        <input class="form-control" @bind="_newDescription" placeholder="Yapı hakkında kısa bir açıklama" />
                    </div>
                    @* ── Konum bilgileri de burada ── *@
                    <div class="col-12"><hr class="my-1" /><small class="text-muted fw-semibold">Konum Bilgileri</small></div>
                    <div class="col-md-4">
                        <label class="form-label">İl <span class="text-danger">*</span></label>
                        <select class="form-select" value="@_newProvince" @onchange="OnNewProvinceChanged">
                            <option value="">-- İl Seçin --</option>
                            @foreach (var p in _provinces)
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">İlçe</label>
                        <select class="form-select" value="@_newDistrict" @onchange="OnNewDistrictChanged"
                                disabled="@(string.IsNullOrEmpty(_newProvince))">
                            <option value="">-- İlçe Seçin --</option>
                            @foreach (var d in _newDistricts)
                            {
                                <option value="@d">@d</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Adres</label>
                        <input id="address-input" class="form-control" @bind="_newAddress" placeholder="Cadde / mahalle" />
                    </div>
                    @* ── Harita ── *@
                    <div class="col-12">
                        <label class="form-label">
                            <span class="bi bi-map me-1"></span>Konum Seç
                            <small class="text-muted fw-normal"> — Haritaya tıklayın ya da marker'ı sürükleyin</small>
                        </label>
                        <div id="new-map" class="map-container"></div>
                        <div class="row mt-2 g-2">
                            <div class="col-md-4">
                                <label class="form-label small">Enlem</label>
                                <input id="lat-input" type="number" class="form-control form-control-sm" @bind="_newLat" step="0.000001" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Boylam</label>
                                <input id="lng-input" type="number" class="form-control form-control-sm" @bind="_newLng" step="0.000001" />
                            </div>
                        </div>
                    </div>
                    @* ── Node-RED ── *@
                    <div class="col-12"><hr class="my-1" /><small class="text-muted fw-semibold">Node-RED Entegrasyonu</small></div>
                    <div class="col-12">
                        <label class="form-label">
                            <span class="bi bi-diagram-3 me-1"></span>Node-RED URL
                            @if (!string.IsNullOrWhiteSpace(_newNodeRedUrl))
                            {
                                <span class="badge bg-success ms-2" style="font-size:0.7rem">Otomatik atandı</span>
                            }
                            else
                            {
                                <small class="text-muted fw-normal"> — Boş bırakılırsa ortak instance kullanılır</small>
                            }
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <span class="bi bi-diagram-3@(!string.IsNullOrWhiteSpace(_newNodeRedUrl) ? "-fill text-success" : " text-muted")"></span>
                            </span>
                            <input class="form-control @(!string.IsNullOrWhiteSpace(_newNodeRedUrl) ? "bg-light" : "")"
                                   @bind="_newNodeRedUrl"
                                   readonly="@(!string.IsNullOrWhiteSpace(Configuration[$"NodeRed:PerStructureUrls:{_newType}"]))"
                                   placeholder="http://nodered-yapi-adi:1880 (opsiyonel)" />
                            @if (!string.IsNullOrWhiteSpace(_newNodeRedUrl))
                            {
                                <button class="btn btn-outline-secondary" type="button"
                                        title="Temizle — ortak instance kullanılır"
                                        @onclick="() => _newNodeRedUrl = string.Empty">
                                    <span class="bi bi-x-lg"></span>
                                </button>
                            }
                        </div>
                        <div class="form-text">
                            @if (!string.IsNullOrWhiteSpace(_newNodeRedUrl))
                            {
                                <span class="text-success"><span class="bi bi-check-circle me-1"></span>Bu yapı tipi için Node-RED instance'ı otomatik atandı.</span>
                            }
                            else
                            {
                                <span>Yapı tipini seçince otomatik dolar. Kubernetes'te özel pod varsa URL'i girin; Docker Compose'da <code>nodered-{yapı-slug}</code> kullanın.</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    @if (_createdStructureId == Guid.Empty)
                    {
                        <button class="btn btn-success" disabled="@(string.IsNullOrWhiteSpace(_newName) || string.IsNullOrEmpty(_newProvince) || _isSaving)"
                                @onclick="SaveStructureAndOpenSetupAsync">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <span class="bi bi-check-lg me-1"></span> Barajı Kaydet
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-success py-2 mb-0 me-auto">
                            <span class="bi bi-check-circle me-1"></span>Baraj kaydedildi: <code>@_createdStructureId</code>
                        </div>
                    }
                    <button class="btn btn-primary ms-auto"
                            disabled="@(_createdStructureId == Guid.Empty || _isSaving)"
                            @onclick="OpenSetupStep">
                        İleri: Baraj-Saha Kurulumu <span class="bi bi-arrow-right ms-1"></span>
                    </button>
                </div>
            </div>

            @* ADIM 3 — Yapı resmi üzerinde sensör ekleme *@
            <div hidden="@(_wizardStep != 3)">
                <div class="mb-3 d-flex align-items-center gap-3">
                    <div>
                        <strong>@_newName</strong>
                        <span class="badge ms-2" style="background:#6f42c1">@(_newType.HasValue ? GetStructureLabel(_newType.Value) : "")</span>
                        @if (!string.IsNullOrEmpty(_newProvince))
                        {
                            <span class="badge bg-info ms-1">@_newProvince@(string.IsNullOrEmpty(_newDistrict) ? "" : " / " + _newDistrict)</span>
                        }
                    </div>
                    <div class="ms-auto d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="BackFromStep3">
                            <span class="bi bi-arrow-left me-1"></span> Geri
                        </button>
                        <button class="btn btn-success" @onclick="() => _showSaveConfirm = true" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <span class="bi bi-check-lg me-1"></span> Tamamla &amp; Kaydet
                        </button>
                    </div>
                </div>
                <div class="card border-primary mb-3">
                    <div class="card-header bg-primary text-white">
                        <strong><span class="bi bi-hdd-network me-1"></span>Baraj-Saha Kurulumu</strong>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info py-2 small">
                            Yapı kaydedildi. <code>structureId</code> otomatik oluşturuldu; saha ayarları bu yapı ile ilişkilendirilecektir.
                            Bu alan yalnız UDP/GCF ve MQTT kaynaklarınız içindir. TCP/IP kaynakları için <strong>3. Sensör Ekle</strong> adımına geçin.
                        </div>
                        <ul class="nav nav-tabs mb-3">
                            <li class="nav-item">
                                <button class="nav-link @(_setupTab == "edge" ? "active" : "")" type="button" @onclick='() => _setupTab = "edge"'>Edge Config</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(_setupTab == "env" ? "active" : "")" type="button" @onclick='() => _setupTab = "env"'>Saha .env</button>
                            </li>
                        </ul>
                        @if (_setupTab == "edge")
                        {
                            <div class="row g-2">
                                <div class="col-md-6"><label class="form-label">Structure ID</label><input class="form-control" value="@_createdStructureId" readonly /></div>
                                <div class="col-md-6"><label class="form-label">Yapı Adı</label><input class="form-control" @bind="_setupName" /></div>
                                <div class="col-md-6"><label class="form-label">Yapı Tipi</label><input class="form-control" @bind="_setupStructureType" /></div>
                                <div class="col-md-6">
                                    <label class="form-label">Merkez Timeseries API URL</label>
                                    <input class="form-control bg-light" value="@GetEnv("CENTRAL_TIMESERIES_API_BASE_URL")" readonly />
                                    <div class="form-text">Bu değer Saha .env sekmesindeki <code>CENTRAL_TIMESERIES_API_BASE_URL</code> alanından alınır ve Edge Config'e otomatik yazılır.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Node-RED URL</label>
                                    <input class="form-control" @bind="_newNodeRedUrl" placeholder="http://100.116.167.67:1880" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Saha Edge API URL</label>
                                    <input class="form-control" @bind="_newEdgeApiUrl" placeholder="http://100.116.167.67:5080" />
                                </div>
                                <div class="col-md-6 d-flex align-items-end">
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" @bind="_newAutoRegister" id="chkAutoRegister" />
                                        <label class="form-check-label" for="chkAutoRegister">Saha açılışında otomatik kayıt</label>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (_setupTab == "env")
                        {
                            <div class="row g-3">
                                @foreach (var field in SiteEnvironmentFields)
                                {
                                    if (field.Key is "CAMERA_NORTH_RTSP_URL" or "CAMERA_ENTRY_RTSP_URL" && !IsCameraPipelineSelected)
                                        continue;
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">@field.Label</label>
                                        @if (field.Key is "CAMERA_NORTH_RTSP_URL" or "CAMERA_ENTRY_RTSP_URL")
                                        {
                                            if (IsCameraPipelineSelected)
                                            {
                                                <input class="form-control" value="@GetEnv(field.Key)" @onchange="e => SetEnv(field.Key, e.Value?.ToString())" placeholder="@field.Placeholder" />
                                            }
                                        }
                                        else if (field.Key == "DEYAS_BRIDGE_SENSOR_PROVISIONING_ENABLED")
                                        {
                                            <input class="form-control bg-light" value="true - yalnız ilk saha keşfi için" readonly />
                                            SetEnv(field.Key, "true");
                                        }
                                        else if (field.Key == "SAHA_ENABLED_PIPELINES")
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                <button type="button" class="btn btn-sm @(IsPipelineSelected("ivmeolcer") ? "btn-success" : "btn-outline-secondary")" @onclick='() => TogglePipeline("ivmeolcer")'>İvmeölçer</button>
                                                <button type="button" class="btn btn-sm @(IsPipelineSelected("kamera") ? "btn-success" : "btn-outline-secondary")" @onclick='() => TogglePipeline("kamera")'>Kamera</button>
                                                <button type="button" class="btn btn-sm @(IsPipelineSelected("lidar") ? "btn-success" : "btn-outline-secondary")" @onclick='() => TogglePipeline("lidar")'>Lidar</button>
                                            </div>
                                            <input class="form-control mt-2" value="@GetEnv(field.Key)" readonly aria-label="Seçilen aktif pipeline'lar" />
                                        }
                                        else if (field.Key == "DEYAS_BRIDGE_SOURCE_MODE")
                                        {
                                            <select class="form-select" value="@GetEnv(field.Key)" @onchange="e => SetEnv(field.Key, e.Value?.ToString())">
                                                <option value="udp">udp</option>
                                                <option value="mqtt">mqtt</option>
                                                <option value="tcp">tcp</option>
                                                <option value="both">both — yalnız UDP + MQTT</option>
                                                <option value="all">all — UDP + MQTT + TCP</option>
                                            </select>
                                        }
                                        else if (field.Key == "DEYAS_BRIDGE_UDP_SOURCES")
                                        {
                                            <textarea class="form-control font-monospace" rows="3" value="@GetEnv(field.Key)" @onchange="e => SetEnv(field.Key, e.Value?.ToString())"
                                                      placeholder='[{"host":"192.168.1.51","port":1567}]'></textarea>
                                        }
                                        else if (field.Key == "DEYAS_BRIDGE_TCP_SOURCES")
                                        {
                                            <textarea class="form-control font-monospace bg-light" rows="3" readonly>@BuildTcpSourcesJson()</textarea>
                                        }
                                        else
                                        {
                                            <input class="form-control" value="@GetEnv(field.Key)" @onchange="e => SetEnv(field.Key, e.Value?.ToString())" placeholder="@field.Placeholder" />
                                        }
                                        <div class="form-text">@field.Description</div>
                                    </div>
                                }
                                @if (IsCameraPipelineSelected)
                                {
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Kamera medya tanımı (<code>media-config.json</code>)</label>
                                    <textarea class="form-control font-monospace" rows="10" @bind="_mediaConfigJson"></textarea>
                                    <div class="form-text">Kamera yalnız <code>SAHA_ENABLED_PIPELINES</code> içinde <code>kamera</code> seçiliyken çalışır. RTSP URL/parolalarını buraya değil, ilgili <code>CAMERA_*</code> ortam değişkenlerine yazın.</div>
                                </div>
                                }
                            </div>
                        }
                        <div class="mt-3 d-flex flex-wrap gap-2 align-items-center">
                            <button class="btn btn-primary" @onclick="SaveFieldSetupAsync" disabled="@_setupSaving">Saha ayarlarını merkez DB'ye kaydet</button>
                            <span class="small text-muted">Edge yapılandırması ve saha <code>.env</code> değerleri bu yapının merkez kaydına saklanır; sahaya komut göndermez.</span>
                            @if (_wizardStep == 3)
                            {
                                <button class="btn btn-success ms-auto" @onclick="GoToSensorStep" disabled="@_setupSaving">
                                    Sensör Ekle adımına geç <span class="bi bi-arrow-right ms-1"></span>
                                </button>
                                <button class="btn btn-outline-success" @onclick="FinishWithoutSensorsAsync" disabled="@_setupSaving">
                                    Sensör eklemeden tamamla
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div hidden="@(_wizardStep != 4)">
                <div class="alert alert-info d-flex align-items-center gap-2 py-2 small mb-2">
                    <span class="bi bi-cursor-fill text-primary"></span>
                    Bu adım yalnız TCP/IP sensörleri içindir. Resme tıklayın, bağlantıyı test edin; bulunan metrikleri doğrulayın ve sensörü kaydedin. UDP/MQTT kaynakları önceki adımda tanımlanır.
                </div>
                @* Yapı resmi — JS tarafından doldurulur (initStructureImage), burada sadece container *@
                <div class="wizard-image-wrapper" id="wizard-image">
                    @* JS initStructureImage() bu div'in içini doldurur *@
                </div>
                @* Eklenen sensörler listesi *@
                @if (_newStructureSensors.Any())
                {
                    <div class="mt-3">
                        <h6 class="fw-semibold mb-2"><span class="bi bi-cpu me-1"></span>Eklenen Sensörler (@_newStructureSensors.Count)</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="table-dark">
                                    <tr><th>#</th><th>Tip</th><th>Ad</th><th>Device ID</th><th>Topic</th><th>Metrikler</th><th>Telemetri</th><th>X/Y</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < _newStructureSensors.Count; i++)
                                    {
                                        var idx = i;
                                        var s = _newStructureSensors[idx];
                                        var icon = _sensorTypeInfos.TryGetValue(s.SensorType.ToString(), out var ti) ? ti.Emoji : "🔘";
                                        <tr>
                                            <td>@(idx + 1)</td>
                                            <td><span title="@s.SensorType">@icon</span></td>
                                            <td>@s.Name</td>
                                            <td><code style="font-size:0.75rem">@s.DeviceId</code></td>
                                            <td><small class="font-monospace">@s.Topic</small></td>
                                            <td>
                                                @{var wMetrics = !string.IsNullOrWhiteSpace(s.Metrics) ? s.Metrics : s.Description;}
                                                @foreach (var m in (wMetrics ?? string.Empty).Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                                {
                                                    <span class="badge bg-info text-dark me-1" style="font-size:0.65rem">@m</span>
                                                }
                                            </td>
                                            <td><small class="text-muted">@(s.TelemetryIntervalMs / 1000) sn / @(s.TelemetryBatchSize) ölçüm</small></td>
                                            <td><small>@(s.ImagePositionX?.ToString("F1") ?? "-"), @(s.ImagePositionY?.ToString("F1") ?? "-")</small></td>
                                            <td>
                                                <button class="btn btn-outline-danger py-0 px-1" style="font-size:0.7rem;line-height:1.4"
                                                        @onclick="() => RemoveWizardSensor(idx)">✕</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                <div class="mt-4 d-flex justify-content-between">
                    <button class="btn btn-outline-secondary" @onclick="OpenSetupStep">Geri: Saha Kurulumu</button>
                    <button class="btn btn-success" @onclick="GoToDeploymentStep">İleri: Saha Deployment <span class="bi bi-arrow-right ms-1"></span></button>
                </div>
            </div>
            <div hidden="@(_wizardStep != 5)">
                    <div class="card border-success">
                        <div class="card-header bg-success text-white"><strong>Saha Deployment Paketi</strong></div>
                        <div class="card-body">
                            <p>TCP sensörleri, UDP/MQTT ayarları, kamera ayarları ve tüm saha dosyaları tek ZIP içinde hazırlanır.</p>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" @bind="_samePcDeployment" id="samePcDeployment" />
                                <label class="form-check-label fw-semibold" for="samePcDeployment">Aynı bilgisayarda başka yapıyla birlikte çalışacak</label>
                            </div>
                            @if (_samePcDeployment)
                            {
                                <div class="border rounded p-3 mb-3 bg-light">
                                    <div class="small text-muted mb-2">İkinci yapının ZIP'inde farklı project adı ve host portları kullanın.</div>
                                    <div class="row g-2">
                                        <div class="col-md-4"><label class="form-label small">Compose project adı</label><input class="form-control form-control-sm" @bind="_samePcProjectName" placeholder="saha-a" /></div>
                                        <div class="col-md-4"><label class="form-label small">Edge API host portu</label><input class="form-control form-control-sm" type="number" @bind="_samePcEdgePort" min="1024" max="65535" /></div>
                                        <div class="col-md-4"><label class="form-label small">Node-RED host portu</label><input class="form-control form-control-sm" type="number" @bind="_samePcNodeRedPort" min="1024" max="65535" /></div>
                                        <div class="col-md-4"><label class="form-label small">EMQX MQTT host portu</label><input class="form-control form-control-sm" type="number" @bind="_samePcMqttPort" min="1024" max="65535" /></div>
                                        <div class="col-md-4"><label class="form-label small">EMQX dashboard host portu</label><input class="form-control form-control-sm" type="number" @bind="_samePcEmqxDashboardPort" min="1024" max="65535" /></div>
                                        <div class="col-md-4"><label class="form-label small">Timeseries API host portu</label><input class="form-control form-control-sm" type="number" @bind="_samePcTimeseriesPort" min="1024" max="65535" /></div>
                                    </div>
                                    <div class="form-text mt-2">Örnek ikinci yapı: <code>saha-b</code>, Edge <code>5081</code>, Node-RED <code>1881</code>.</div>
                                </div>
                            }
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-secondary" @onclick="GoBackToSensorStep"><span class="bi bi-arrow-left me-1"></span>Geri: Sensör Ekle</button>
                                <button class="btn btn-success" @onclick="DownloadDeploymentPackage"><span class="bi bi-file-earmark-zip me-1"></span>Saha deployment ZIP indir</button>
                            </div>
                        </div>
                    </div>
            </div>
        </div>
    </div>

@* ══════════════════════════════════════════════════════════════════
   YAPI DETAY — Görsel + Sensör Overlay
   ══════════════════════════════════════════════════════════════════ *@
@if (_editingStructure != null)
{
    <div class="structure-detail-panel mb-4">
        <div class="structure-detail-header">
            <div class="d-flex align-items-center gap-2 overflow-hidden">
                <span style="font-size:1.4rem">@GetStructureEmoji(_editingStructure.StructureType)</span>
                <div class="overflow-hidden">
                    <h5 class="mb-0 text-truncate">@_editingStructure.Name</h5>
                    <small class="text-white-50">
                        @_editingStructure.Province
                        @(string.IsNullOrEmpty(_editingStructure.District) ? "" : " / " + _editingStructure.District)
                        · @GetStructureLabel(_editingStructure.StructureType)
                    </small>
                </div>
            </div>
            <div class="d-flex gap-2 flex-shrink-0">
                <button class="btn btn-sm btn-outline-light" @onclick="EditStructureInfo" title="Bilgileri düzenle">
                    <span class="bi bi-pencil me-1"></span>Düzenle
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(_editingStructure.Id)" title="Sil">
                    <span class="bi bi-trash"></span>
                </button>
                <button class="btn btn-sm btn-outline-light" @onclick="CloseDetail">
                    <span class="bi bi-x-lg"></span>
                </button>
            </div>
        </div>

        @* ── Görsel Overlay — JS initStructureImage() doldurur ── *@
        <div class="structure-image-wrapper" id="structure-image">
            @* JS tarafından doldurulur *@
        </div>
        <div class="structure-image-click-hint">
            <span class="bi bi-crosshair me-1"></span>@(_placingSensorId.HasValue ? "Seçili sensörün konumunu resme tıklayarak belirleyin" : "Resme tıklayarak sensör ekleyin")
        </div>

        @if (_editingStructure.Sensors?.Any(s => !s.ImagePositionX.HasValue || !s.ImagePositionY.HasValue) == true)
        {
            <div class="alert alert-warning mx-3 mt-3 mb-0 d-flex align-items-center gap-2">
                <span class="bi bi-geo-alt-fill"></span>
                <select class="form-select form-select-sm" @bind="_placingSensorId">
                    <option value="">Konumu belirlenmemiş sensör seçin</option>
                    @foreach (var sensor in _editingStructure.Sensors.Where(s => !s.ImagePositionX.HasValue || !s.ImagePositionY.HasValue))
                    {
                        <option value="@sensor.SensorId">@sensor.Name (@sensor.DeviceId)</option>
                    }
                </select>
            </div>
        }

        @* ── Alt bilgi + Kayıtlı Sensörler ── *@
        <div class="structure-detail-info">
            @if (!string.IsNullOrEmpty(_editingStructure.Description))
            {
                <span><span class="bi bi-info-circle me-1 text-muted"></span>@_editingStructure.Description</span>
            }
            @if (_editingStructure.Latitude.HasValue)
            {
                <span><span class="bi bi-crosshair me-1 text-muted"></span>
                    @_editingStructure.Latitude.Value.ToString("F5"), @_editingStructure.Longitude!.Value.ToString("F5")
                </span>
            }
            <span><span class="bi bi-cpu me-1 text-muted"></span>@(_editingStructure.Sensors?.Count ?? 0) sensör</span>
            <span class="ms-auto">
                <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshMarkersAsync">
                    <span class="bi bi-arrow-clockwise me-1"></span>Yenile
                </button>
            </span>
        </div>

        @* ── Kayıtlı Sensör Listesi ── *@
        @if (_editingStructure.Sensors?.Any() == true)
        {
            <div class="px-3 pb-3">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0" style="font-size:0.83rem">
                        <thead class="table-light">
                            <tr>
                                <th style="width:32px"></th>
                                <th>Sensör Adı</th>
                                <th>Tip</th>
                                <th>Device ID</th>
                                <th>Topic</th>
                                <th>Metrikler</th>
                                <th style="width:40px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ss in _editingStructure.Sensors)
                            {
                                var icon = GetSensorEmoji(ss.SensorType);
                                <tr>
                                    <td class="text-center">@icon</td>
                                    <td>@ss.Name</td>
                                    <td><span class="badge bg-secondary">@ss.SensorType</span></td>
                                    <td><code style="font-size:0.75rem">@ss.DeviceId</code></td>
                                    <td><small class="font-monospace" title="@ss.Topic" style="font-size:0.72rem">@(ss.Topic.Length > 32 ? ss.Topic[..30] + "…" : ss.Topic)</small></td>
                                    <td>
                                        @{
                                            // Metrics field (new) takes priority; fall back to Description (legacy)
                                            var metricsCsv = !string.IsNullOrWhiteSpace(ss.Metrics) ? ss.Metrics : ss.Description;
                                        }
                                        @if (!string.IsNullOrEmpty(metricsCsv))
                                        {
                                            @foreach (var m in metricsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                            {
                                                <span class="badge bg-info text-dark me-1" style="font-size:0.65rem">@m</span>
                                            }
                                        }
                                        else
                                        {
                                            <small class="text-muted">-</small>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-outline-danger btn-sm py-0 px-1"
                                                style="font-size:0.7rem;line-height:1.5"
                                                title="Sensörü sil"
                                                @onclick="() => RemoveSensorFromStructureAsync(ss.SensorId)">
                                            <span class="bi bi-trash"></span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
}

@* ══════════════════════════════════════════════════════════════════
   SENSÖR EKLEME POPUP
   ══════════════════════════════════════════════════════════════════ *@
@if (_showSensorPopup)
{
    <div class="popup-overlay" @onclick="CloseSensorPopup"></div>
    <div class="sensor-add-popup">
        <div class="sensor-add-popup-header">
            <span><span class="bi bi-plus-circle me-2"></span>Yeni Sensör Ekle</span>
            <button style="background:none;border:none;color:rgba(255,255,255,0.8);font-size:20px;cursor:pointer;padding:0 4px"
                    @onclick="CloseSensorPopup">&times;</button>
        </div>
        
        <div class="sensor-add-popup-body">
            @* ── TCP/IP sensörü ekle ── *@
            @if (_addSensorTab == "tcp")
            {
                <div class="alert alert-info border small mb-3 py-3">
                    <div class="fw-semibold mb-1">TCP/IP bağlantısını önce test edin, sonra kaydedin.</div>
                    Test, TCP erişimini ve cihazın döndürdüğü metrikleri gösterir. Kaydetme işlemi sensörü, TCP yapılandırmasını ve yapı-sensör ilişkisini merkez DB'ye yazar; ZIP üretilirken <code>DEYAS_BRIDGE_TCP_SOURCES</code> otomatik doldurulur.
                </div>

                <div class="alert alert-light border small d-flex align-items-center gap-2 mb-3 py-2">
                    <span class="bi bi-crosshair text-primary"></span>
                    Konum: X=@(_pendingPos?.x.ToString("F1") ?? "—"), Y=@(_pendingPos?.y.ToString("F1") ?? "—")
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Sensör Adı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="_tcpSensorName" placeholder="Örn: Ana Transformer" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Sensör Tipi <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="_tcpSensorType">
                            <option value="">— Seçiniz —</option>
                            @foreach (var sensorType in Enum.GetValues<SensorType>())
                            {
                                <option value="@sensorType.ToString()">@sensorType</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="form-label">IP Adresi <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="_tcpIpAddress" placeholder="192.168.1.100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Port <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" @bind="_tcpPort" placeholder="502" min="1" max="65535" />
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="form-label">Protocol</label>
                        <select class="form-select" @bind="_tcpProfile">
                            <option value="GenericTcp">Generic TCP</option>
                            <option value="JsonTcp">JSON TCP</option>
                            <option value="CsvTcp">CSV TCP</option>
                            <option value="ModbusTcp">Modbus TCP</option>
                            <option value="Unknown">Unknown</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Device ID</label>
                        <input type="text" class="form-control" @bind="_tcpDeviceId" placeholder="Örn: DEV001" />
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="form-label">Timeout (ms)</label>
                        <input type="number" class="form-control" @bind="_tcpTimeout" min="100" max="60000" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Polling Interval (ms)</label>
                        <input type="number" class="form-control" @bind="_tcpPollInterval" min="100" max="60000" />
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="form-label">Encoding</label>
                        <select class="form-select" @bind="_tcpEncoding">
                            <option value="utf-8">UTF-8</option>
                            <option value="ascii">ASCII</option>
                            <option value="hex">HEX</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Reconnect</label>
                        <select class="form-select" @bind="_tcpReconnectEnabled">
                            <option value="true">Evet</option>
                            <option value="false">Hayır</option>
                        </select>
                    </div>
                </div>

                <div class="mt-3">
                                <label class="form-label">Açıklama</label>
                                <textarea class="form-control" @bind="_tcpDescription" rows="2" placeholder="İsteğe bağlı notlar..."></textarea>
                            </div>

                            <div class="mt-3">
                                <label class="form-label">Mappings (JSON)</label>
                                <textarea class="form-control" @bind="_tcpMappingsJson" rows="4" placeholder='[{"FieldName":"temperature","SourceKey":"reg0","DataType":"float32","Scale":0.1}]'></textarea>
                                <div class="form-text">Opsiyonel. Cihaz verisini mantıksal alanlara eşlemek için JSON dizi formatında mapping girin.</div>
                </div>

                @if (_tcpDiscoveryResult is not null && _tcpDiscoveryResult.Count > 0)
                {
                    <div class="alert alert-info mt-3 py-2 small">
                        <div class="fw-semibold mb-1">Bulunan metrikler</div>
                        <div>@string.Join(", ", _tcpDiscoveryResult)</div>
                    </div>
                }
                else if (_tcpConnectionTestSucceeded)
                {
                    <div class="alert alert-success mt-3 py-2 small">
                        TCP bağlantısı başarılı. Bu yanıtta metrik bulunmadı; cihaz veri göndermiyorsa mapping'i daha sonra ekleyebilirsiniz.
                    </div>
                }

                @if (!string.IsNullOrEmpty(_saveError))
                {
                    <div class="alert alert-danger mt-2 py-2 small">@_saveError</div>
                }

                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-outline-primary" disabled="@(string.IsNullOrWhiteSpace(_tcpIpAddress) || !_tcpPort.HasValue || _isSaving)"
                            @onclick="TestTcpConnectionAsync">
                        <span class="bi bi-plug me-1"></span>Bağlantı ve metrik testi
                    </button>
                    <button class="btn btn-success" disabled="@(string.IsNullOrWhiteSpace(_tcpSensorName) || string.IsNullOrWhiteSpace(_tcpSensorType) || string.IsNullOrWhiteSpace(_tcpIpAddress) || !_tcpPort.HasValue || !HasCurrentTcpConnectionTest || _isSaving)"
                            @onclick="SaveTcpSensorAsync">
                        @if (_isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <span class="bi bi-check-lg me-1"></span>TCP/IP Sensörünü Ekle
                    </button>
                    <button class="btn btn-secondary" @onclick="CloseSensorPopup">İptal</button>
                </div>
            }
        </div>
    </div>
}

@* ══════════════════════════════════════════════════════════════════
   YAPI BİLGİ DÜZENLEME POPUP
   ══════════════════════════════════════════════════════════════════ *@
@if (_showEditPopup && _editingStructure != null)
{
    <div class="popup-overlay" @onclick="CloseEditPopup"></div>
    <div class="sensor-add-popup">
        <div class="sensor-add-popup-header edit-popup-header">
            <span><span class="bi bi-pencil me-2"></span>Yapı Bilgilerini Düzenle</span>
            <button style="background:none;border:none;color:rgba(255,255,255,0.8);font-size:20px;cursor:pointer;padding:0 4px"
                    @onclick="CloseEditPopup">&times;</button>
        </div>
        <div class="sensor-add-popup-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Yapı Adı</label>
                    <input class="form-control" @bind="_editName" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Yapı Tipi</label>
                    <select class="form-select" @bind="_editType">
                        @foreach (var st in AvailableStructureTypes)
                        {
                            <option value="@st.Key">@st.Value.Label</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Açıklama</label>
                    <input class="form-control" @bind="_editDescription" />
                </div>
                <div class="col-12">
                    <label class="form-label"><span class="bi bi-hdd-network me-1"></span>Saha Edge URL</label>
                    <input class="form-control" @bind="_editEdgeApiUrl" />
                    <div class="form-text">Çalıştır/Durdur çağrıları bu URL'deki Edge'e gider.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Edge Config JSON</label>
                    <textarea class="form-control font-monospace" rows="5" @bind="_editEdgeConfigJson"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Saha .env JSON</label>
                    <textarea class="form-control font-monospace" rows="5" @bind="_editSiteEnvironmentJson"></textarea>
                </div>
                <div class="col-md-4">
                    <label class="form-label">İl</label>
                    <select class="form-select" value="@_editProvince" @onchange="OnEditProvinceChanged">
                        <option value="">-- Seçin --</option>
                        @foreach (var p in _provinces)
                        { <option value="@p">@p</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">İlçe</label>
                    <select class="form-select" @bind="_editDistrict">
                        <option value="">-- Seçin --</option>
                        @foreach (var d in _editDistricts)
                        { <option value="@d">@d</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Adres</label>
                    <input class="form-control" @bind="_editAddress" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Durum</label>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" @bind="_editIsActive" id="chkEditActive" />
                        <label class="form-check-label" for="chkEditActive">Aktif</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">
                        <span class="bi bi-diagram-3 me-1"></span>Node-RED URL
                        <small class="text-muted fw-normal"> — Boş bırakılırsa ortak instance kullanılır</small>
                    </label>
                    <input class="form-control" @bind="_editNodeRedUrl"
                           placeholder="http://nodered-yapi-adi:1880 (opsiyonel)" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-success" @onclick="SaveEditAsync" disabled="@_isSaving">
                    @if (_isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <span class="bi bi-check-lg me-1"></span> Kaydet
                </button>
                <button class="btn btn-secondary" @onclick="CloseEditPopup">İptal</button>
            </div>
        </div>
    </div>
}

@* Kaydet onay modalı (Wizard adım 3) *@
@if (_showSaveConfirm)
{
    <div class="popup-overlay" @onclick="() => _showSaveConfirm = false"></div>
    <div class="sensor-add-popup" style="max-width:480px">
        <div class="sensor-add-popup-header" style="background:linear-gradient(90deg,#198754,#0f6241)">
            <span><span class="bi bi-save me-2"></span>Yapıyı Kaydet</span>
            <button style="background:none;border:none;color:#fff;font-size:20px;cursor:pointer" @onclick="() => _showSaveConfirm = false">&times;</button>
        </div>
        <div class="sensor-add-popup-body">
            <p class="mb-3">
                <strong>@_newName</strong> yapısı ve
                <strong>@_newStructureSensors.Count</strong> sensör birlikte veritabanına kaydedilecek.
            </p>
            <div class="table-responsive mb-3" style="max-height:200px;overflow-y:auto">
                <table class="table table-sm table-bordered mb-0 small">
                    <thead class="table-secondary">
                        <tr><th>Sensör</th><th>Tip</th><th>Topic</th><th>Metrikler</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _newStructureSensors)
                        {
                            <tr>
                                <td>@s.Name</td>
                                <td><span class="badge bg-secondary">@s.SensorType</span></td>
                                <td><small class="font-monospace">@(s.Topic.Length > 30 ? s.Topic[..28] + "…" : s.Topic)</small></td>
                                <td><small class="text-muted">@(string.IsNullOrEmpty(s.Metrics) ? "-" : s.Metrics)</small></td>
                            </tr>
                        }
                        @if (!_newStructureSensors.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted">Sensör eklenmedi (sonradan eklenebilir)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!string.IsNullOrEmpty(_saveError))
            {
                <div class="alert alert-danger py-2 small">@_saveError</div>
            }
            <div class="d-flex gap-2">
                <button class="btn btn-success" @onclick="ConfirmedSaveAsync" disabled="@_isSaving">
                    @if (_isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <span class="bi bi-check-lg me-1"></span> Evet, Kaydet
                </button>
                <button class="btn btn-secondary" @onclick="() => _showSaveConfirm = false">İptal</button>
            </div>
        </div>
    </div>
}

@* Silme onay modalı *@
@if (_deletingId.HasValue)
{
    <div class="popup-overlay" @onclick="() => _deletingId = null"></div>
    <div class="sensor-add-popup" style="max-width:400px">
        <div class="sensor-add-popup-header" style="background:linear-gradient(90deg,#dc3545,#a71d2a)">
            <span><span class="bi bi-trash me-2"></span>Yapıyı Sil</span>
            <button style="background:none;border:none;color:#fff;font-size:20px;cursor:pointer" @onclick="() => _deletingId = null">&times;</button>
        </div>
        <div class="sensor-add-popup-body">
            <p class="mb-3">Bu yapı ve tüm sensör bağlantıları kalıcı olarak silinecek. Devam etmek istiyor musunuz?</p>
            <div class="d-flex gap-2">
                <button class="btn btn-danger" @onclick="DoDeleteAsync" disabled="@_isSaving">
                    @if (_isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Evet, Sil
                </button>
                <button class="btn btn-secondary" @onclick="() => _deletingId = null">İptal</button>
            </div>
        </div>
    </div>
}

@* Prod kısmi başlatma sonucu modalı *@
@if (_showProdStartResult && _lastProdStartResult is not null)
{
    <div class="popup-overlay" @onclick="CloseProdStartResult"></div>
    <div class="sensor-add-popup" style="max-width:520px">
        <div class="sensor-add-popup-header" style="background:linear-gradient(90deg,#0d6efd,#0a58ca)">
            <span><span class="bi bi-play-circle me-2"></span>Prod Çalıştırma Özeti</span>
            <button style="background:none;border:none;color:#fff;font-size:20px;cursor:pointer" @onclick="CloseProdStartResult">&times;</button>
        </div>
        <div class="sensor-add-popup-body">
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <div class="border rounded p-2 text-center">
                        <div class="fs-4 fw-bold text-success">@_lastProdStartResult.StartedSensorCount</div>
                        <small class="text-muted">Başlatıldı</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="border rounded p-2 text-center">
                        <div class="fs-4 fw-bold text-warning">@_lastProdStartResult.SkippedSensorCount</div>
                        <small class="text-muted">Atlandı</small>
                    </div>
                </div>
            </div>

            @if (_lastProdStartResult.SkippedSensors?.Count > 0)
            {
                <h6 class="fw-semibold mb-2 text-warning">
                    <span class="bi bi-exclamation-triangle me-1"></span>Atlanan Sensörler
                </h6>
                <div class="table-responsive" style="max-height:180px;overflow-y:auto">
                    <table class="table table-sm table-bordered mb-0 small">
                        <thead class="table-secondary">
                            <tr><th>Device ID</th><th>Sebep</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _lastProdStartResult.SkippedSensors)
                            {
                                <tr>
                                    <td><code>@s.DeviceId</code></td>
                                    <td class="text-danger">@s.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="alert alert-warning py-2 small mt-2">
                    <span class="bi bi-info-circle me-1"></span>
                    Atlanan sensörler için Sensor Dashboard üzerinden bağlantı, parser ve metrik doğrulamalarını tamamlayın.
                </div>
            }

            <div class="mt-3">
                <button class="btn btn-primary" @onclick="CloseProdStartResult">Tamam</button>
            </div>
        </div>
    </div>
}

