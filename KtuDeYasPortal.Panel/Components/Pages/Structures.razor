    private async Task SaveFieldSetupAsync()
    {
        if (_createdStructureId == Guid.Empty || _setupSaving) return;
        _setupSaving = true;
        _saveError = null;
        try
        {
            _cameraSettings.ToJson();
            _cameraSettings.LinuxUsbDevices();
            var structure = await StructureUC.GetByIdAsync(_createdStructureId);
            if (structure is null) { _saveError = "Baraj kaydı bulunamadı. Listeyi yenileyip yeniden deneyin."; return; }

            _sourceTcp = HasTcpSensor;
            _sourceUdp = _friendlyUdpSources.Count > 0;
            UpdateSourceSelection();
            if (!_sourceTcp && !_sourceUdp && !_sourceMqtt && _cameraSettings.Cameras.Count > 0
                && _newStructureSensors.All(sensor => sensor.SensorType is SensorType.Camera or SensorType.Image))
                SetEnv("SAHA_ENABLED_PIPELINES", "kamera");
            SetEnv("DEYAS_SETUP_UDP_LABELS", System.Text.Json.JsonSerializer.Serialize(_friendlyUdpSources));
            SetEnv("DEYAS_SETUP_SHARED_PC", _samePcDeployment ? "true" : "false");
            SetEnv("DEYAS_SETUP_PROJECT_NAME", _samePcProjectName);
            if (_samePcDeployment) {
                SetEnv("EDGE_API_HOST_PORT", _samePcEdgePort.ToString());
                SetEnv("NODERED_HOST_PORT", _samePcNodeRedPort.ToString());
            }
            structure.Name = _setupName.Trim();
            structure.NodeRedUrl = string.IsNullOrWhiteSpace(_newNodeRedUrl) ? null : _newNodeRedUrl.Trim();
            structure.EdgeApiUrl = string.IsNullOrWhiteSpace(_newEdgeApiUrl) ? null : _newEdgeApiUrl.Trim();
            structure.EdgeConfigJson = BuildEdgeConfigJson(structure);
            structure.SiteEnvironmentJson = BuildSiteEnvironmentJson();
            await StructureUC.UpdateAsync(structure.Id, structure, structure.Sensors?.Where(sensor => !_removedWizardSensorIds.Contains(sensor.SensorId)).Select(sensor => sensor.SensorId).ToList() ?? []);
            _removedWizardSensorIds.Clear();
            foreach (var sensor in _newStructureSensors.Where(x => x.ImagePositionX.HasValue && x.ImagePositionY.HasValue))
                await StructureUC.UpdateSensorImagePositionAsync(sensor.Id, sensor.ImagePositionX!.Value, sensor.ImagePositionY!.Value);
            _setupNotice = "Kurulum bilgileri kaydedildi. Barajlar listesinden Saha ZIP’ini indir ile paketi alabilirsiniz. Sahada veri toplama başlatılmadı.";
            _simulationStatusMessage = "Saha kurulum ayarları merkeze kaydedildi.";
            await LoadStructuresAsync();
            await RefreshDiscoveredSensorsAsync();
        }
        catch (Exception ex) { _saveError = $"Saha ayarları kaydedilemedi: {ex.Message}"; }
        finally { _setupSaving = false; }
    }

    private async Task RefreshDiscoveredSensorsAsync()
    {
        if (_createdStructureId == Guid.Empty) return;
        var structure = await StructureUC.GetByIdAsync(_createdStructureId);
        _discoveredSensors = structure?.Sensors.Where(sensor => sensor.IsActive).ToList() ?? [];
        if(structure is null)return;
        var definitions=await StructureUC.GetAllSensorsAsync();
        var attached=structure.Sensors.Select(item=>item.SensorId).ToHashSet();
        foreach(var sensor in definitions.Where(item=>attached.Contains(item.Id)&&!_removedWizardSensorIds.Contains(item.Id))) {
            var existing=_newStructureSensors.FirstOrDefault(item=>item.Id==sensor.Id);
            if(existing is null) _newStructureSensors.Add(sensor);
            else {
                existing.Name=sensor.Name; existing.DeviceId=sensor.DeviceId;
                existing.ProtocolType=sensor.ProtocolType; existing.IpAddress=sensor.IpAddress; existing.Port=sensor.Port;
                existing.Topic=sensor.Topic; existing.SensorType=sensor.SensorType;
                existing.ImagePositionX=sensor.ImagePositionX; existing.ImagePositionY=sensor.ImagePositionY;
            }
        }
        _wizardImageInitialized=false;

    }

    private async Task ConfirmDiscoveredSensorsAsync()
    {
        if (_createdStructureId == Guid.Empty || _setupSaving || _discoveredSensors.Count == 0) return;
        _setupSaving = true;
        try
        {
            var structure = await StructureUC.GetByIdAsync(_createdStructureId);
            if (structure is null) return;

            var sensorIds = structure.Sensors.Where(sensor => sensor.IsActive).Select(sensor => sensor.SensorId).ToList();
            await StructureUC.UpdateAsync(structure.Id, structure, sensorIds);
            await RefreshDiscoveredSensorsAsync();
            _simulationStatusMessage = $"{sensorIds.Count} sensör merkeze kaydedildi.";
        }
        catch (Exception ex) { _saveError = $"Sensörler merkeze kaydedilemedi: {ex.Message}"; }
        finally { _setupSaving = false; }
    }

    private static DiscoveryMetadata ParseDiscoveryDescription(string? description)
    {
        if (string.IsNullOrWhiteSpace(description)) return new(null, null);
        var values = description.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2, StringSplitOptions.TrimEntries))
            .Where(parts => parts.Length == 2)
            .ToDictionary(parts => parts[0], parts => parts[1], StringComparer.OrdinalIgnoreCase);
        values.TryGetValue("system", out var systemId);
        values.TryGetValue("stream", out var streamId);
        return new(systemId?.TrimEnd(','), streamId?.TrimEnd(','));
    }

    private async Task DownloadDeploymentPackage()
    {
        if (_createdStructureId == Guid.Empty || _packageBusy) return;
        _saveError = null;
        if (!ValidatePackageInputs()) return;
        _packageBusy = true;
        try
        {
            await SaveFieldSetupAsync();
            if (!string.IsNullOrEmpty(_saveError)) return;
            await DownloadDeploymentPackageCoreAsync();
        }
        catch (Exception ex) { _saveError = $"Paket hazırlanamadı. Kayıtlarınız korunuyor; tekrar deneyin. {ex.Message}"; }
        finally { _packageBusy = false; }
    }

    private async Task DownloadDeploymentPackageCoreAsync()
    {
        if (_createdStructureId == Guid.Empty) return;

        _saveError = null;
        try { _cameraSettings.ToJson(); _cameraSettings.LinuxUsbDevices(); }
        catch (Exception ex) { _saveError = ex.Message; return; }
        var structure = await StructureUC.GetByIdAsync(_createdStructureId);
        if (structure is null) return;

        structure.Name = _setupName.Trim();
        structure.NodeRedUrl = BuildDeploymentPublicUrl(_newNodeRedUrl, _samePcDeployment ? _samePcNodeRedPort : null);
        structure.EdgeApiUrl = BuildDeploymentPublicUrl(_newEdgeApiUrl, _samePcDeployment ? _samePcEdgePort : null);
        var edgeConfig = BuildEdgeConfigJson(structure);
        var environment = BuildSiteEnvironmentEnv();
        await using var output = new MemoryStream();
        using (var archive = new System.IO.Compression.ZipArchive(output, System.IO.Compression.ZipArchiveMode.Create, true))
        {
            AddDeploymentTemplateEntry(archive, _samePcDeployment ? "docker-compose.structure.yml" : "docker-compose.yml");
            if (_samePcDeployment)
                AddDeploymentTemplateEntry(archive, "docker-compose.shared-services.yml");
            AddDeploymentTemplateEntry(archive, "init-databases.sql");
            var scenarioPath = Path.Combine(AppContext.BaseDirectory, "DeploymentTemplates", "saha-deployment", "SENARYOLAR.md");
            AddPackageEntry(archive, "ONCE_BUNU_OKUYUN.md", BuildFriendlyInstallGuide() + "\n\n" + (File.Exists(scenarioPath) ? File.ReadAllText(scenarioPath) : ""));
            AddPackageEntry(archive, "edge-config.json", edgeConfig);
            AddPackageEntry(archive, ".env", environment);
            AddPackageEntry(archive, "media-config.json", NormalizeMediaConfigJson());
            foreach (var camera in _cameraSettings.Cameras.Where(camera => camera.SourceType == "mqtt" && !string.IsNullOrWhiteSpace(camera.Device)))
                AddPackageEntry(archive, $"publishers/{camera.Id}/media-config.json", _cameraSettings.PublisherJson(camera, _createdStructureId));
            if (_cameraSettings.Cameras.Any(camera => camera.SourceType == "mqtt" && !string.IsNullOrWhiteSpace(camera.Device)))
            {
                AddDeploymentTemplateEntry(archive, "publisher/saha_media_bridge.py");
                AddDeploymentTemplateEntry(archive, "publisher/requirements.txt");
            }

        }

        var base64 = Convert.ToBase64String(output.ToArray());
        await JS.InvokeVoidAsync("panelDownloadBase64",
            $"saha-deployment-{_createdStructureId:N}.zip", "application/zip", base64);
        _packageDownloaded = true;
        _setupNotice = "Kurulum ZIP paketi hazırlandı ve tarayıcıya gönderildi. Sahaya kurulduğu veya veri geldiği henüz doğrulanmadı. Paket içindeki ONCE_BUNU_OKUYUN.md ile devam edin.";
        _simulationStatusMessage = _setupNotice;
    }

