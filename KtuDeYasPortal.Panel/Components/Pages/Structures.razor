    private void TogglePipeline(string pipeline)
    {
        var selected = GetEnv("SAHA_ENABLED_PIPELINES")
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (!selected.Add(pipeline)) selected.Remove(pipeline);
        SetEnv("SAHA_ENABLED_PIPELINES", string.Join(',', selected.OrderBy(value => value, StringComparer.OrdinalIgnoreCase)));
    }

