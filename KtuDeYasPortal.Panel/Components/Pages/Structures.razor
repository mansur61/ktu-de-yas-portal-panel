    private async Task SaveSensorsAndFinishAsync()
    {
        if (_createdStructureId == Guid.Empty || _isSaving) return;
        _isSaving = true;
        try
        {
            var structure = await StructureUC.GetByIdAsync(_createdStructureId);
            if (structure is null) { _saveError = "Yapı bulunamadı."; return; }

            var createdIds = new List<Guid>();
            foreach (var sensor in _newStructureSensors)
            {
                // TCP sensörü 3. adımda connected endpoint'iyle tek transaction
                // içinde zaten sensors + tcp_sensor_configurations + structure_sensors
                // olarak kaydedildi; burada ikinci kez oluşturulmaz.
                if (IsTcpSensor(sensor))
                {
                    createdIds.Add(sensor.Id);
                    if (sensor.ImagePositionX.HasValue && sensor.ImagePositionY.HasValue)
                        await StructureUC.UpdateSensorImagePositionAsync(sensor.Id, sensor.ImagePositionX.Value, sensor.ImagePositionY.Value);
                    continue;
                }
                if (sensor.Topic.Contains("{structureId}"))
                    sensor.Topic = sensor.Topic.Replace("{structureId}", _createdStructureId.ToString().ToLowerInvariant());

                var createdSensor = await StructureUC.CreateSensorAsync(sensor);
                createdIds.Add(createdSensor.Id);
            }

            SetEnv("DEYAS_BRIDGE_SENSOR_PROVISIONING_ENABLED", "false");
            structure.EdgeConfigJson = BuildEdgeConfigJson(structure);
            structure.SiteEnvironmentJson = BuildSiteEnvironmentJson();
            await StructureUC.UpdateAsync(structure.Id, structure, createdIds);

            _showCreateWizard = false;
            _showSaveConfirm = false;
            _newStructureSensors = new();
            await LoadStructuresAsync();
        }
        catch (Exception ex) { _saveError = $"Sensör/provisioning kaydı başarısız: {ex.Message}"; }
        finally { _isSaving = false; }
    }

