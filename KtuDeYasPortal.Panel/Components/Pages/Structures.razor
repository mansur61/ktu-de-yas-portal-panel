        ["DEYAS_BRIDGE_SOURCE_MQTT_PASSWORD"] = "",
        ["CENTRAL_MQTT_USERNAME"] = "",
        ["CENTRAL_MQTT_PASSWORD"] = "",
        ["DEYAS_JWT_SIGNING_KEY"] = ""
    };
    private readonly Dictionary<string, string> _localDeploymentSecrets = new(StringComparer.OrdinalIgnoreCase);

    private sealed record EnvironmentGroup(string Key, string Label, string? Description = null);
    private static readonly EnvironmentGroup[] EnvironmentGroups =
    [
        new("source", "Veri Kaynağı"),
        new("mqtt-source", "Kaynak MQTT"),
        new("bridge", "Saha Bridge: Sensör ve Yerel MQTT Bağlantısı", "Yerel MQTT, saha paketinin kendi içinde kurulan MQTT hizmetidir. Saha Bridge ise sensörler ile bu yerel MQTT arasında sahada çalışan servistir; sensör verisini alır, uygun formata dönüştürür ve ilgili sensör/device kimliğiyle yerel MQTT'ye iletir."),
        new("pipeline", "Saha Pipeline'ları"),
        new("central", "Merkez Bağlantısı")
    ];
    private readonly HashSet<string> _expandedEnvironmentGroups = new(StringComparer.OrdinalIgnoreCase) { "source" };

    private bool IsUdpSourceMode => GetEnv("DEYAS_BRIDGE_SOURCE_MODE") is "udp" or "both" or "all";
    private bool IsMqttSourceMode => GetEnv("DEYAS_BRIDGE_SOURCE_MODE") is "mqtt" or "both" or "all";
    private bool IsTcpSourceMode => GetEnv("DEYAS_BRIDGE_SOURCE_MODE") is "tcp" or "all";
    private bool IsScalarMqttMode => GetEnv("DEYAS_BRIDGE_SOURCE_MQTT_PAYLOAD_MODE").Equals("scalar", StringComparison.OrdinalIgnoreCase);
    private bool IsSingleScalarMetricActive => !string.IsNullOrWhiteSpace(GetEnv("DEYAS_BRIDGE_SOURCE_MQTT_SCALAR_METRIC"));
    private bool HasTcpSensor => _newStructureSensors.Any(IsTcpSensor);

    private bool IsEnvironmentGroupExpanded(string key) => _expandedEnvironmentGroups.Contains(key);

    private void ToggleEnvironmentGroup(string key)
    {
        if (!_expandedEnvironmentGroups.Add(key))
            _expandedEnvironmentGroups.Remove(key);
    }

    private static string GetEnvironmentGroup(string key) => key switch
    {
        "DEYAS_BRIDGE_SENSOR_PROVISIONING_ENABLED" or "DEYAS_BRIDGE_UDP_SOURCES" or "DEYAS_BRIDGE_SENSOR_HOST" or "DEYAS_BRIDGE_SENSOR_PORT" or "DEYAS_BRIDGE_UDP_LOCAL_PORT" or "DEYAS_BRIDGE_TCP_SOURCES" or "DEYAS_BRIDGE_SOURCE_MODE" => "source",
        var value when value.StartsWith("DEYAS_BRIDGE_SOURCE_MQTT_", StringComparison.Ordinal) => "mqtt-source",
        "SAHA_ENABLED_PIPELINES" or "SAHA_PIPELINE_RUNTIME_ENABLED" or "SAHA_MEDIA_ENABLED" => "pipeline",
        var value when value.StartsWith("CENTRAL_", StringComparison.Ordinal) || value == "LOCAL_TIMESERIES_API_BASE_URL" || value == "EDGE_FORWARDING_ENABLED" || value == "EDGE_LOCAL_TIMESERIES_PRODUCER" => "central",
        _ => "bridge"
    };

    private bool ShouldShowEnvironmentField(string key)
    {
        if (key is "DEYAS_BRIDGE_SENSOR_HOST" or "DEYAS_BRIDGE_SENSOR_PORT") return false;
        if (key is "DEYAS_BRIDGE_UDP_SOURCES" or "DEYAS_BRIDGE_UDP_LOCAL_PORT") return IsUdpSourceMode;
        if (key == "DEYAS_BRIDGE_TCP_SOURCES") return IsTcpSourceMode;
        if (key.StartsWith("DEYAS_BRIDGE_SOURCE_MQTT_", StringComparison.Ordinal))
        {
            if (!IsMqttSourceMode) return false;
            return key is not "DEYAS_BRIDGE_SOURCE_MQTT_SCALAR_SAMPLING_RATE" and not "DEYAS_BRIDGE_SOURCE_MQTT_SCALAR_METRIC" and not "DEYAS_BRIDGE_SOURCE_MQTT_SCALAR_METRICS" || IsScalarMqttMode;
        }
        return true;
    }

    private void OnSourceModeChanged(ChangeEventArgs args) => SetEnv("DEYAS_BRIDGE_SOURCE_MODE", args.Value?.ToString());

    private void OnUdpSourcesChanged(ChangeEventArgs args) =>
        SetEnv("DEYAS_BRIDGE_UDP_SOURCES", args.Value?.ToString()?.Trim());

    private bool IsCameraPipelineSelected => GetEnv("SAHA_ENABLED_PIPELINES")
        .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
        .Any(pipeline => pipeline.Equals("kamera", StringComparison.OrdinalIgnoreCase) || pipeline.Equals("all", StringComparison.OrdinalIgnoreCase));

    private bool EditCameraPipelineSelected
    {
        get
        {
            try
            {
                var environment = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string?>>(_editSiteEnvironmentJson);
                return environment?.GetValueOrDefault("SAHA_ENABLED_PIPELINES")?.Split(',', StringSplitOptions.TrimEntries)
                    .Any(value => value is "kamera" or "all") == true;
            }
            catch (System.Text.Json.JsonException) { return false; }
        }
    }

