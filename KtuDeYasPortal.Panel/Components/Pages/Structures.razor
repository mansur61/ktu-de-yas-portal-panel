    private async Task CheckPendingClickAsync()
    {
        try
        {
            if (!await JS.InvokeAsync<bool>("getHasPendingClickPosition")) return;
            double x = await JS.InvokeAsync<double>("getPendingClickPositionX");
            double y = await JS.InvokeAsync<double>("getPendingClickPositionY");
            await JS.InvokeVoidAsync("clearPendingClickPosition");
            if (_placingSensorId.HasValue && _editingStructure is not null)
            {
                await StructureUC.UpdateSensorImagePositionAsync(_placingSensorId.Value, x, y);
                _placingSensorId = null;
                _detailImageInitialized = false;
                await OpenStructureDetail(_editingStructure.Id);
                return;
