    private static void AddPackageEntry(System.IO.Compression.ZipArchive archive, string name, string content)
    {
        var entry = archive.CreateEntry(name, System.IO.Compression.CompressionLevel.Fastest);
        using var writer = new StreamWriter(entry.Open());
        writer.Write(content);
    }

    private void AddDeploymentTemplateEntry(System.IO.Compression.ZipArchive archive, string name)
    {
        var path = Path.Combine(AppContext.BaseDirectory, "DeploymentTemplates", "saha-deployment", name);
        if (File.Exists(path))
        {
            var content = File.ReadAllText(path);
            if (name is "docker-compose.yml" or "docker-compose.structure.yml")
                content = _cameraSettings.ApplyUsbDevices(content);
            AddPackageEntry(archive, name, content);
        }
    }

