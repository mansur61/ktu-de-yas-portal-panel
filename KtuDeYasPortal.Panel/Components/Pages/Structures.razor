    private async Task RemoveWizardSensor(int idx)
    {
        if (idx < 0 || idx >= _newStructureSensors.Count) return;
        var removedId=_newStructureSensors[idx].Id;
        var bindings=ReadSensorBindings();
        if(bindings.Remove(removedId,out var binding)) {
            SetEnv("DEYAS_SETUP_SENSOR_BINDINGS",System.Text.Json.JsonSerializer.Serialize(bindings,SourceJson));
            foreach(var key in new[]{"DEYAS_BRIDGE_DEVICE_MAP","DEYAS_BRIDGE_SENSOR_ID_MAP"}) {
                var map=System.Text.Json.JsonSerializer.Deserialize<Dictionary<string,string>>(string.IsNullOrWhiteSpace(GetEnv(key))?"{}":GetEnv(key))??[];
                map.Remove(binding.SourceKey+"/"+binding.StreamKey);SetEnv(key,System.Text.Json.JsonSerializer.Serialize(map));
            }
        }
        var points=SensorLocations();points.Remove(removedId);SetEnv("DEYAS_SETUP_SENSOR_LOCATIONS",System.Text.Json.JsonSerializer.Serialize(points,SourceJson));
        _removedWizardSensorIds.Add(removedId);
        _newStructureSensors.RemoveAt(idx);
        // Marker'ları resim üzerinde de yenile
        if (_newType.HasValue)
        {
            var allMarkers = _newStructureSensors.Select(s => new {
                id = s.Id.ToString(), deviceId = s.DeviceId,
                name = s.Name, sensorType = s.SensorType.ToString(),
                unit = s.Unit, topic = s.Topic,
                imagePositionX = s.ImagePositionX, imagePositionY = s.ImagePositionY,
                status = s.IsActive ? "Online" : "Offline",
                lastValue = (double?)null,
                lastUpdated = (DateTime?)null, alertMessage = (string?)null
            }).ToList();
            try { await JS.InvokeVoidAsync("initStructureImage", "wizard-image",
                    _structureTypes[_newType.Value].ImagePath, allMarkers); }
            catch { }
        }
    }

