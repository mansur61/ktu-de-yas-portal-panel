@using System
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_host"></div>
@if (_error is not null)
{
    <p role="alert">@_error</p>
}

@code {
    [Parameter] public string? BaslangicYerlesimiJson { get; set; }
    [Parameter] public EventCallback<string> YerlesimDegisti { get; set; }

    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<BarajDijitalIkiz>? _receiver;
    private bool _disposed;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./baraj/baraj.js");
            if (_disposed)
            {
                await module.DisposeAsync();
                return;
            }

            _module = module;
            _receiver = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("mount", _host, _receiver, BaslangicYerlesimiJson);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
            if (!_disposed)
            {
                _error = "Baraj görüntüleyicisi yüklenemedi. Statik dosyaların konumunu kontrol edin.";
                StateHasChanged();
            }
        }
    }

    [JSInvokable("YerlesimDegisti")]
    public Task BildirYerlesimDegisti(string json) => YerlesimDegisti.InvokeAsync(json);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _receiver?.Dispose();
        if (_module is not null)
        {
            try
            {
                // The JavaScript observer releases scene resources when the host leaves the DOM.
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
