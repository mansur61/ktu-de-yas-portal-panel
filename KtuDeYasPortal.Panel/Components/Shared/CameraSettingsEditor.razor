<div class="card mb-3">
    <div class="card-body p-4">
        <div class="d-flex align-items-center justify-content-between mb-3"><div><h3 class="h5 mb-1">Kameralar</h3><p class="dy-subtle mb-0">Kameranın nereden görüntü vereceğini ve ne zaman kayıt alacağını seçin.</p></div>@if (AllowAdd) { <button type="button" class="btn btn-outline-primary" @onclick="AddCamera">+ Kamera ekle</button> }</div>
        @foreach (var camera in Settings.Cameras)
        {
            <section class="dy-choice mb-3" @key="camera">
                <div class="d-flex justify-content-between align-items-center mb-3"><h4 class="h6 mb-0">Kamera @(Settings.Cameras.IndexOf(camera) + 1)</h4>@if (AllowAdd) { <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Settings.Cameras.Remove(camera)">Kaldır</button> }</div>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">Kamera nasıl bağlı?</label><select class="form-select" value="@camera.SourceType" @onchange="e => ChangeSource(camera, e.Value?.ToString())"><option value="rtsp">Ağ üzerinden görüntü veren kamera</option><option value="usb">Saha bilgisayarına takılı kamera</option><option value="mqtt">Başka bilgisayardan gönderilen görüntü</option></select></div>
                    <div class="col-md-6"><label class="form-label">Ne zaman kayıt alınsın?</label><select class="form-select" @bind="camera.CaptureMode"><option value="scheduled">Belirli aralıklarla</option><option value="continuous">Sürekli, kısa kayıtlar halinde</option><option value="manual">Komut verildiğinde</option><option value="event">Alarm oluştuğunda</option></select></div>
                    @if (camera.SourceType == "rtsp")
                    {
                        <div class="col-12"><label class="form-label">Kamera görüntü adresi</label><input type="password" class="form-control" @bind="camera.SourceValue" autocomplete="new-password" placeholder="Kamera kurulum sorumlusundan alınan rtsp:// adresi" /><div class="form-text">Şifre içeriyorsa yalnız kurulum ZIP'ine yazılır. Boş bırakılırsa sahada doldurulur; kaydı yeniden açınca gizli adres geri yüklenmez.</div></div>
                    }
                    @if (camera.SourceType is "usb" or "mqtt")
                    {
                        <div class="col-md-6"><label class="form-label">Kamerayı okuyan bilgisayar</label><select class="form-select" @bind="camera.Backend"><option value="v4l2">Linux</option><option value="dshow">Windows</option><option value="avfoundation">macOS</option></select></div>
                        <div class="col-md-6"><label class="form-label">Kamera cihazı / adı @(camera.SourceType == "mqtt" ? "(isteğe bağlı)" : "")</label><input class="form-control" @bind="camera.Device" placeholder="Kurulum sorumlusunun verdiği kamera adı veya /dev/video0" /></div>
                        @if (camera.Backend == "v4l2") { <div class="col-md-6"><label class="form-label">USB görüntü biçimi</label><select class="form-select" @bind="camera.PixelFormat"><option value="auto">Otomatik seç</option><option value="mjpeg">MJPEG</option><option value="yuyv422">YUYV</option></select></div> }
                        <div class="col-12"><div class="dy-guide mb-0"><p>@(camera.SourceType == "mqtt" ? "Kamera başka bilgisayara takılıdır. Görüntüyü gönderen yazılım o bilgisayarda çalışmalıdır; cihaz adı yazılırsa ZIP içinde yayıncı ayarları da hazırlanır." : "Kamera saha bilgisayarına takılı olmalıdır. Linux'ta cihaz erişimi pakete eklenir. Windows ve macOS'ta kamera gönderici yazılımı işletim sistemi üzerinde çalıştırılır.")</p></div></div>
                    }
                    <div class="col-md-6"><label class="form-label">Her kaydın süresi (saniye)</label><input type="number" min="1" max="300" class="form-control" @bind="camera.ClipSeconds" /></div>
                    @if (camera.CaptureMode == "scheduled") { <div class="col-md-6"><label class="form-label">Kayıtlar arası süre (saniye)</label><input type="number" min="1" max="86400" class="form-control" @bind="camera.IntervalSeconds" /></div> }
                    @if (camera.CaptureMode == "event") { <div class="col-12"><label class="form-label">İlişkili alarmın yayın adresi</label><input class="form-control" @bind="camera.EventTopic" /><div class="form-text">Alarm ayarlarından veya kurulum sorumlusundan alın. Alarm bağlantısı belirlenmeden olay kaydı başlatılamaz.</div></div> }
                    <div class="col-12 d-flex flex-wrap gap-4"><label><input type="checkbox" @bind="camera.Enabled" /> Kurulum paketine dahil et</label><label><input type="checkbox" @bind="camera.SnapshotEnabled" /> Video ile birlikte fotoğraf kaydet</label></div>
                </div>
                <details class="dy-technical mb-0"><summary>Görüntü kalitesi ve teknik ayrıntılar</summary><div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Teknik kamera kimliği</label><input class="form-control" @bind="camera.Id" /></div>
                    <div class="col-md-4"><label class="form-label">Saniyedeki kare sayısı</label><input type="number" min="1" max="120" class="form-control" @bind="camera.Fps" /></div>
                    <div class="col-md-4"><label class="form-label">Görüntü çözünürlüğü</label><input class="form-control" @bind="camera.Resolution" placeholder="1280x720" /></div>
                    @if (camera.SourceType == "mqtt") { <div class="col-12"><label class="form-label">Gelen görüntü yayın adresi (isteğe bağlı)</label><input class="form-control" @bind="camera.InputTopic" placeholder="Boşsa saha/kamera/yapı kimliğinden oluşturulur" /><div class="form-text">Topic boş bırakılırsa ZIP, yapı ve kamera kimliğine göre `saha/media/input/.../chunk` adresini üretir.</div></div> }
                    <div class="col-12"><label class="form-label">Kayıt komutu yayın adresi (isteğe bağlı)</label><input class="form-control" @bind="camera.CommandTopic" placeholder="Boşsa saha/kamera/yapı kimliğinden oluşturulur" /><div class="form-text">Topic boş bırakılırsa ZIP, `saha/media/commands/.../capture` adresini üretir. MQTT kamera yayıncısı için bu alan da ZIP'e eklenir.</div></div>
                </div></details>
            </section>
        }
        @if (Settings.Cameras.Count == 0) { <p class="text-muted small mb-0">Henüz kamera tanımlanmadı. Kamera ekle düğmesiyle başlayın.</p> }
    </div>
</div>
@code {
    [Parameter] public bool AllowAdd { get; set; } = true;
    [Parameter, EditorRequired] public CameraDeploymentSettings Settings { get; set; } = new();
    private void AddCamera()
    {
        var index = 1;
        while (Settings.Cameras.Any(c => c.Id == $"kamera-{index}")) index++;
        Settings.Cameras.Add(new CameraDeploymentEntry { Id = $"kamera-{index}", Mode = "remote", SourceType = "mqtt", CaptureMode = "manual", ClipSeconds = 10 });
    }
    private static void ChangeSource(CameraDeploymentEntry camera, string? source)
    {
        camera.SourceType = source ?? "rtsp";
        camera.Mode = camera.SourceType == "usb" ? "local" : "remote";
        if (camera.SourceType == "mqtt")
        {
            camera.CaptureMode = "manual";
            camera.ClipSeconds = 10;
        }
    }
}
