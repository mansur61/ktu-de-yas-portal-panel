@inject IJSRuntime JS
@implements IAsyncDisposable
<div class="dam-scene" @ref="_scene">
<header class="model-caption"><span>DİJİTAL İKİZ</span><small>Şematik iç hacim · Kayıtlı görsel ve sensör konumları</small></header>
<div class="model-perspective" tabindex="0" aria-label="Dijital ikiz. Fareyle sürükleyin veya ok tuşlarıyla döndürün; tekerlekle yakınlaştırın.">
<div class="model-world">
<div class="landscape">
<svg viewBox="0 0 600 420" aria-hidden="true"><defs><linearGradient id="terrain" x2="0" y2="1"><stop stop-color="#355e65"/><stop offset="1" stop-color="#13363f"/></linearGradient><linearGradient id="water"><stop stop-color="#2587a6"/><stop offset="1" stop-color="#77cbd0"/></linearGradient></defs><rect width="600" height="420" rx="25" fill="url(#terrain)"/><path d="M0 170L65 40L115 95L165 20L245 175M385 160L440 35L480 100L530 25L600 170" fill="#4c7377" stroke="#97b6ad" stroke-width="2"/><path d="M47 73L65 40L90 65L74 58L65 65ZM142 58L165 20L190 59L166 45Z" fill="#dbe8e2"/><ellipse cx="300" cy="110" rx="115" ry="66" fill="url(#water)"/><path d="M300 150C235 220 390 260 300 320S260 380 330 420" fill="none" stroke="url(#water)" stroke-width="42"/><path d="M0 340Q140 280 210 365M380 360Q480 300 600 355" fill="none" stroke="#6e8d6f" stroke-width="25"/></svg>
@if(!string.IsNullOrWhiteSpace(ImageUrl)){<img class="reference-image" src="@ImageUrl" alt="Yapının kayıtlı referans görseli" draggable="false" />}
</div>
<div class="dam-frame"><div class="frame-floor"></div><div class="frame-roof"></div><div class="frame-wall frame-left"></div><div class="frame-wall frame-right"></div>@for(var i=0;i<5;i++){<div class="frame-pillar" style="left:@(i*24)%"></div>}</div>
<svg class="sensor-paths" viewBox="0 0 600 420" aria-hidden="true">
@foreach(var sensor in Positioned){var x=sensor.ImagePositionX!.Value*6;var y=sensor.ImagePositionY!.Value*4.2;
@if(IsFiber(sensor)){<path class="fiber-route" style="stroke:@Color(sensor)" d="@FormattableString.Invariant($"M{x-35} {y+20} Q{x} {y-35} {x+40} {y} T{x+95} {y+15}")" />}
@if(IsLive(sensor)){<path class="data-flow" style="stroke:@Color(sensor)" d="@FormattableString.Invariant($"M{x} {y} Q{x} 350 530 350")" />}
}
</svg>
@foreach(var sensor in Positioned){
<button @key="sensor.Id" title="@sensor.Name" aria-label="@($"{sensor.Name} sensör bilgisini aç")" class="model-pin model-pin--@Status(sensor) @(IsLive(sensor)?"is-live":"") @(sensor.Id==SelectedId?"selected":"")" style="@FormattableString.Invariant($"left:{sensor.ImagePositionX}%;top:{sensor.ImagePositionY}%;--depth:{Math.Clamp(sensor.PositionZ,-30,80)}px")" @onclick="()=>OnSelect.InvokeAsync(sensor)"><i class="bi @Icon(sensor)" aria-hidden="true"></i></button>
}
<div class="site-computer"><i class="bi bi-pc-display"></i><span>Saha bilgisayarı</span><small>@Positioned.Count(IsLive) sensörden güncel veri</small></div>
</div></div>
<div class="model-controls"><span><i class="bi bi-mouse"></i> Sürükle · 360° döndür · Yakınlaştır</span>@if(!string.IsNullOrWhiteSpace(DetailUrl)){<a class="model-detail-link" href="@DetailUrl">Yapı detaya git <i class="bi bi-arrow-right"></i></a>}<label><input type="checkbox" checked @onchange="ToggleImage" /> Yapı görseli</label></div>

</div>
@code {
[Parameter] public IReadOnlyList<Sensor> Sensors {get;set;}=[];
[Parameter] public string? DetailUrl {get;set;}
[Parameter] public string? ImageUrl {get;set;}
[Parameter] public Guid? SelectedId {get;set;}
[Parameter] public EventCallback<Sensor> OnSelect {get;set;}
[Parameter] public Func<Sensor,string>? StatusFor {get;set;}
[Parameter] public Func<Sensor,bool>? IsLiveFor {get;set;}
private ElementReference _scene;
private IJSObjectReference? _module;
private IEnumerable<Sensor> Positioned=>Sensors.Where(HasPosition);
private static bool HasPosition(Sensor s)=>s.ImagePositionX is >=0 and <=100 && s.ImagePositionY is >=0 and <=100;
private string Status(Sensor s)=>StatusFor?.Invoke(s)??"no-data";
private bool IsLive(Sensor s)=>IsLiveFor?.Invoke(s)??false;
private static string Color(Sensor s)=>"#d1d5db";
private static bool IsFiber(Sensor s)=>DeYas.Contracts.MonitoringHealth.Category(s.SensorType.ToString())=="FBQ / Fiber Optik";
public static string Icon(Sensor s)=>s.SensorType.ToString() switch {"Camera"=>"bi-camera-video-fill","Image"=>"bi-image","Vibration"=>"bi-soundwave","Accelerometer"=>"bi-activity","Strain"=>"bi-arrows-expand","Tilt"=>"bi-compass","Temperature"=>"bi-thermometer-half","Pressure"=>"bi-speedometer2","Humidity"=>"bi-moisture","Lidar"=>"bi-bullseye","Ultrasonic"=>"bi-broadcast","Water"=>"bi-water","Wind"=>"bi-wind","Gps"=>"bi-geo-alt-fill","Displacement"=>"bi-arrows-move","FiberOptic"=>"bi-bezier2","WaterLeakage"=>"bi-droplet-fill",_=>"bi-cpu"};
protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender){_module=await JS.InvokeAsync<IJSObjectReference>("import","./js/dam-model.js");await _module.InvokeVoidAsync("init",_scene);}}
private async Task ToggleImage(ChangeEventArgs e){if(_module is not null)await _module.InvokeVoidAsync("setImage",_scene,e.Value is true);}
public async ValueTask DisposeAsync(){if(_module is not null){try{await _module.InvokeVoidAsync("destroy",_scene);await _module.DisposeAsync();}catch(JSDisconnectedException){}}}
}
