@using DeYas.DigitalTwin
@using KtuDeYasPortal.Panel.Domain.Entities

<StructureAdaptiveViewer ModelUrl="@ModelUrl"
                         ImageUrl="@ImageUrl"
                         DetailUrl="@DetailUrl"
                         StructureName="@StructureName"
                         Sensors="@TwinSensors"
                         SelectedId="@SelectedId"
                         EnablePositionEditing="@EnablePositionEditing"
                         OnSelect="SelectSensor"
                         OnModelPositionSelected="OnModelPositionSelected"
                         OnImagePositionSelected="OnImagePositionSelected" />

@code {
    [Parameter] public IReadOnlyList<Sensor> Sensors { get; set; } = [];
    [Parameter] public string? DetailUrl { get; set; }
    [Parameter] public string StructureName { get; set; } = "Yapı";
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? ModelUrl { get; set; }
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public EventCallback<Sensor> OnSelect { get; set; }
    [Parameter] public Func<Sensor, string>? StatusFor { get; set; }
    [Parameter] public Func<Sensor, bool>? IsLiveFor { get; set; }
    [Parameter] public bool EnablePositionEditing { get; set; }
    [Parameter] public EventCallback<ModelPositionSelection> OnModelPositionSelected { get; set; }
    [Parameter] public EventCallback<ImagePositionSelection> OnImagePositionSelected { get; set; }

    private IReadOnlyList<TwinModelSensor> TwinSensors => Sensors.Select(sensor =>
        new TwinModelSensor(
            sensor.Id,
            sensor.EffectiveDisplayName,
            sensor.SensorType.ToString(),
            sensor.PositionX,
            sensor.PositionY,
            sensor.PositionZ,
            sensor.RotationX,
            sensor.RotationY,
            sensor.RotationZ,
            sensor.ImagePositionX,
            sensor.ImagePositionY,
            StatusFor?.Invoke(sensor) ?? "no-data",
            IsLiveFor?.Invoke(sensor) ?? false)).ToArray();

    private Task SelectSensor(Guid sensorId)
    {
        var sensor = Sensors.FirstOrDefault(item => item.Id == sensorId);
        return sensor is null ? Task.CompletedTask : OnSelect.InvokeAsync(sensor);
    }

    public static string Icon(Sensor sensor) => sensor.SensorType.ToString() switch
    {
        "Camera" => "bi-camera-video-fill",
        "Image" => "bi-image",
        "Vibration" or "Accelerometer" => "bi-activity",
        "Strain" => "bi-arrows-expand",
        "Tilt" => "bi-compass",
        "Temperature" => "bi-thermometer-half",
        "Pressure" => "bi-speedometer2",
        "Humidity" => "bi-moisture",
        "Lidar" => "bi-bullseye",
        "Ultrasonic" => "bi-broadcast",
        "Water" => "bi-water",
        "Wind" => "bi-wind",
        "Gps" => "bi-geo-alt-fill",
        "Displacement" => "bi-arrows-move",
        "FiberOptic" => "bi-bezier2",
        "WaterLeakage" => "bi-droplet-fill",
        _ => "bi-cpu"
    };
}
