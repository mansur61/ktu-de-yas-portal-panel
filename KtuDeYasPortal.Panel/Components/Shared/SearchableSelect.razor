@* Arama destekli dropdown.
   Kullanım:
   <SearchableSelect
       Items="@(_structures.Select(s => (s.Id.ToString(), $"{s.Name} · {s.Province}")).ToList())"
       Value="@_selectedId"
       ValueChanged="id => _selectedId = id"
       EmptyLabel="— Seçin —"
       Placeholder="Ara…" />
*@

<div class="searchable-select @(IsOpen ? "searchable-select--open" : "")">
    <button type="button"
            class="searchable-select__trigger form-select form-select-sm text-start @(string.IsNullOrEmpty(Value) ? "text-muted" : "")"
            disabled="@Disabled"
            @onclick="Toggle"
            @onclick:stopPropagation="true">
        @SelectedLabel
        <span class="bi bi-chevron-down ms-auto" style="font-size:11px;opacity:.6;flex-shrink:0"></span>
    </button>

    @if (IsOpen)
    {
        <div class="searchable-select__dropdown" @onclick:stopPropagation="true">
            <div class="searchable-select__search-wrap">
                <span class="bi bi-search searchable-select__search-icon"></span>
                <input class="searchable-select__search"
                       type="text"
                       placeholder="@Placeholder"
                       @bind="_search"
                       @bind:event="oninput"
                       @ref="_searchInput" />
                @if (!string.IsNullOrEmpty(_search))
                {
                    <button type="button" class="searchable-select__clear" @onclick="() => _search = string.Empty">
                        <span class="bi bi-x"></span>
                    </button>
                }
            </div>
            <ul class="searchable-select__list" role="listbox">
                @if (!string.IsNullOrEmpty(EmptyLabel))
                {
                    <li class="searchable-select__item @(string.IsNullOrEmpty(Value) ? "selected" : "")"
                        role="option" @onclick="() => Select(string.Empty)">
                        <span class="text-muted">@EmptyLabel</span>
                    </li>
                }
                @foreach (var item in Filtered)
                {
                    var itemVal   = item.Value;
                    var itemLabel = item.Label;
                    <li class="searchable-select__item @(Value == itemVal ? "selected" : "")"
                        role="option" @onclick="() => Select(itemVal)">
                        @itemLabel
                    </li>
                }
                @if (!Filtered.Any() && !string.IsNullOrEmpty(_search))
                {
                    <li class="searchable-select__item searchable-select__item--empty">Sonuç bulunamadı</li>
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter] public List<SelectItem> Items    { get; set; } = [];
    [Parameter] public string           Value    { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string           EmptyLabel  { get; set; } = "— Seçin —";
    [Parameter] public string           Placeholder { get; set; } = "Ara…";
    [Parameter] public bool             Disabled    { get; set; }

    private bool   IsOpen;
    private string _search = "";
    private ElementReference _searchInput;

    private string SelectedLabel =>
        string.IsNullOrEmpty(Value)
            ? EmptyLabel
            : Items.FirstOrDefault(i => i.Value == Value)?.Label ?? EmptyLabel;

    private IEnumerable<SelectItem> Filtered => string.IsNullOrWhiteSpace(_search)
        ? Items
        : Items.Where(i => i.Label.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private async Task Toggle()
    {
        IsOpen  = !IsOpen;
        _search = "";
        if (IsOpen)
        {
            await Task.Delay(30);
            try { await _searchInput.FocusAsync(); } catch { }
        }
    }

    private async Task Select(string val)
    {
        IsOpen  = false;
        _search = "";
        if (val != Value)
            await ValueChanged.InvokeAsync(val);
    }

    public record SelectItem(string Value, string Label);
}