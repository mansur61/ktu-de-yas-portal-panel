@* Arama destekli dropdown — saf Blazor, JS yok.
   Kullanım:
   <SearchableSelect
       Items="@(_structures.Select(s => new SelectItem(s.Id.ToString(), $"{s.Name} · {s.Province}")).ToList())"
       Value="@_selectedId"
       ValueChanged="async id => { _selectedId = id; await DoSomething(); }"
       EmptyLabel="— Seçin —"
       Placeholder="Ara…" />
*@

<div class="ss-wrap">
    @* Trigger — seçili değeri gösterir, tıklayınca açar/kapar *@
    <button type="button"
            class="ss-trigger form-select form-select-sm text-start @(string.IsNullOrEmpty(Value) ? "text-muted" : "")"
            disabled="@Disabled"
            @onclick="() => { _open = !_open; if(_open) _search = string.Empty; }">
        @(string.IsNullOrEmpty(Value)
            ? EmptyLabel
            : Items.FirstOrDefault(i => i.Value == Value)?.Label ?? EmptyLabel)
    </button>

    @* Dropdown paneli *@
    @if (_open)
    {
        @* Overlay — dışarı tıklayınca kapat *@
        <div class="ss-overlay" @onclick="() => _open = false"></div>

        <div class="ss-panel">
            @* Arama kutusu *@
            <div class="ss-search-row">
                <span class="bi bi-search" style="color:#8da594;font-size:12px"></span>
                <input class="ss-search-input"
                       type="text"
                       placeholder="@Placeholder"
                       @bind="_search"
                       @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(_search))
                {
                    <button class="ss-clear" type="button" @onclick="() => _search = string.Empty">
                        <span class="bi bi-x"></span>
                    </button>
                }
            </div>

            @* Liste *@
            <ul class="ss-list">
                @if (!string.IsNullOrEmpty(EmptyLabel))
                {
                    <li class="ss-item @(string.IsNullOrEmpty(Value) ? "ss-item--selected" : "")"
                        @onclick="() => Pick(string.Empty)">
                        <span class="text-muted">@EmptyLabel</span>
                    </li>
                }
                @{
                    var filtered = string.IsNullOrWhiteSpace(_search)
                        ? Items
                        : Items.Where(i => i.Label.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
                }
                @foreach (var item in filtered)
                {
                    var v = item.Value;
                    var l = item.Label;
                    <li class="ss-item @(Value == v ? "ss-item--selected" : "")"
                        @onclick="() => Pick(v)">
                        @l
                    </li>
                }
                @if (!filtered.Any() && !string.IsNullOrEmpty(_search))
                {
                    <li class="ss-item ss-item--empty">Sonuç bulunamadı</li>
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter] public List<SelectItem> Items    { get; set; } = [];
    [Parameter] public string           Value    { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string           EmptyLabel  { get; set; } = "— Seçin —";
    [Parameter] public string           Placeholder { get; set; } = "Ara…";
    [Parameter] public bool             Disabled    { get; set; }

    private bool   _open;
    private string _search = "";

    private async Task Pick(string val)
    {
        _open   = false;
        _search = "";
        if (val != Value)
            await ValueChanged.InvokeAsync(val);
    }
}
